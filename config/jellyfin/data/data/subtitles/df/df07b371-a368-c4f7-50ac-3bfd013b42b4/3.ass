Dialogue: 0,0:00:35.15,0:00:36.86,Default,,0,0,0,,天地灵气
Dialogue: 0,0:00:36.85,0:00:39.85,Default,,0,0,0,,孕育出一颗混元珠
Dialogue: 0,0:00:40.65,0:00:43.65,Default,,0,0,0,,元始天尊将其一分为二
Dialogue: 0,0:00:43.65,0:00:46.03,Default,,0,0,0,,仙气化作灵珠
Dialogue: 0,0:00:46.02,0:00:48.56,Default,,0,0,0,,魔气聚为魔丸
Dialogue: 0,0:00:48.98,0:00:52.61,Default,,0,0,0,,且在魔丸上施下天劫咒
Dialogue: 0,0:00:52.85,0:00:57.48,Default,,0,0,0,,三年后引天雷摧毁魔丸
Dialogue: 0,0:00:58.23,0:01:01.65,Default,,0,0,0,,后因申公豹从中作梗
Dialogue: 0,0:01:01.65,0:01:06.03,Default,,0,0,0,,魔丸投胎为陈塘关三太子哪吒
Dialogue: 0,0:01:06.02,0:01:10.81,Default,,0,0,0,,而灵珠则投胎为龙王三太子敖丙
Dialogue: 0,0:01:10.81,0:01:13.10,Default,,0,0,0,,机缘巧合下
Dialogue: 0,0:01:13.10,0:01:16.89,Default,,0,0,0,,二人居然结为挚友
Dialogue: 0,0:01:16.90,0:01:20.32,Default,,0,0,0,,魔丸哪吒受父母感化
Dialogue: 0,0:01:20.31,0:01:22.06,Default,,0,0,0,,褪去魔性
Dialogue: 0,0:01:22.06,0:01:24.69,Default,,0,0,0,,拯救了陈塘关
Dialogue: 0,0:01:24.69,0:01:26.69,Default,,0,0,0,,并与敖丙携手
Dialogue: 0,0:01:26.69,0:01:29.19,Default,,0,0,0,,共抗天劫
Dialogue: 0,0:01:29.19,0:01:30.69,Default,,0,0,0,,最终
Dialogue: 0,0:01:30.69,0:01:34.94,Default,,0,0,0,,扭转了命运
Dialogue: 0,0:01:50.56,0:01:53.02,Default,,0,0,0,,虽扛下了天劫
Dialogue: 0,0:01:53.02,0:01:55.15,Default,,0,0,0,,但你们的肉身被毁
Dialogue: 0,0:01:55.15,0:01:57.07,Default,,0,0,0,,魂魄若无依托
Dialogue: 0,0:01:57.06,0:02:00.56,Default,,0,0,0,,片刻便会魂飞魄散
Dialogue: 0,0:02:00.56,0:02:02.81,Default,,0,0,0,,七色宝莲主守护及孕育
Dialogue: 0,0:02:02.81,0:02:05.27,Default,,0,0,0,,为师现在就要用它为你们
Dialogue: 0,0:02:05.27,0:02:08.19,Default,,0,0,0,,重塑肉身
Dialogue: 0,0:02:36.81,0:02:38.23,Default,,0,0,0,,哇
Dialogue: 0,0:02:38.23,0:02:39.31,Default,,0,0,0,,好美
Dialogue: 0,0:02:39.40,0:02:40.28,Default,,0,0,0,,开工
Dialogue: 0,0:03:14.85,0:03:15.93,Default,,0,0,0,,画风不对啊
Dialogue: 0,0:03:15.94,0:03:16.73,Default,,0,0,0,,没错啊
Dialogue: 0,0:03:16.73,0:03:17.69,Default,,0,0,0,,仙藕制成藕粉
Dialogue: 0,0:03:17.69,0:03:19.11,Default,,0,0,0,,才能重塑肉身噻
Dialogue: 0,0:03:20.15,0:03:20.94,Default,,0,0,0,,你刚才是不是用
Dialogue: 0,0:03:20.94,0:03:22.61,Default,,0,0,0,,抠了脚的手在做藕粉
Dialogue: 0,0:03:22.60,0:03:23.98,Default,,0,0,0,,哦 没事
Dialogue: 0,0:03:23.98,0:03:26.27,Default,,0,0,0,,脚上粘一些一会儿洗洗脚就好了
Dialogue: 0,0:03:26.27,0:03:29.44,Default,,0,0,0,,我不是关心你的脚
Dialogue: 0,0:03:30.06,0:03:32.06,Default,,0,0,0,,你刚才是不是擤了鼻涕
Dialogue: 0,0:03:32.06,0:03:33.90,Default,,0,0,0,,哎呀没鼻涕没鼻涕
Dialogue: 0,0:03:33.90,0:03:34.98,Default,,0,0,0,,这是藕粉
Dialogue: 0,0:03:34.98,0:03:35.69,Default,,0,0,0,,看嘛
Dialogue: 0,0:03:35.69,0:03:36.57,Default,,0,0,0,,藕粉啊
Dialogue: 0,0:03:38.52,0:03:39.90,Default,,0,0,0,,藕粉拌好了啊
Dialogue: 0,0:03:40.77,0:03:41.85,Default,,0,0,0,,来来来来来
Dialogue: 0,0:03:41.85,0:03:43.27,Default,,0,0,0,,你们一人一坨
Dialogue: 0,0:03:43.60,0:03:44.64,Default,,0,0,0,,不是 一 一份
Dialogue: 0,0:03:45.73,0:03:47.77,Default,,0,0,0,,搞快噻你魂儿都要散了
Dialogue: 0,0:03:47.77,0:03:49.06,Default,,0,0,0,,让我散了得了
Dialogue: 0,0:03:49.06,0:03:50.69,Default,,0,0,0,,臭讲究 你花样儿多哟
Dialogue: 0,0:03:57.40,0:03:58.48,Default,,0,0,0,,能动了耶
Dialogue: 0,0:03:58.90,0:03:59.44,Default,,0,0,0,,嗯
Dialogue: 0,0:04:01.31,0:04:02.27,Default,,0,0,0,,这啥玩意
Dialogue: 0,0:04:02.27,0:04:03.19,Default,,0,0,0,,谢谢啊
Dialogue: 0,0:04:03.19,0:04:05.82,Default,,0,0,0,,就说刚才怎么找不见了
Dialogue: 0,0:04:09.31,0:04:10.23,Default,,0,0,0,,塑形
Dialogue: 0,0:04:12.77,0:04:15.44,Default,,0,0,0,,飞天猪的记忆力无人能及
Dialogue: 0,0:04:15.44,0:04:19.23,Default,,0,0,0,,雕刻技术也是巧夺天工
Dialogue: 0,0:04:20.40,0:04:22.11,Default,,0,0,0,,你瞧一下像不像
Dialogue: 0,0:04:25.85,0:04:26.93,Default,,0,0,0,,多谢猪兄
Dialogue: 0,0:04:27.81,0:04:29.98,Default,,0,0,0,,莫乱动身体还没有定型
Dialogue: 0,0:04:32.48,0:04:33.11,Default,,0,0,0,,仙长
Dialogue: 0,0:04:33.10,0:04:35.27,Default,,0,0,0,,我已经召集陈塘关全军戒备
Dialogue: 0,0:04:35.27,0:04:37.40,Default,,0,0,0,,以防申公豹和东海龙族来犯
Dialogue: 0,0:04:37.40,0:04:38.53,Default,,0,0,0,,放心
Dialogue: 0,0:04:38.52,0:04:40.15,Default,,0,0,0,,龙族都在镇压海底妖兽
Dialogue: 0,0:04:40.15,0:04:41.78,Default,,0,0,0,,我担保他们一条都出不来
Dialogue: 0,0:04:41.77,0:04:43.65,Default,,0,0,0,,一个申公豹就没什么好怕的
Dialogue: 0,0:04:44.10,0:04:46.43,Default,,0,0,0,,你们还是来看一下
Dialogue: 0,0:04:46.44,0:04:48.40,Default,,0,0,0,,像不像
Dialogue: 0,0:04:48.40,0:04:50.03,Default,,0,0,0,,哦
Dialogue: 0,0:04:50.02,0:04:51.65,Default,,0,0,0,,我教的手艺
Dialogue: 0,0:04:51.65,0:04:52.44,Default,,0,0,0,,不过
Dialogue: 0,0:04:52.44,0:04:53.65,Default,,0,0,0,,也没必要一模一样嘛
Dialogue: 0,0:04:54.15,0:04:55.36,Default,,0,0,0,,可以再美化些吗
Dialogue: 0,0:04:55.35,0:04:56.48,Default,,0,0,0,,啊
Dialogue: 0,0:04:59.19,0:04:59.57,Default,,0,0,0,,也对
Dialogue: 0,0:04:59.56,0:05:01.64,Default,,0,0,0,,哪个父母不想儿子变得更优秀呢
Dialogue: 0,0:05:01.90,0:05:03.28,Default,,0,0,0,,嗯
Dialogue: 0,0:05:03.31,0:05:04.39,Default,,0,0,0,,改得高大威猛些
Dialogue: 0,0:05:05.23,0:05:06.81,Default,,0,0,0,,还要俊美秀气
Dialogue: 0,0:05:07.40,0:05:09.53,Default,,0,0,0,,男子汉就得阳刚硬朗
Dialogue: 0,0:05:10.52,0:05:11.77,Default,,0,0,0,,相貌英俊帅气
Dialogue: 0,0:05:11.77,0:05:13.85,Default,,0,0,0,,还得可爱乖巧
Dialogue: 0,0:05:15.19,0:05:17.65,Default,,0,0,0,,到底怎么改你们统一下噻
Dialogue: 0,0:05:17.65,0:05:18.53,Default,,0,0,0,,高大威猛
Dialogue: 0,0:05:18.52,0:05:20.48,Default,,0,0,0,,兼备俊美秀气
Dialogue: 0,0:05:20.48,0:05:21.81,Default,,0,0,0,,阳刚硬朗
Dialogue: 0,0:05:21.81,0:05:23.89,Default,,0,0,0,,不失活泼可爱
Dialogue: 0,0:05:28.06,0:05:28.81,Default,,0,0,0,,啥意思啊
Dialogue: 0,0:05:28.81,0:05:30.27,Default,,0,0,0,,它说 它说你行你上
Dialogue: 0,0:05:30.60,0:05:31.31,Default,,0,0,0,,切
Dialogue: 0,0:05:31.31,0:05:32.56,Default,,0,0,0,,早该我来了
Dialogue: 0,0:05:32.56,0:05:34.19,Default,,0,0,0,,自己做的才最满意嘛
Dialogue: 0,0:05:34.19,0:05:36.23,Default,,0,0,0,,这下有得等了
Dialogue: 0,0:05:36.23,0:05:38.73,Default,,0,0,0,,先给你定型吧
Dialogue: 0,0:05:38.73,0:05:40.40,Default,,0,0,0,,你天生水象
Dialogue: 0,0:05:40.40,0:05:42.28,Default,,0,0,0,,需以坎水淬炼
Dialogue: 0,0:06:00.48,0:06:01.19,Default,,0,0,0,,开
Dialogue: 0,0:06:08.85,0:06:11.18,Default,,0,0,0,,啊 大功告成
Dialogue: 0,0:06:11.19,0:06:13.02,Default,,0,0,0,,你整完没得
Dialogue: 0,0:06:14.10,0:06:16.18,Default,,0,0,0,,差不多吧
Dialogue: 0,0:06:19.77,0:06:22.56,Default,,0,0,0,,虽然这版肯定是最出彩的
Dialogue: 0,0:06:22.56,0:06:25.81,Default,,0,0,0,,但是细节打磨还需要很长时间
Dialogue: 0,0:06:25.81,0:06:27.23,Default,,0,0,0,,不如暂时就用第一版吧
Dialogue: 0,0:06:27.23,0:06:29.65,Default,,0,0,0,,对 第一版还是可以
Dialogue: 0,0:06:29.65,0:06:31.53,Default,,0,0,0,,嗯 我也觉得
Dialogue: 0,0:06:32.56,0:06:35.15,Default,,0,0,0,,嗯
Dialogue: 0,0:06:35.52,0:06:37.52,Default,,0,0,0,,你天生火象
Dialogue: 0,0:06:37.52,0:06:39.73,Default,,0,0,0,,需以离火煅烧
Dialogue: 0,0:06:48.81,0:06:50.19,Default,,0,0,0,,报
Dialogue: 0,0:06:50.19,0:06:51.40,Default,,0,0,0,,海面出现敌情
Dialogue: 0,0:06:51.40,0:06:52.69,Default,,0,0,0,,好像是申公豹
Dialogue: 0,0:06:52.69,0:06:53.90,Default,,0,0,0,,有多少敌人
Dialogue: 0,0:06:53.90,0:06:54.78,Default,,0,0,0,,就他一人
Dialogue: 0,0:06:54.77,0:06:56.60,Default,,0,0,0,,奇怪
Dialogue: 0,0:06:56.60,0:06:57.77,Default,,0,0,0,,您继续施法
Dialogue: 0,0:06:57.77,0:06:59.48,Default,,0,0,0,,我等前去御敌
Dialogue: 0,0:06:59.48,0:07:00.31,Default,,0,0,0,,仙长
Dialogue: 0,0:07:00.31,0:07:01.44,Default,,0,0,0,,让我去跟师父求求情
Dialogue: 0,0:07:01.44,0:07:01.94,Default,,0,0,0,,莫动
Dialogue: 0,0:07:01.94,0:07:03.32,Default,,0,0,0,,还需一炷香的时间
Dialogue: 0,0:07:03.31,0:07:04.89,Default,,0,0,0,,你肉身才能稳定
Dialogue: 0,0:07:33.52,0:07:34.85,Default,,0,0,0,,申公豹
Dialogue: 0,0:07:34.85,0:07:36.89,Default,,0,0,0,,你去而复返是何用意
Dialogue: 0,0:07:37.35,0:07:41.06,Default,,0,0,0,,你们既已知晓我和龙族的计划
Dialogue: 0,0:07:41.06,0:07:44.69,Default,,0,0,0,,我心里始终不踏...踏实
Dialogue: 0,0:07:44.69,0:07:46.82,Default,,0,0,0,,陈塘关现有重兵把守
Dialogue: 0,0:07:46.81,0:07:48.60,Default,,0,0,0,,太乙仙长也在城内
Dialogue: 0,0:07:48.60,0:07:51.89,Default,,0,0,0,,你单枪匹马怕是难有什么作为
Dialogue: 0,0:07:51.90,0:07:58.36,Default,,0,0,0,,谁...谁说我单枪匹马
Dialogue: 0,0:08:01.10,0:08:04.10,Default,,0,0,0,,盗取灵珠之事一旦败露
Dialogue: 0,0:08:04.77,0:08:06.81,Default,,0,0,0,,别说替你儿报仇
Dialogue: 0,0:08:07.69,0:08:10.69,Default,,0,0,0,,就是东海龙族
Dialogue: 0,0:08:10.69,0:08:13.11,Default,,0,0,0,,也罪责难逃
Dialogue: 0,0:08:13.10,0:08:14.39,Default,,0,0,0,,等事情败露
Dialogue: 0,0:08:14.40,0:08:16.23,Default,,0,0,0,,你也被打入海底炼狱
Dialogue: 0,0:08:16.23,0:08:18.36,Default,,0,0,0,,下面全是你的老熟人
Dialogue: 0,0:08:18.35,0:08:20.10,Default,,0,0,0,,看我们怎么招待你
Dialogue: 0,0:08:20.10,0:08:21.85,Default,,0,0,0,,出不了龙宫
Dialogue: 0,0:08:21.85,0:08:24.52,Default,,0,0,0,,报不了你儿的血海深仇
Dialogue: 0,0:08:24.52,0:08:26.44,Default,,0,0,0,,我都替你着急
Dialogue: 0,0:08:35.85,0:08:39.81,Default,,0,0,0,,还轮不到你们在这儿幸灾乐祸
Dialogue: 0,0:08:39.81,0:08:42.44,Default,,0,0,0,,小妹原想献计
Dialogue: 0,0:08:42.44,0:08:44.82,Default,,0,0,0,,看来大哥是
Dialogue: 0,0:08:44.81,0:08:46.40,Default,,0,0,0,,不领情了
Dialogue: 0,0:08:46.40,0:08:47.44,Default,,0,0,0,,嗯
Dialogue: 0,0:08:55.52,0:08:58.52,Default,,0,0,0,,大哥怕是忘了小妹的能耐
Dialogue: 0,0:09:01.98,0:09:03.06,Default,,0,0,0,,啊
Dialogue: 0,0:09:03.06,0:09:03.94,Default,,0,0,0,,我知道
Dialogue: 0,0:09:03.94,0:09:07.48,Default,,0,0,0,,裂...裂...裂...
Dialogue: 0,0:09:07.48,0:09:09.52,Default,,0,0,0,,裂空爪
Dialogue: 0,0:09:09.52,0:09:11.15,Default,,0,0,0,,谢谢
Dialogue: 0,0:09:13.27,0:09:17.44,Default,,0,0,0,,若申道长携此龙爪前去陈塘关
Dialogue: 0,0:09:17.44,0:09:21.15,Default,,0,0,0,,切开直通本王身边的裂缝
Dialogue: 0,0:09:21.15,0:09:27.78,Default,,0,0,0,,海底妖族便能助大哥铲平陈塘关
Dialogue: 0,0:10:16.35,0:10:18.02,Default,,0,0,0,,海底妖族
Dialogue: 0,0:10:19.19,0:10:20.48,Default,,0,0,0,,这 这怎么可能
Dialogue: 0,0:10:20.48,0:10:22.56,Default,,0,0,0,,是千年前镇压在锁妖阵下的妖族
Dialogue: 0,0:10:22.56,0:10:23.31,Default,,0,0,0,,它们怎么出得来
Dialogue: 0,0:10:23.31,0:10:25.98,Default,,0,0,0,,龙 龙族已经把它们放了吗
Dialogue: 0,0:10:25.98,0:10:28.56,Default,,0,0,0,,有定海锁链相连
Dialogue: 0,0:10:28.56,0:10:31.60,Default,,0,0,0,,也不必担心我们逃得掉
Dialogue: 0,0:10:31.60,0:10:35.06,Default,,0,0,0,,这两全其美的借兵之法
Dialogue: 0,0:10:35.06,0:10:36.98,Default,,0,0,0,,大哥满意否
Dialogue: 0,0:10:36.98,0:10:40.23,Default,,0,0,0,,你会这么好心
Dialogue: 0,0:10:40.23,0:10:41.73,Default,,0,0,0,,说吧
Dialogue: 0,0:10:41.73,0:10:43.27,Default,,0,0,0,,你的条件
Dialogue: 0,0:10:45.23,0:10:47.19,Default,,0,0,0,,这炼狱里啊
Dialogue: 0,0:10:47.19,0:10:48.86,Default,,0,0,0,,烈焰焚身
Dialogue: 0,0:10:48.85,0:10:50.73,Default,,0,0,0,,度日如年
Dialogue: 0,0:10:50.73,0:10:53.31,Default,,0,0,0,,若大哥稍降岩浆火力
Dialogue: 0,0:10:53.31,0:10:55.52,Default,,0,0,0,,缓减灼烧之苦
Dialogue: 0,0:10:56.48,0:10:59.98,Default,,0,0,0,,我等甘效犬马之劳
Dialogue: 0,0:11:01.40,0:11:02.53,Default,,0,0,0,,怎么啰
Dialogue: 0,0:11:02.52,0:11:04.40,Default,,0,0,0,,申 申公豹在搞什么名堂
Dialogue: 0,0:11:12.56,0:11:15.44,Default,,0,0,0,,终于出来了 耶
Dialogue: 0,0:11:16.27,0:11:18.19,Default,,0,0,0,,拜拜
Dialogue: 0,0:11:21.65,0:11:23.57,Default,,0,0,0,,卑鄙呀
Dialogue: 0,0:11:23.56,0:11:24.48,Default,,0,0,0,,完了
Dialogue: 0,0:11:24.48,0:11:27.11,Default,,0,0,0,,这下怎么向李大人交代啊
Dialogue: 0,0:11:27.10,0:11:28.64,Default,,0,0,0,,还好没有人看到
Dialogue: 0,0:11:28.65,0:11:29.69,Default,,0,0,0,,给
Dialogue: 0,0:11:29.69,0:11:30.48,Default,,0,0,0,,干嘛
Dialogue: 0,0:11:30.48,0:11:31.23,Default,,0,0,0,,我把你打残
Dialogue: 0,0:11:31.23,0:11:32.19,Default,,0,0,0,,你把我打残
Dialogue: 0,0:11:32.19,0:11:33.48,Default,,0,0,0,,就说是夜叉干的
Dialogue: 0,0:11:33.48,0:11:34.48,Default,,0,0,0,,哦
Dialogue: 0,0:11:34.48,0:11:36.52,Default,,0,0,0,,李大人看我们被打得那么惨
Dialogue: 0,0:11:36.52,0:11:38.02,Default,,0,0,0,,就不会怪罪我们了
Dialogue: 0,0:11:38.02,0:11:39.06,Default,,0,0,0,,别手软
Dialogue: 0,0:11:39.06,0:11:40.10,Default,,0,0,0,,使点儿劲儿
Dialogue: 0,0:11:43.65,0:11:44.03,Default,,0,0,0,,喂
Dialogue: 0,0:11:45.15,0:11:45.98,Default,,0,0,0,,喂
Dialogue: 0,0:11:48.19,0:11:49.36,Default,,0,0,0,,喂 你们两个
Dialogue: 0,0:11:51.94,0:11:52.86,Default,,0,0,0,,仙长
Dialogue: 0,0:11:52.85,0:11:53.89,Default,,0,0,0,,您在这儿呢
Dialogue: 0,0:11:53.90,0:11:54.90,Default,,0,0,0,,嘿嘿嘿
Dialogue: 0,0:11:55.19,0:11:56.53,Default,,0,0,0,,哈哈哈
Dialogue: 0,0:11:56.52,0:11:57.81,Default,,0,0,0,,夜叉是它放跑的
Dialogue: 0,0:11:57.81,0:11:58.81,Default,,0,0,0,,啊
Dialogue: 0,0:11:59.40,0:12:01.03,Default,,0,0,0,,明明是你粗心大意
Dialogue: 0,0:12:01.02,0:12:01.90,Default,,0,0,0,,你含血喷人
Dialogue: 0,0:12:01.90,0:12:03.07,Default,,0,0,0,,你推卸责任
Dialogue: 0,0:12:06.31,0:12:07.44,Default,,0,0,0,,嗨呀
Dialogue: 0,0:12:07.44,0:12:08.86,Default,,0,0,0,,两个神经病
Dialogue: 0,0:12:08.85,0:12:10.02,Default,,0,0,0,,喂
Dialogue: 0,0:12:10.02,0:12:11.73,Default,,0,0,0,,打个大西瓜 你们两个
Dialogue: 0,0:12:11.73,0:12:13.65,Default,,0,0,0,,滚过来给我护法
Dialogue: 0,0:12:14.15,0:12:15.73,Default,,0,0,0,,是是是 好嘞好嘞
Dialogue: 0,0:13:26.15,0:13:28.53,Default,,0,0,0,,不留活口
Dialogue: 0,0:14:22.19,0:14:22.86,Default,,0,0,0,,申公豹
Dialogue: 0,0:14:22.85,0:14:24.23,Default,,0,0,0,,敖丙并未殒命
Dialogue: 0,0:14:24.23,0:14:26.86,Default,,0,0,0,,陈塘关和龙族并非势不两立
Dialogue: 0,0:14:26.85,0:14:28.98,Default,,0,0,0,,太乙仙长正为敖丙重塑肉身
Dialogue: 0,0:14:32.15,0:14:33.90,Default,,0,0,0,,信口雌黄
Dialogue: 0,0:14:34.94,0:14:35.90,Default,,0,0,0,,嗯
Dialogue: 0,0:14:35.90,0:14:36.78,Default,,0,0,0,,结界
Dialogue: 0,0:14:39.02,0:14:39.69,Default,,0,0,0,,不好
Dialogue: 0,0:14:56.15,0:14:56.65,Default,,0,0,0,,师父
Dialogue: 0,0:14:57.15,0:14:58.03,Default,,0,0,0,,师父
Dialogue: 0,0:14:58.77,0:14:59.81,Default,,0,0,0,,敖丙
Dialogue: 0,0:14:59.81,0:15:01.69,Default,,0,0,0,,太乙师伯为徒儿重塑了肉身
Dialogue: 0,0:15:01.69,0:15:02.65,Default,,0,0,0,,快快停战吧
Dialogue: 0,0:15:03.31,0:15:03.89,Default,,0,0,0,,申公豹
Dialogue: 0,0:15:03.90,0:15:04.82,Default,,0,0,0,,我救了你徒儿
Dialogue: 0,0:15:04.81,0:15:05.94,Default,,0,0,0,,你该怎么谢我
Dialogue: 0,0:15:05.94,0:15:07.07,Default,,0,0,0,,那
Dialogue: 0,0:15:07.06,0:15:10.02,Default,,0,0,0,,这里边是哪吒啰
Dialogue: 0,0:15:12.06,0:15:14.39,Default,,0,0,0,,嗨呀 你个没良心的
Dialogue: 0,0:15:14.40,0:15:15.07,Default,,0,0,0,,师父
Dialogue: 0,0:15:15.06,0:15:17.64,Default,,0,0,0,,他们必须死
Dialogue: 0,0:15:22.81,0:15:24.02,Default,,0,0,0,,哈哈哈
Dialogue: 0,0:15:24.02,0:15:26.10,Default,,0,0,0,,就凭你破得了这结界
Dialogue: 0,0:15:26.10,0:15:28.14,Default,,0,0,0,,你打我噻 你打我噻
Dialogue: 0,0:15:54.52,0:15:55.77,Default,,0,0,0,,不要
Dialogue: 0,0:16:28.85,0:16:30.68,Default,,0,0,0,,这气息
Dialogue: 0,0:16:39.48,0:16:40.52,Default,,0,0,0,,敖丙
Dialogue: 0,0:16:40.65,0:16:41.40,Default,,0,0,0,,父王
Dialogue: 0,0:16:53.69,0:16:55.61,Default,,0,0,0,,父王
Dialogue: 0,0:16:55.60,0:16:57.68,Default,,0,0,0,,孩儿未能完成龙族的使命
Dialogue: 0,0:16:57.69,0:16:58.32,Default,,0,0,0,,不
Dialogue: 0,0:16:58.31,0:16:59.44,Default,,0,0,0,,那些都不重要
Dialogue: 0,0:16:59.44,0:17:01.11,Default,,0,0,0,,我只要你活着
Dialogue: 0,0:17:01.10,0:17:02.31,Default,,0,0,0,,活着就好
Dialogue: 0,0:17:02.65,0:17:04.44,Default,,0,0,0,,活着就好
Dialogue: 0,0:17:12.15,0:17:12.94,Default,,0,0,0,,开
Dialogue: 0,0:17:20.98,0:17:22.15,Default,,0,0,0,,你的身体怎么
Dialogue: 0,0:17:22.15,0:17:23.40,Default,,0,0,0,,哎呀 刚造的肉身
Dialogue: 0,0:17:23.40,0:17:25.53,Default,,0,0,0,,怎么遭得住那么强的冲击嘛
Dialogue: 0,0:17:25.52,0:17:26.81,Default,,0,0,0,,敖丙
Dialogue: 0,0:17:26.81,0:17:28.19,Default,,0,0,0,,喂 火候没到
Dialogue: 0,0:17:28.19,0:17:29.48,Default,,0,0,0,,莫动啊 莫动
Dialogue: 0,0:17:29.48,0:17:30.48,Default,,0,0,0,,敖丙 你怎么了
Dialogue: 0,0:17:30.48,0:17:33.31,Default,,0,0,0,,肉身还没定型动什么嘛动
Dialogue: 0,0:17:33.31,0:17:34.60,Default,,0,0,0,,以后你的身体超过负荷
Dialogue: 0,0:17:34.60,0:17:36.10,Default,,0,0,0,,也会崩的啊
Dialogue: 0,0:17:36.10,0:17:37.52,Default,,0,0,0,,哎呀呀真的是
Dialogue: 0,0:17:37.52,0:17:38.40,Default,,0,0,0,,死胖子
Dialogue: 0,0:17:38.40,0:17:41.44,Default,,0,0,0,,还不赶紧给敖丙做...做个肉身
Dialogue: 0,0:17:41.44,0:17:42.32,Default,,0,0,0,,啊
Dialogue: 0,0:17:42.31,0:17:43.60,Default,,0,0,0,,连造两个肉身
Dialogue: 0,0:17:43.60,0:17:45.14,Default,,0,0,0,,宝莲仙气都耗光了
Dialogue: 0,0:17:45.15,0:17:46.78,Default,,0,0,0,,没肉身不是会魂飞魄散吗
Dialogue: 0,0:17:46.77,0:17:48.19,Default,,0,0,0,,师父你想想办法呀
Dialogue: 0,0:17:48.19,0:17:48.77,Default,,0,0,0,,没得宝莲
Dialogue: 0,0:17:48.77,0:17:51.06,Default,,0,0,0,,我 我也弄不成噻
Dialogue: 0,0:17:51.40,0:17:52.73,Default,,0,0,0,,没关系
Dialogue: 0,0:17:52.73,0:17:55.11,Default,,0,0,0,,是我占了灵珠才连累了你
Dialogue: 0,0:17:55.90,0:17:57.61,Default,,0,0,0,,若以我一命
Dialogue: 0,0:17:57.60,0:17:58.89,Default,,0,0,0,,能换你重生
Dialogue: 0,0:17:59.69,0:18:01.36,Default,,0,0,0,,也算稍抵罪过了
Dialogue: 0,0:18:01.35,0:18:02.48,Default,,0,0,0,,谁要你抵罪
Dialogue: 0,0:18:02.48,0:18:04.23,Default,,0,0,0,,当魔丸我一样活得开心
Dialogue: 0,0:18:04.23,0:18:05.61,Default,,0,0,0,,我不准你死
Dialogue: 0,0:18:06.52,0:18:07.65,Default,,0,0,0,,父王
Dialogue: 0,0:18:08.35,0:18:10.27,Default,,0,0,0,,求您放过陈塘关吧
Dialogue: 0,0:18:11.27,0:18:13.81,Default,,0,0,0,,我们不能一错再错
Dialogue: 0,0:18:14.60,0:18:17.60,Default,,0,0,0,,这是孩儿最后的心愿
Dialogue: 0,0:18:22.94,0:18:24.15,Default,,0,0,0,,你肯定还有办法
Dialogue: 0,0:18:24.15,0:18:25.94,Default,,0,0,0,,必须还有办法
Dialogue: 0,0:18:25.94,0:18:28.15,Default,,0,0,0,,快点想 快点想
Dialogue: 0,0:18:28.15,0:18:29.44,Default,,0,0,0,,让敖丙先附你身上
Dialogue: 0,0:18:29.44,0:18:30.90,Default,,0,0,0,,附你身上
Dialogue: 0,0:18:30.90,0:18:33.69,Default,,0,0,0,,两个魂魄共用一个肉身
Dialogue: 0,0:18:33.69,0:18:35.52,Default,,0,0,0,,必会相互排斥
Dialogue: 0,0:18:35.52,0:18:37.56,Default,,0,0,0,,灵珠魔丸本是同根生
Dialogue: 0,0:18:37.56,0:18:38.56,Default,,0,0,0,,共用一个肉身
Dialogue: 0,0:18:38.56,0:18:40.85,Default,,0,0,0,,七天内没有问题
Dialogue: 0,0:18:40.85,0:18:41.73,Default,,0,0,0,,好啊
Dialogue: 0,0:18:41.73,0:18:42.86,Default,,0,0,0,,敖丙你快上来
Dialogue: 0,0:18:42.85,0:18:43.85,Default,,0,0,0,,快
Dialogue: 0,0:18:44.81,0:18:45.60,Default,,0,0,0,,好
Dialogue: 0,0:18:52.56,0:18:54.56,Default,,0,0,0,,好奇怪的感觉
Dialogue: 0,0:18:54.56,0:18:55.73,Default,,0,0,0,,敖丙你在吗
Dialogue: 0,0:18:55.73,0:18:56.81,Default,,0,0,0,,我在
Dialogue: 0,0:18:56.81,0:18:58.77,Default,,0,0,0,,我脑袋里能听到你的声音诶
Dialogue: 0,0:18:58.98,0:19:00.36,Default,,0,0,0,,好玩好玩真好玩
Dialogue: 0,0:19:00.35,0:19:02.56,Default,,0,0,0,,这也只是权宜之计
Dialogue: 0,0:19:02.56,0:19:04.60,Default,,0,0,0,,七天后又当如何
Dialogue: 0,0:19:04.60,0:19:06.27,Default,,0,0,0,,玉虚宫的宝库里有种法宝
Dialogue: 0,0:19:06.27,0:19:08.90,Default,,0,0,0,,名叫玉液琼浆
Dialogue: 0,0:19:08.90,0:19:11.07,Default,,0,0,0,,有恢复法器神力的功效
Dialogue: 0,0:19:11.06,0:19:12.19,Default,,0,0,0,,用它浇灌后
Dialogue: 0,0:19:12.19,0:19:15.32,Default,,0,0,0,,七色宝莲定可重开
Dialogue: 0,0:19:15.31,0:19:17.77,Default,,0,0,0,,但你想如何取来呢
Dialogue: 0,0:19:17.77,0:19:19.69,Default,,0,0,0,,当然是求天尊赏赐呀
Dialogue: 0,0:19:20.19,0:19:21.36,Default,,0,0,0,,难不成
Dialogue: 0,0:19:21.35,0:19:23.31,Default,,0,0,0,,你要告发我和龙族
Dialogue: 0,0:19:23.31,0:19:27.64,Default,,0,0,0,,天尊又岂会救...救龙族之子
Dialogue: 0,0:19:27.65,0:19:28.98,Default,,0,0,0,,求不到
Dialogue: 0,0:19:28.98,0:19:30.36,Default,,0,0,0,,那就抢
Dialogue: 0,0:19:30.35,0:19:32.48,Default,,0,0,0,,玉虚宫乃阐教核心
Dialogue: 0,0:19:32.48,0:19:33.98,Default,,0,0,0,,高手如云
Dialogue: 0,0:19:33.98,0:19:35.11,Default,,0,0,0,,为了我儿
Dialogue: 0,0:19:35.10,0:19:37.64,Default,,0,0,0,,就是天庭我也照闯
Dialogue: 0,0:19:37.65,0:19:39.44,Default,,0,0,0,,龙王稍安勿躁
Dialogue: 0,0:19:39.44,0:19:41.19,Default,,0,0,0,,我倒有一计
Dialogue: 0,0:19:41.19,0:19:43.57,Default,,0,0,0,,阐教弟子修行到家
Dialogue: 0,0:19:43.56,0:19:46.39,Default,,0,0,0,,皆可参加升仙考核
Dialogue: 0,0:19:46.40,0:19:49.61,Default,,0,0,0,,通过考核不仅可得道成仙
Dialogue: 0,0:19:49.60,0:19:51.81,Default,,0,0,0,,还能在玉虚宝库任选一样
Dialogue: 0,0:19:51.81,0:19:55.14,Default,,0,0,0,,法...法宝作为奖励
Dialogue: 0,0:19:55.15,0:19:55.78,Default,,0,0,0,,你是说
Dialogue: 0,0:19:55.77,0:19:57.06,Default,,0,0,0,,让吒儿参加考核
Dialogue: 0,0:19:57.06,0:19:58.31,Default,,0,0,0,,取得玉液琼浆
Dialogue: 0,0:19:58.31,0:19:59.27,Default,,0,0,0,,要不得 要不得
Dialogue: 0,0:19:59.27,0:20:00.15,Default,,0,0,0,,他浑身魔气
Dialogue: 0,0:20:00.15,0:20:02.40,Default,,0,0,0,,一露功夫身份就暴露了
Dialogue: 0,0:20:02.40,0:20:04.36,Default,,0,0,0,,敖丙不是附哪吒身上了吗
Dialogue: 0,0:20:04.35,0:20:06.27,Default,,0,0,0,,正好用灵气掩盖魔气
Dialogue: 0,0:20:07.52,0:20:09.94,Default,,0,0,0,,只要七天内通过考核
Dialogue: 0,0:20:09.94,0:20:12.90,Default,,0,0,0,,不仅可以取得玉液...琼浆
Dialogue: 0,0:20:12.90,0:20:13.94,Default,,0,0,0,,还可以
Dialogue: 0,0:20:13.94,0:20:15.07,Default,,0,0,0,,还可以成仙
Dialogue: 0,0:20:15.73,0:20:17.61,Default,,0,0,0,,成仙了是不是就不算魔啦
Dialogue: 0,0:20:17.60,0:20:20.89,Default,,0,0,0,,既救敖丙也救哪吒
Dialogue: 0,0:20:20.90,0:20:23.90,Default,,0,0,0,,皆...皆大欢喜
Dialogue: 0,0:20:23.90,0:20:25.82,Default,,0,0,0,,此举绝非正道
Dialogue: 0,0:20:26.31,0:20:28.44,Default,,0,0,0,,那你待如何
Dialogue: 0,0:20:28.44,0:20:30.44,Default,,0,0,0,,规行矩步
Dialogue: 0,0:20:30.44,0:20:31.86,Default,,0,0,0,,禀明天尊
Dialogue: 0,0:20:31.85,0:20:33.77,Default,,0,0,0,,盼天尊明察秋毫
Dialogue: 0,0:20:33.77,0:20:36.06,Default,,0,0,0,,我夫妇俩也会竭力相求
Dialogue: 0,0:20:36.06,0:20:39.77,Default,,0,0,0,,不让父辈之罪祸及两个无辜孩儿
Dialogue: 0,0:20:39.77,0:20:41.85,Default,,0,0,0,,区区凡人
Dialogue: 0,0:20:41.85,0:20:43.93,Default,,0,0,0,,几十年的阅历
Dialogue: 0,0:20:43.94,0:20:47.73,Default,,0,0,0,,就敢在我面前讲大道理
Dialogue: 0,0:20:54.40,0:20:56.32,Default,,0,0,0,,我都记不清
Dialogue: 0,0:20:56.31,0:20:59.02,Default,,0,0,0,,活了几千年了
Dialogue: 0,0:20:59.02,0:21:02.35,Default,,0,0,0,,我老人家只告诉你一个道理
Dialogue: 0,0:21:02.35,0:21:04.56,Default,,0,0,0,,我儿若死了
Dialogue: 0,0:21:04.56,0:21:08.48,Default,,0,0,0,,全陈塘关都得陪葬
Dialogue: 0,0:21:15.31,0:21:17.23,Default,,0,0,0,,住手
Dialogue: 0,0:21:17.23,0:21:19.11,Default,,0,0,0,,敖丙是我朋友
Dialogue: 0,0:21:19.10,0:21:21.02,Default,,0,0,0,,我肯定会救他
Dialogue: 0,0:21:21.02,0:21:23.19,Default,,0,0,0,,但你要敢动陈塘关
Dialogue: 0,0:21:23.19,0:21:25.02,Default,,0,0,0,,我就把龙宫砸个
Dialogue: 0,0:21:25.02,0:21:27.31,Default,,0,0,0,,稀 巴 烂
Dialogue: 0,0:21:31.94,0:21:34.07,Default,,0,0,0,,除了哪吒和太乙
Dialogue: 0,0:21:34.06,0:21:37.64,Default,,0,0,0,,任何人不得离开陈塘关半步
Dialogue: 0,0:21:37.65,0:21:39.98,Default,,0,0,0,,七天内取不到玉液琼浆
Dialogue: 0,0:21:39.98,0:21:43.11,Default,,0,0,0,,或走漏半点龙族的风声
Dialogue: 0,0:21:43.10,0:21:45.48,Default,,0,0,0,,我就让陈塘关
Dialogue: 0,0:21:45.48,0:21:46.86,Default,,0,0,0,,鸡犬不留
Dialogue: 0,0:21:48.06,0:21:49.85,Default,,0,0,0,,我那三兄妹信不过
Dialogue: 0,0:21:49.85,0:21:52.73,Default,,0,0,0,,我也不能长时间灵魂出窍
Dialogue: 0,0:21:52.73,0:21:54.56,Default,,0,0,0,,看守陈塘关
Dialogue: 0,0:21:54.56,0:21:55.89,Default,,0,0,0,,只有靠你了
Dialogue: 0,0:22:00.85,0:22:01.60,Default,,0,0,0,,嗯
Dialogue: 0,0:22:01.60,0:22:02.85,Default,,0,0,0,,对嘛
Dialogue: 0,0:22:02.85,0:22:04.73,Default,,0,0,0,,没有什么意思是点个头
Dialogue: 0,0:22:04.73,0:22:06.40,Default,,0,0,0,,无法表达的
Dialogue: 0,0:22:13.40,0:22:15.15,Default,,0,0,0,,李大人
Dialogue: 0,0:22:15.15,0:22:17.82,Default,,0,0,0,,大伙儿来给三少爷送行
Dialogue: 0,0:22:17.81,0:22:21.98,Default,,0,0,0,,感谢他救了全城老小的性命
Dialogue: 0,0:22:21.98,0:22:23.06,Default,,0,0,0,,不敢当
Dialogue: 0,0:22:23.06,0:22:24.52,Default,,0,0,0,,犬子这些年
Dialogue: 0,0:22:24.52,0:22:25.73,Default,,0,0,0,,给大家添乱了
Dialogue: 0,0:22:25.73,0:22:30.44,Default,,0,0,0,,老夫早看出三少爷必定大有作为
Dialogue: 0,0:22:30.44,0:22:31.69,Default,,0,0,0,,大家瞧瞧
Dialogue: 0,0:22:31.69,0:22:33.11,Default,,0,0,0,,天庭饱满
Dialogue: 0,0:22:33.10,0:22:34.27,Default,,0,0,0,,面庞宽大
Dialogue: 0,0:22:34.27,0:22:35.90,Default,,0,0,0,,鼻梁丰起
Dialogue: 0,0:22:35.90,0:22:37.78,Default,,0,0,0,,腮鼓唇厚
Dialogue: 0,0:22:37.77,0:22:41.27,Default,,0,0,0,,此乃盖世英雄之面相
Dialogue: 0,0:22:41.27,0:22:44.23,Default,,0,0,0,,老夫从不会看走眼
Dialogue: 0,0:22:47.40,0:22:50.82,Default,,0,0,0,,少爷饭后可得记得刷牙呀
Dialogue: 0,0:22:51.73,0:22:53.36,Default,,0,0,0,,老大
Dialogue: 0,0:22:53.35,0:22:55.77,Default,,0,0,0,,伏魔帮从此改名哪吒帮
Dialogue: 0,0:22:55.77,0:22:58.77,Default,,0,0,0,,全体成员尊奉老大号令
Dialogue: 0,0:22:59.31,0:23:00.81,Default,,0,0,0,,少爷想练字吗
Dialogue: 0,0:23:00.81,0:23:01.73,Default,,0,0,0,,找我呀
Dialogue: 0,0:23:01.73,0:23:02.77,Default,,0,0,0,,少爷都三岁了
Dialogue: 0,0:23:02.77,0:23:04.19,Default,,0,0,0,,是时候找个对象了
Dialogue: 0,0:23:04.19,0:23:04.94,Default,,0,0,0,,想学乐器吗
Dialogue: 0,0:23:04.94,0:23:06.73,Default,,0,0,0,,我们样样精通
Dialogue: 0,0:23:08.81,0:23:10.52,Default,,0,0,0,,我想
Dialogue: 0,0:23:10.52,0:23:11.65,Default,,0,0,0,,踢毽子
Dialogue: 0,0:23:12.98,0:23:14.02,Default,,0,0,0,,怎么
Dialogue: 0,0:23:14.02,0:23:15.90,Default,,0,0,0,,很好玩的
Dialogue: 0,0:23:15.90,0:23:17.32,Default,,0,0,0,,没人踢吗
Dialogue: 0,0:23:20.65,0:23:21.94,Default,,0,0,0,,我陪你
Dialogue: 0,0:23:22.44,0:23:25.19,Default,,0,0,0,,你不是一直想和爹踢毽子吗
Dialogue: 0,0:23:25.19,0:23:26.07,Default,,0,0,0,,那个
Dialogue: 0,0:23:26.06,0:23:27.56,Default,,0,0,0,,吒儿力道有点大
Dialogue: 0,0:23:27.56,0:23:28.85,Default,,0,0,0,,哈哈哈哈
Dialogue: 0,0:23:28.85,0:23:30.56,Default,,0,0,0,,我堂堂武将
Dialogue: 0,0:23:32.81,0:23:33.60,Default,,0,0,0,,爹
Dialogue: 0,0:23:33.60,0:23:35.02,Default,,0,0,0,,不愧我儿
Dialogue: 0,0:23:36.52,0:23:37.65,Default,,0,0,0,,要不
Dialogue: 0,0:23:37.65,0:23:38.57,Default,,0,0,0,,改天再踢吧
Dialogue: 0,0:23:38.56,0:23:39.89,Default,,0,0,0,,哪里的话
Dialogue: 0,0:23:39.90,0:23:41.69,Default,,0,0,0,,今天就要踢尽兴
Dialogue: 0,0:23:42.19,0:23:43.73,Default,,0,0,0,,没事儿 没事儿
Dialogue: 0,0:23:43.73,0:23:44.81,Default,,0,0,0,,那我也来
Dialogue: 0,0:23:44.81,0:23:46.31,Default,,0,0,0,,夫人 你又何苦
Dialogue: 0,0:23:46.31,0:23:47.52,Default,,0,0,0,,瞧不起老娘啊
Dialogue: 0,0:23:47.52,0:23:48.98,Default,,0,0,0,,我也堂堂武将
Dialogue: 0,0:23:49.44,0:23:50.23,Default,,0,0,0,,吒儿
Dialogue: 0,0:23:50.23,0:23:51.31,Default,,0,0,0,,接着
Dialogue: 0,0:23:53.44,0:23:54.19,Default,,0,0,0,,你这孩子
Dialogue: 0,0:23:54.19,0:23:55.73,Default,,0,0,0,,咋这都接不住呢
Dialogue: 0,0:23:56.48,0:23:58.06,Default,,0,0,0,,我不是魔丸就好了
Dialogue: 0,0:23:58.06,0:23:59.35,Default,,0,0,0,,你说什么
Dialogue: 0,0:23:59.35,0:24:00.06,Default,,0,0,0,,没啥
Dialogue: 0,0:24:00.85,0:24:01.85,Default,,0,0,0,,我也该出发了
Dialogue: 0,0:24:01.85,0:24:03.23,Default,,0,0,0,,走之前
Dialogue: 0,0:24:03.23,0:24:04.69,Default,,0,0,0,,能不能给娘一个
Dialogue: 0,0:24:04.69,0:24:06.94,Default,,0,0,0,,大大的拥抱
Dialogue: 0,0:24:09.69,0:24:12.07,Default,,0,0,0,,哎呀 都看着呐
Dialogue: 0,0:24:13.98,0:24:15.06,Default,,0,0,0,,等一等
Dialogue: 0,0:24:16.31,0:24:18.27,Default,,0,0,0,,这都是娘亲手做的好吃的
Dialogue: 0,0:24:18.27,0:24:19.81,Default,,0,0,0,,你和师父带路上吃
Dialogue: 0,0:24:19.81,0:24:20.73,Default,,0,0,0,,知道了知道了
Dialogue: 0,0:24:20.73,0:24:21.11,Default,,0,0,0,,走啦
Dialogue: 0,0:24:21.35,0:24:21.93,Default,,0,0,0,,喂
Dialogue: 0,0:24:21.94,0:24:23.40,Default,,0,0,0,,我还没上来
Dialogue: 0,0:24:29.48,0:24:30.77,Default,,0,0,0,,你肉身还欠火候
Dialogue: 0,0:24:30.77,0:24:32.23,Default,,0,0,0,,千万别乱用蛮力
Dialogue: 0,0:24:32.23,0:24:33.31,Default,,0,0,0,,知道啦
Dialogue: 0,0:24:33.69,0:24:35.07,Default,,0,0,0,,你脾气大
Dialogue: 0,0:24:35.06,0:24:37.35,Default,,0,0,0,,在外遇事要冷静
Dialogue: 0,0:24:37.94,0:24:39.90,Default,,0,0,0,,爹娘不在身边
Dialogue: 0,0:24:39.90,0:24:42.98,Default,,0,0,0,,要学会照顾自己
Dialogue: 0,0:24:43.44,0:24:45.15,Default,,0,0,0,,你这家伙
Dialogue: 0,0:24:45.15,0:24:47.19,Default,,0,0,0,,就抱一下你娘又怎么了嘛
Dialogue: 0,0:24:47.19,0:24:48.27,Default,,0,0,0,,不觉得肉麻呀
Dialogue: 0,0:24:48.27,0:24:49.19,Default,,0,0,0,,又不是见不到了
Dialogue: 0,0:24:49.19,0:24:50.23,Default,,0,0,0,,快走快走
Dialogue: 0,0:25:07.56,0:25:08.60,Default,,0,0,0,,叹什么气
Dialogue: 0,0:25:08.60,0:25:09.56,Default,,0,0,0,,不好吃吗
Dialogue: 0,0:25:09.56,0:25:10.19,Default,,0,0,0,,吃吃吃
Dialogue: 0,0:25:10.19,0:25:11.27,Default,,0,0,0,,就晓得吃
Dialogue: 0,0:25:11.27,0:25:12.35,Default,,0,0,0,,你看我都
Dialogue: 0,0:25:12.35,0:25:13.23,Default,,0,0,0,,愁得都吃不下饭了
Dialogue: 0,0:25:13.23,0:25:15.36,Default,,0,0,0,,你有没有想过怎么通过修仙考核
Dialogue: 0,0:25:16.85,0:25:18.77,Default,,0,0,0,,考些啥呀
Dialogue: 0,0:25:18.77,0:25:21.15,Default,,0,0,0,,考你道行够不够深
Dialogue: 0,0:25:21.15,0:25:22.57,Default,,0,0,0,,你当着监考官的面
Dialogue: 0,0:25:22.56,0:25:23.56,Default,,0,0,0,,赤手空拳降服
Dialogue: 0,0:25:23.56,0:25:25.27,Default,,0,0,0,,三只地仙级别的妖王
Dialogue: 0,0:25:25.27,0:25:26.15,Default,,0,0,0,,打架
Dialogue: 0,0:25:26.15,0:25:27.36,Default,,0,0,0,,我最擅长了
Dialogue: 0,0:25:27.69,0:25:28.61,Default,,0,0,0,,一发出魔气
Dialogue: 0,0:25:28.60,0:25:29.64,Default,,0,0,0,,你身份就暴露了
Dialogue: 0,0:25:29.65,0:25:31.07,Default,,0,0,0,,那就让敖丙控制我身体呗
Dialogue: 0,0:25:31.06,0:25:32.06,Default,,0,0,0,,用他的灵气
Dialogue: 0,0:25:32.06,0:25:33.19,Default,,0,0,0,,还不是一样厉害
Dialogue: 0,0:25:33.90,0:25:34.78,Default,,0,0,0,,说得简单
Dialogue: 0,0:25:34.77,0:25:35.73,Default,,0,0,0,,来试下哇
Dialogue: 0,0:25:36.81,0:25:37.56,Default,,0,0,0,,哪吒
Dialogue: 0,0:25:37.56,0:25:39.39,Default,,0,0,0,,你全身放松
Dialogue: 0,0:25:39.40,0:25:42.61,Default,,0,0,0,,让敖丙控制你的身体和我过两招
Dialogue: 0,0:25:45.77,0:25:47.06,Default,,0,0,0,,敖丙你搞啥
Dialogue: 0,0:25:47.27,0:25:48.23,Default,,0,0,0,,站稳点儿
Dialogue: 0,0:25:48.23,0:25:49.94,Default,,0,0,0,,灵魂附在别人身上
Dialogue: 0,0:25:49.94,0:25:52.11,Default,,0,0,0,,除非比宿主的精神力强大得多
Dialogue: 0,0:25:52.10,0:25:54.35,Default,,0,0,0,,否则是控制不了宿主的身体的
Dialogue: 0,0:25:57.56,0:25:58.73,Default,,0,0,0,,哪吒你还别急
Dialogue: 0,0:25:58.73,0:26:00.27,Default,,0,0,0,,你越使劲儿
Dialogue: 0,0:26:00.27,0:26:02.02,Default,,0,0,0,,敖丙就越控制不住
Dialogue: 0,0:26:02.94,0:26:03.98,Default,,0,0,0,,用腿啊
Dialogue: 0,0:26:03.98,0:26:05.52,Default,,0,0,0,,扫他呀 扫他呀
Dialogue: 0,0:26:14.23,0:26:14.77,Default,,0,0,0,,莫慌
Dialogue: 0,0:26:14.77,0:26:16.73,Default,,0,0,0,,我来救
Dialogue: 0,0:26:18.69,0:26:19.94,Default,,0,0,0,,你
Dialogue: 0,0:26:26.65,0:26:27.90,Default,,0,0,0,,玩得挺开心是吧
Dialogue: 0,0:26:28.23,0:26:29.52,Default,,0,0,0,,马上都到玉虚宫了
Dialogue: 0,0:26:29.52,0:26:30.60,Default,,0,0,0,,还玩
Dialogue: 0,0:26:30.60,0:26:31.68,Default,,0,0,0,,你瞧瞧你从头到脚
Dialogue: 0,0:26:31.69,0:26:33.02,Default,,0,0,0,,哪有个师父的样
Dialogue: 0,0:26:33.02,0:26:34.52,Default,,0,0,0,,站这儿给我好好反省反省
Dialogue: 0,0:26:34.52,0:26:35.77,Default,,0,0,0,,想不出办法不准吃饭
Dialogue: 0,0:26:36.31,0:26:37.19,Default,,0,0,0,,这么大个人儿了
Dialogue: 0,0:26:37.19,0:26:39.11,Default,,0,0,0,,一点儿都不让人省心
Dialogue: 0,0:26:40.94,0:26:41.69,Default,,0,0,0,,有了
Dialogue: 0,0:26:41.69,0:26:44.69,Default,,0,0,0,,迷迷眠眠丹
Dialogue: 0,0:26:44.69,0:26:45.90,Default,,0,0,0,,啥玩意儿
Dialogue: 0,0:26:45.90,0:26:48.07,Default,,0,0,0,,吃了这个立马睡着
Dialogue: 0,0:26:48.06,0:26:48.98,Default,,0,0,0,,你一睡着
Dialogue: 0,0:26:48.98,0:26:51.77,Default,,0,0,0,,敖丙不就完全控制你身体了嘛
Dialogue: 0,0:26:51.77,0:26:52.52,Default,,0,0,0,,妙哉
Dialogue: 0,0:26:54.60,0:26:55.14,Default,,0,0,0,,一颗就够了
Dialogue: 0,0:26:55.65,0:26:57.28,Default,,0,0,0,,不早
Dialogue: 0,0:26:57.27,0:26:57.65,Default,,0,0,0,,说
Dialogue: 0,0:26:59.98,0:27:01.23,Default,,0,0,0,,安逸了
Dialogue: 0,0:27:08.23,0:27:09.61,Default,,0,0,0,,师伯
Dialogue: 0,0:27:10.98,0:27:13.36,Default,,0,0,0,,这个才像正版的嘛
Dialogue: 0,0:27:13.90,0:27:14.86,Default,,0,0,0,,怎么了 师伯
Dialogue: 0,0:27:16.15,0:27:17.40,Default,,0,0,0,,没什么没什么
Dialogue: 0,0:27:17.40,0:27:20.73,Default,,0,0,0,,你已完全接管哪吒身体
Dialogue: 0,0:27:20.73,0:27:21.77,Default,,0,0,0,,再试一下
Dialogue: 0,0:27:23.44,0:27:26.11,Default,,0,0,0,,师伯要动真的了
Dialogue: 0,0:27:26.10,0:27:29.02,Default,,0,0,0,,你最好全力以赴
Dialogue: 0,0:27:39.48,0:27:40.98,Default,,0,0,0,,还请师伯多多指点
Dialogue: 0,0:27:41.73,0:27:42.77,Default,,0,0,0,,还行吧
Dialogue: 0,0:27:42.77,0:27:44.56,Default,,0,0,0,,勉强能和我打个平手
Dialogue: 0,0:27:44.56,0:27:45.23,Default,,0,0,0,,师伯
Dialogue: 0,0:27:45.23,0:27:46.31,Default,,0,0,0,,您流鼻血了
Dialogue: 0,0:27:47.69,0:27:48.27,Default,,0,0,0,,上火而已
Dialogue: 0,0:27:48.27,0:27:49.19,Default,,0,0,0,,最近水喝少了
Dialogue: 0,0:27:49.52,0:27:50.60,Default,,0,0,0,,没得事 没得事
Dialogue: 0,0:27:58.48,0:28:01.40,Default,,0,0,0,,昆仑山到了
Dialogue: 0,0:28:01.40,0:28:02.48,Default,,0,0,0,,这里一天
Dialogue: 0,0:28:02.48,0:28:03.77,Default,,0,0,0,,不会地上一年吧
Dialogue: 0,0:28:03.94,0:28:04.73,Default,,0,0,0,,放心
Dialogue: 0,0:28:04.73,0:28:05.98,Default,,0,0,0,,这还不是天界
Dialogue: 0,0:28:05.98,0:28:07.15,Default,,0,0,0,,这么多人
Dialogue: 0,0:28:07.15,0:28:08.78,Default,,0,0,0,,都是来拜师修仙的
Dialogue: 0,0:28:08.77,0:28:10.10,Default,,0,0,0,,阐教名扬四海
Dialogue: 0,0:28:10.10,0:28:11.56,Default,,0,0,0,,世人无不向往
Dialogue: 0,0:28:12.85,0:28:13.85,Default,,0,0,0,,你看下这个
Dialogue: 0,0:28:13.85,0:28:14.98,Default,,0,0,0,,绿佩
Dialogue: 0,0:28:14.98,0:28:16.73,Default,,0,0,0,,阐教仙人的凭证
Dialogue: 0,0:28:16.73,0:28:17.73,Default,,0,0,0,,有了它
Dialogue: 0,0:28:17.73,0:28:19.98,Default,,0,0,0,,走遍天下任谁都高看你一眼
Dialogue: 0,0:28:19.98,0:28:20.73,Default,,0,0,0,,我跟你说
Dialogue: 0,0:28:20.73,0:28:22.61,Default,,0,0,0,,成仙真好
Dialogue: 0,0:28:22.60,0:28:23.85,Default,,0,0,0,,你那两个哥哥都成仙了
Dialogue: 0,0:28:23.85,0:28:25.02,Default,,0,0,0,,你也没有问题
Dialogue: 0,0:28:25.02,0:28:26.69,Default,,0,0,0,,我是说哪吒他哥
Dialogue: 0,0:28:26.90,0:28:27.98,Default,,0,0,0,,他两个哥啊
Dialogue: 0,0:28:27.98,0:28:30.52,Default,,0,0,0,,都是三代弟子中的佼佼者
Dialogue: 0,0:28:30.52,0:28:31.52,Default,,0,0,0,,你晓得噻
Dialogue: 0,0:28:31.52,0:28:32.98,Default,,0,0,0,,哪吒这个娃儿调皮得很
Dialogue: 0,0:28:32.98,0:28:36.06,Default,,0,0,0,,我就经常摆两个哥的故事给他听
Dialogue: 0,0:28:36.06,0:28:37.73,Default,,0,0,0,,当正面榜样噻
Dialogue: 0,0:28:37.73,0:28:38.98,Default,,0,0,0,,我跟你说
Dialogue: 0,0:28:38.98,0:28:40.94,Default,,0,0,0,,哪吒崇拜他两个哥得很
Dialogue: 0,0:29:03.52,0:29:04.69,Default,,0,0,0,,哦哟 你运气不错
Dialogue: 0,0:29:04.69,0:29:07.07,Default,,0,0,0,,刚来就碰上名满天下的捕妖队
Dialogue: 0,0:29:07.06,0:29:08.39,Default,,0,0,0,,捕妖队
Dialogue: 0,0:29:08.40,0:29:09.94,Default,,0,0,0,,全靠他们四处征讨
Dialogue: 0,0:29:09.94,0:29:11.40,Default,,0,0,0,,祸乱人间的妖物
Dialogue: 0,0:29:11.40,0:29:13.78,Default,,0,0,0,,才保得天下太平
Dialogue: 0,0:29:14.19,0:29:16.02,Default,,0,0,0,,捕妖队现任头领啊
Dialogue: 0,0:29:16.02,0:29:18.10,Default,,0,0,0,,是我大师兄的大弟子
Dialogue: 0,0:29:18.94,0:29:21.27,Default,,0,0,0,,我咋记得前一任还是申公豹呢
Dialogue: 0,0:29:35.73,0:29:36.44,Default,,0,0,0,,师伯
Dialogue: 0,0:29:36.44,0:29:37.90,Default,,0,0,0,,那冒烟的是什么
Dialogue: 0,0:29:37.90,0:29:38.65,Default,,0,0,0,,哦
Dialogue: 0,0:29:38.65,0:29:41.07,Default,,0,0,0,,那是玉虚宫的镇宫之宝
Dialogue: 0,0:29:41.06,0:29:43.19,Default,,0,0,0,,天元鼎
Dialogue: 0,0:29:51.52,0:29:52.44,Default,,0,0,0,,师弟
Dialogue: 0,0:29:52.44,0:29:54.52,Default,,0,0,0,,好久不见呐
Dialogue: 0,0:29:55.52,0:29:56.60,Default,,0,0,0,,大师兄
Dialogue: 0,0:29:56.85,0:29:58.27,Default,,0,0,0,,听闻师尊闭关期间
Dialogue: 0,0:29:58.27,0:30:00.02,Default,,0,0,0,,由大师兄代为执掌玉虚宫
Dialogue: 0,0:30:00.02,0:30:02.56,Default,,0,0,0,,我是带徒儿来参加升仙考核的
Dialogue: 0,0:30:02.56,0:30:03.10,Default,,0,0,0,,哪吒
Dialogue: 0,0:30:03.10,0:30:04.98,Default,,0,0,0,,还不快来拜见大师伯
Dialogue: 0,0:30:04.98,0:30:06.15,Default,,0,0,0,,拜见大师伯
Dialogue: 0,0:30:06.15,0:30:07.65,Default,,0,0,0,,你就是哪吒
Dialogue: 0,0:30:07.65,0:30:09.40,Default,,0,0,0,,灵珠转世
Dialogue: 0,0:30:09.40,0:30:11.32,Default,,0,0,0,,哎呀呀
Dialogue: 0,0:30:11.31,0:30:13.02,Default,,0,0,0,,了不得 了不得
Dialogue: 0,0:30:13.02,0:30:17.27,Default,,0,0,0,,天尊可是对你寄予厚望啊
Dialogue: 0,0:30:17.27,0:30:18.69,Default,,0,0,0,,不愧为灵珠
Dialogue: 0,0:30:18.69,0:30:19.86,Default,,0,0,0,,瞧瞧 瞧瞧
Dialogue: 0,0:30:19.85,0:30:22.06,Default,,0,0,0,,朝气蓬勃
Dialogue: 0,0:30:22.06,0:30:24.02,Default,,0,0,0,,一身正气
Dialogue: 0,0:30:33.06,0:30:34.27,Default,,0,0,0,,他最近练功过度
Dialogue: 0,0:30:34.27,0:30:35.85,Default,,0,0,0,,状态有点不稳定
Dialogue: 0,0:30:38.94,0:30:40.57,Default,,0,0,0,,你这家伙要搞什么
Dialogue: 0,0:30:40.56,0:30:42.02,Default,,0,0,0,,这是玉虚宫
Dialogue: 0,0:30:42.02,0:30:43.48,Default,,0,0,0,,尿胀
Dialogue: 0,0:30:43.48,0:30:44.73,Default,,0,0,0,,鹤童
Dialogue: 0,0:30:44.73,0:30:45.44,Default,,0,0,0,,在
Dialogue: 0,0:30:45.44,0:30:47.98,Default,,0,0,0,,带小师侄去更衣
Dialogue: 0,0:30:47.98,0:30:48.94,Default,,0,0,0,,更啥衣啊
Dialogue: 0,0:30:48.94,0:30:50.19,Default,,0,0,0,,我又没说要换衣服
Dialogue: 0,0:30:50.19,0:30:51.32,Default,,0,0,0,,有病
Dialogue: 0,0:30:51.90,0:30:52.86,Default,,0,0,0,,更衣的意思
Dialogue: 0,0:30:52.85,0:30:55.43,Default,,0,0,0,,就是带你去厕所里撒尿
Dialogue: 0,0:30:56.31,0:30:57.98,Default,,0,0,0,,我这个徒儿粗鄙得很
Dialogue: 0,0:30:57.98,0:30:58.81,Default,,0,0,0,,莫怪莫怪
Dialogue: 0,0:31:06.52,0:31:07.52,Default,,0,0,0,,哇
Dialogue: 0,0:31:07.52,0:31:09.27,Default,,0,0,0,,好白
Dialogue: 0,0:31:10.10,0:31:10.68,Default,,0,0,0,,哇
Dialogue: 0,0:31:10.69,0:31:12.15,Default,,0,0,0,,好白
Dialogue: 0,0:31:13.27,0:31:14.06,Default,,0,0,0,,哇
Dialogue: 0,0:31:14.06,0:31:15.14,Default,,0,0,0,,好白
Dialogue: 0,0:31:15.94,0:31:17.77,Default,,0,0,0,,整个宫殿都是玉做的吗
Dialogue: 0,0:31:17.77,0:31:20.15,Default,,0,0,0,,你们哪儿来那么多钱买玉啊
Dialogue: 0,0:31:20.15,0:31:22.48,Default,,0,0,0,,玉虚宫的玉字就是说用玉做的吧
Dialogue: 0,0:31:22.48,0:31:24.15,Default,,0,0,0,,那虚字啥意思
Dialogue: 0,0:31:24.15,0:31:25.19,Default,,0,0,0,,是谦虚吗
Dialogue: 0,0:31:25.19,0:31:25.94,Default,,0,0,0,,心虚
Dialogue: 0,0:31:25.94,0:31:26.82,Default,,0,0,0,,还是空虚
Dialogue: 0,0:31:28.10,0:31:29.64,Default,,0,0,0,,茅房也是玉做的吗
Dialogue: 0,0:31:29.65,0:31:31.11,Default,,0,0,0,,神仙也要用茅房啊
Dialogue: 0,0:31:32.65,0:31:34.03,Default,,0,0,0,,仙翁也会拉屎吗
Dialogue: 0,0:31:35.35,0:31:36.18,Default,,0,0,0,,清修之地
Dialogue: 0,0:31:36.19,0:31:37.27,Default,,0,0,0,,禁止喧哗
Dialogue: 0,0:31:38.48,0:31:39.73,Default,,0,0,0,,茅房还有多远啊
Dialogue: 0,0:31:39.73,0:31:40.73,Default,,0,0,0,,快憋不住啦
Dialogue: 0,0:31:40.85,0:31:41.93,Default,,0,0,0,,喂 师姐等等我
Dialogue: 0,0:31:43.69,0:31:44.15,Default,,0,0,0,,你
Dialogue: 0,0:31:46.02,0:31:46.90,Default,,0,0,0,,我不是故意的
Dialogue: 0,0:31:47.27,0:31:48.27,Default,,0,0,0,,我要换裙子
Dialogue: 0,0:31:48.27,0:31:49.40,Default,,0,0,0,,你自己去吧
Dialogue: 0,0:31:49.40,0:31:50.78,Default,,0,0,0,,我不知道茅房在哪儿啊
Dialogue: 0,0:31:50.77,0:31:52.90,Default,,0,0,0,,穿过回廊右转再左转
Dialogue: 0,0:31:54.02,0:31:56.02,Default,,0,0,0,,哦
Dialogue: 0,0:32:09.02,0:32:10.40,Default,,0,0,0,,哇
Dialogue: 0,0:32:10.40,0:32:12.19,Default,,0,0,0,,不愧是神仙用的茅房
Dialogue: 0,0:32:12.19,0:32:15.11,Default,,0,0,0,,太有品位了
Dialogue: 0,0:32:38.44,0:32:39.48,Default,,0,0,0,,怪了
Dialogue: 0,0:32:39.48,0:32:40.81,Default,,0,0,0,,咋回不去了
Dialogue: 0,0:32:41.94,0:32:43.44,Default,,0,0,0,,你往哪儿走
Dialogue: 0,0:32:43.44,0:32:43.94,Default,,0,0,0,,哦
Dialogue: 0,0:32:43.94,0:32:44.57,Default,,0,0,0,,我迷路了
Dialogue: 0,0:32:45.90,0:32:46.78,Default,,0,0,0,,跟我来
Dialogue: 0,0:32:48.44,0:32:51.19,Default,,0,0,0,,师弟将灵珠培育成才
Dialogue: 0,0:32:51.19,0:32:54.94,Default,,0,0,0,,可算为本教立了大功一件啊
Dialogue: 0,0:32:54.94,0:32:55.73,Default,,0,0,0,,哪里哪里
Dialogue: 0,0:32:55.73,0:32:57.94,Default,,0,0,0,,全靠师尊的提携
Dialogue: 0,0:32:57.94,0:33:01.32,Default,,0,0,0,,这昆仑甘露乃修仙补品
Dialogue: 0,0:33:01.31,0:33:04.10,Default,,0,0,0,,原本半年才集得了一盆
Dialogue: 0,0:33:04.10,0:33:05.85,Default,,0,0,0,,今天叫人去看
Dialogue: 0,0:33:05.85,0:33:07.31,Default,,0,0,0,,居然满了
Dialogue: 0,0:33:08.31,0:33:10.89,Default,,0,0,0,,来得早不如来得巧啊
Dialogue: 0,0:33:10.90,0:33:12.28,Default,,0,0,0,,师弟
Dialogue: 0,0:33:12.27,0:33:15.06,Default,,0,0,0,,你说你是不是有福之人呐
Dialogue: 0,0:33:18.73,0:33:19.69,Default,,0,0,0,,你抽疯啊
Dialogue: 0,0:33:19.69,0:33:20.86,Default,,0,0,0,,水都不会喝了
Dialogue: 0,0:33:21.40,0:33:23.03,Default,,0,0,0,,我这个徒儿粗鄙得很
Dialogue: 0,0:33:23.02,0:33:23.77,Default,,0,0,0,,莫怪莫怪
Dialogue: 0,0:33:25.40,0:33:27.11,Default,,0,0,0,,水里有我的尿
Dialogue: 0,0:33:31.52,0:33:33.06,Default,,0,0,0,,我这师父也粗鄙得很
Dialogue: 0,0:33:33.06,0:33:33.94,Default,,0,0,0,,莫怪莫怪
Dialogue: 0,0:33:34.65,0:33:35.32,Default,,0,0,0,,师兄
Dialogue: 0,0:33:35.31,0:33:36.06,Default,,0,0,0,,事不宜迟
Dialogue: 0,0:33:36.06,0:33:38.52,Default,,0,0,0,,我看还是立刻让哪吒参加考核吧
Dialogue: 0,0:33:38.90,0:33:40.23,Default,,0,0,0,,何必着急啊
Dialogue: 0,0:33:40.23,0:33:42.23,Default,,0,0,0,,多喝几杯再走嘛
Dialogue: 0,0:33:42.23,0:33:43.11,Default,,0,0,0,,不喝了不喝了
Dialogue: 0,0:33:44.27,0:33:45.73,Default,,0,0,0,,那也行吧
Dialogue: 0,0:33:46.65,0:33:49.61,Default,,0,0,0,,那就派我的徒儿鹿童监考
Dialogue: 0,0:33:49.60,0:33:51.10,Default,,0,0,0,,捕妖队的下一个目标
Dialogue: 0,0:33:51.10,0:33:53.06,Default,,0,0,0,,就交给哪吒降服吧
Dialogue: 0,0:33:53.06,0:33:54.35,Default,,0,0,0,,师兄告辞
Dialogue: 0,0:33:58.19,0:33:59.36,Default,,0,0,0,,我这个师弟
Dialogue: 0,0:33:59.35,0:34:01.18,Default,,0,0,0,,还是这么急性子
Dialogue: 0,0:34:05.15,0:34:08.15,Default,,0,0,0,,这次甘露的味道
Dialogue: 0,0:34:10.65,0:34:12.98,Default,,0,0,0,,特别浓郁
Dialogue: 0,0:34:12.98,0:34:15.81,Default,,0,0,0,,以后都要沿用这次的工艺
Dialogue: 0,0:34:15.81,0:34:18.02,Default,,0,0,0,,诺
Dialogue: 0,0:34:59.40,0:35:00.19,Default,,0,0,0,,怎么停了
Dialogue: 0,0:35:00.69,0:35:01.82,Default,,0,0,0,,都三个时辰了
Dialogue: 0,0:35:01.81,0:35:02.73,Default,,0,0,0,,道长
Dialogue: 0,0:35:02.73,0:35:03.86,Default,,0,0,0,,实在扔不动了
Dialogue: 0,0:35:03.85,0:35:04.43,Default,,0,0,0,,废物
Dialogue: 0,0:35:04.44,0:35:06.57,Default,,0,0,0,,修炼怎可懈怠
Dialogue: 0,0:35:06.56,0:35:08.10,Default,,0,0,0,,我不说停
Dialogue: 0,0:35:08.10,0:35:09.52,Default,,0,0,0,,就...就不准停
Dialogue: 0,0:35:16.35,0:35:18.27,Default,,0,0,0,,陈塘关李靖求见
Dialogue: 0,0:35:18.27,0:35:19.48,Default,,0,0,0,,申道长
Dialogue: 0,0:35:19.48,0:35:20.44,Default,,0,0,0,,昨日一战
Dialogue: 0,0:35:20.44,0:35:22.73,Default,,0,0,0,,陈塘关军民伤者甚众
Dialogue: 0,0:35:22.73,0:35:24.02,Default,,0,0,0,,药物告罄
Dialogue: 0,0:35:24.81,0:35:27.35,Default,,0,0,0,,恳请道长开个通道
Dialogue: 0,0:35:27.35,0:35:30.14,Default,,0,0,0,,放几个大夫出城采买药物
Dialogue: 0,0:35:34.85,0:35:36.27,Default,,0,0,0,,好胆色
Dialogue: 0,0:35:36.27,0:35:37.31,Default,,0,0,0,,不愧是
Dialogue: 0,0:35:37.81,0:35:38.85,Default,,0,0,0,,哪个混账
Dialogue: 0,0:35:39.23,0:35:40.48,Default,,0,0,0,,你个王八
Dialogue: 0,0:35:40.69,0:35:41.52,Default,,0,0,0,,我
Dialogue: 0,0:35:43.02,0:35:45.06,Default,,0,0,0,,停...停...停停停
Dialogue: 0,0:35:51.23,0:35:53.11,Default,,0,0,0,,把刚才捉到那位
Dialogue: 0,0:35:53.10,0:35:54.81,Default,,0,0,0,,带上来
Dialogue: 0,0:35:54.81,0:35:57.56,Default,,0,0,0,,大战时从城里逃出来的
Dialogue: 0,0:35:57.56,0:35:59.14,Default,,0,0,0,,劳烦李总兵
Dialogue: 0,0:35:59.15,0:36:01.53,Default,,0,0,0,,把他也带...带回去
Dialogue: 0,0:36:01.52,0:36:03.02,Default,,0,0,0,,误会啊申道长
Dialogue: 0,0:36:03.02,0:36:04.65,Default,,0,0,0,,我也妖怪呀我
Dialogue: 0,0:36:04.65,0:36:05.78,Default,,0,0,0,,这海夜叉
Dialogue: 0,0:36:05.77,0:36:08.73,Default,,0,0,0,,我原本捉他来是为了还我儿清白
Dialogue: 0,0:36:08.73,0:36:10.15,Default,,0,0,0,,现下事情已了
Dialogue: 0,0:36:10.15,0:36:12.65,Default,,0,0,0,,他也没做什么伤天害理之事
Dialogue: 0,0:36:12.65,0:36:13.82,Default,,0,0,0,,就随他去吧
Dialogue: 0,0:36:14.35,0:36:15.23,Default,,0,0,0,,就是就是
Dialogue: 0,0:36:15.23,0:36:16.35,Default,,0,0,0,,我是配角
Dialogue: 0,0:36:16.35,0:36:17.93,Default,,0,0,0,,小配角
Dialogue: 0,0:36:18.90,0:36:20.94,Default,,0,0,0,,看来你是没听明白
Dialogue: 0,0:36:20.94,0:36:24.44,Default,,0,0,0,,我连只妖都不会放出去
Dialogue: 0,0:36:24.44,0:36:25.82,Default,,0,0,0,,何况人
Dialogue: 0,0:36:26.69,0:36:28.40,Default,,0,0,0,,道长开恩啊
Dialogue: 0,0:36:28.40,0:36:30.90,Default,,0,0,0,,我也是妖啊
Dialogue: 0,0:36:30.90,0:36:32.90,Default,,0,0,0,,我们都是反派呀
Dialogue: 0,0:36:32.90,0:36:33.53,Default,,0,0,0,,呸
Dialogue: 0,0:36:33.52,0:36:35.27,Default,,0,0,0,,谁...谁跟你是反派
Dialogue: 0,0:36:35.27,0:36:36.90,Default,,0,0,0,,知道灵珠秘密的
Dialogue: 0,0:36:36.90,0:36:38.15,Default,,0,0,0,,都别想出去
Dialogue: 0,0:36:38.15,0:36:39.57,Default,,0,0,0,,若无药医治
Dialogue: 0,0:36:39.56,0:36:42.19,Default,,0,0,0,,伤患性命难保
Dialogue: 0,0:36:44.35,0:36:46.93,Default,,0,0,0,,还望道长
Dialogue: 0,0:36:46.94,0:36:48.19,Default,,0,0,0,,网开一面
Dialogue: 0,0:36:49.60,0:36:50.98,Default,,0,0,0,,报
Dialogue: 0,0:36:50.98,0:36:52.19,Default,,0,0,0,,抓到一名奸细
Dialogue: 0,0:36:52.19,0:36:53.40,Default,,0,0,0,,这人是从城外来的
Dialogue: 0,0:36:53.40,0:36:54.65,Default,,0,0,0,,还伤了我们几个弟兄
Dialogue: 0,0:36:54.65,0:36:56.57,Default,,0,0,0,,也关...关进城去
Dialogue: 0,0:36:56.56,0:36:58.06,Default,,0,0,0,,哥
Dialogue: 0,0:36:58.06,0:36:59.19,Default,,0,0,0,,哥 是你吗
Dialogue: 0,0:36:59.60,0:37:00.93,Default,,0,0,0,,你
Dialogue: 0,0:37:00.94,0:37:02.02,Default,,0,0,0,,哥 是我啊
Dialogue: 0,0:37:05.81,0:37:07.56,Default,,0,0,0,,申小豹
Dialogue: 0,0:37:09.40,0:37:10.82,Default,,0,0,0,,你百多年没回过家
Dialogue: 0,0:37:10.81,0:37:12.39,Default,,0,0,0,,我好想你啊
Dialogue: 0,0:37:13.06,0:37:14.35,Default,,0,0,0,,你怎么来了
Dialogue: 0,0:37:14.35,0:37:15.73,Default,,0,0,0,,爹叫我来找你啊
Dialogue: 0,0:37:15.73,0:37:16.35,Default,,0,0,0,,瞧
Dialogue: 0,0:37:16.65,0:37:17.69,Default,,0,0,0,,你送我的罗盘
Dialogue: 0,0:37:17.69,0:37:19.19,Default,,0,0,0,,能测你的位置
Dialogue: 0,0:37:20.56,0:37:21.77,Default,,0,0,0,,爹
Dialogue: 0,0:37:21.77,0:37:23.77,Default,,0,0,0,,他老人家还好吗
Dialogue: 0,0:37:23.77,0:37:24.65,Default,,0,0,0,,好着呢
Dialogue: 0,0:37:24.65,0:37:25.94,Default,,0,0,0,,自从你进了玉虚宫
Dialogue: 0,0:37:25.94,0:37:28.19,Default,,0,0,0,,爹就跟吃了大补丸似的
Dialogue: 0,0:37:28.19,0:37:29.69,Default,,0,0,0,,天天倍儿精神
Dialogue: 0,0:37:29.69,0:37:31.40,Default,,0,0,0,,我们七山五岭可就出了
Dialogue: 0,0:37:31.40,0:37:33.32,Default,,0,0,0,,你一个阐教仙人
Dialogue: 0,0:37:33.31,0:37:34.39,Default,,0,0,0,,十里八乡的妖族
Dialogue: 0,0:37:34.40,0:37:35.90,Default,,0,0,0,,都争着拜爹为师呢
Dialogue: 0,0:37:38.44,0:37:39.36,Default,,0,0,0,,对了
Dialogue: 0,0:37:40.06,0:37:41.27,Default,,0,0,0,,你来找我干嘛
Dialogue: 0,0:37:42.56,0:37:43.94,Default,,0,0,0,,你以前不说过
Dialogue: 0,0:37:43.94,0:37:45.27,Default,,0,0,0,,等我修炼成人形
Dialogue: 0,0:37:45.27,0:37:47.31,Default,,0,0,0,,就引荐我进玉虚宫吗
Dialogue: 0,0:37:47.31,0:37:48.89,Default,,0,0,0,,我会变人了耶
Dialogue: 0,0:37:55.40,0:37:57.07,Default,,0,0,0,,这些年我天天都用功
Dialogue: 0,0:37:57.06,0:37:59.06,Default,,0,0,0,,从没偷过懒哦
Dialogue: 0,0:37:59.06,0:38:00.73,Default,,0,0,0,,哥就是我的榜样
Dialogue: 0,0:38:00.73,0:38:03.06,Default,,0,0,0,,玉虚名门济天下
Dialogue: 0,0:38:03.06,0:38:07.48,Default,,0,0,0,,替天行道走四方
Dialogue: 0,0:38:09.48,0:38:10.65,Default,,0,0,0,,对了 哥
Dialogue: 0,0:38:10.65,0:38:11.61,Default,,0,0,0,,你在这儿干嘛呀
Dialogue: 0,0:38:11.60,0:38:13.52,Default,,0,0,0,,我...我...
Dialogue: 0,0:38:13.52,0:38:15.31,Default,,0,0,0,,这些海妖都是你部下吗
Dialogue: 0,0:38:15.31,0:38:17.35,Default,,0,0,0,,你们把陈塘关围起来干啥
Dialogue: 0,0:38:17.35,0:38:18.39,Default,,0,0,0,,那个嘛
Dialogue: 0,0:38:18.40,0:38:20.53,Default,,0,0,0,,这...这是...
Dialogue: 0,0:38:20.52,0:38:22.85,Default,,0,0,0,,申道长在守卫陈塘关
Dialogue: 0,0:38:23.19,0:38:24.52,Default,,0,0,0,,啊
Dialogue: 0,0:38:24.52,0:38:26.10,Default,,0,0,0,,因有邪魔外道来犯
Dialogue: 0,0:38:26.10,0:38:29.68,Default,,0,0,0,,申道长率海族前来守城
Dialogue: 0,0:38:29.69,0:38:33.23,Default,,0,0,0,,我代全城百姓拜谢道长之义举
Dialogue: 0,0:38:35.35,0:38:37.27,Default,,0,0,0,,好说 好说
Dialogue: 0,0:38:37.56,0:38:39.14,Default,,0,0,0,,哇
Dialogue: 0,0:38:39.15,0:38:41.32,Default,,0,0,0,,哥 你太了不起了
Dialogue: 0,0:38:41.31,0:38:43.44,Default,,0,0,0,,这就袭击陈塘关的妖怪吗
Dialogue: 0,0:38:44.35,0:38:45.93,Default,,0,0,0,,啊
Dialogue: 0,0:38:45.94,0:38:48.15,Default,,0,0,0,,妖族的名声都被你们败光了
Dialogue: 0,0:38:48.15,0:38:48.98,Default,,0,0,0,,败类
Dialogue: 0,0:38:49.94,0:38:50.82,Default,,0,0,0,,那个
Dialogue: 0,0:38:50.81,0:38:52.19,Default,,0,0,0,,小豹啊
Dialogue: 0,0:38:52.19,0:38:53.48,Default,,0,0,0,,你
Dialogue: 0,0:38:53.48,0:38:56.02,Default,,0,0,0,,能不能等几年
Dialogue: 0,0:38:56.02,0:38:57.10,Default,,0,0,0,,再上玉虚宫
Dialogue: 0,0:38:57.52,0:38:58.35,Default,,0,0,0,,啊
Dialogue: 0,0:38:58.35,0:38:59.68,Default,,0,0,0,,为什么啊
Dialogue: 0,0:38:59.69,0:39:01.65,Default,,0,0,0,,我会变人了啊
Dialogue: 0,0:39:02.10,0:39:03.56,Default,,0,0,0,,最近
Dialogue: 0,0:39:03.56,0:39:06.19,Default,,0,0,0,,我准备晋升十二金仙
Dialogue: 0,0:39:06.19,0:39:07.36,Default,,0,0,0,,不能分心
Dialogue: 0,0:39:07.35,0:39:09.06,Default,,0,0,0,,十二金仙
Dialogue: 0,0:39:09.06,0:39:10.85,Default,,0,0,0,,事成之后
Dialogue: 0,0:39:10.85,0:39:11.77,Default,,0,0,0,,再带你
Dialogue: 0,0:39:12.44,0:39:13.48,Default,,0,0,0,,好吗
Dialogue: 0,0:39:16.69,0:39:17.52,Default,,0,0,0,,没事儿 哥
Dialogue: 0,0:39:17.52,0:39:18.69,Default,,0,0,0,,晋级重要
Dialogue: 0,0:39:18.69,0:39:21.02,Default,,0,0,0,,我什么时候上玉虚宫都一样
Dialogue: 0,0:39:22.02,0:39:23.69,Default,,0,0,0,,反正
Dialogue: 0,0:39:23.69,0:39:25.90,Default,,0,0,0,,我变人还不熟练
Dialogue: 0,0:39:25.90,0:39:27.65,Default,,0,0,0,,回去再练练
Dialogue: 0,0:39:27.65,0:39:28.69,Default,,0,0,0,,再练练
Dialogue: 0,0:39:32.10,0:39:32.85,Default,,0,0,0,,小豹
Dialogue: 0,0:39:33.60,0:39:35.23,Default,,0,0,0,,这是我进宫后攒的
Dialogue: 0,0:39:35.52,0:39:36.73,Default,,0,0,0,,这什么呀
Dialogue: 0,0:39:36.73,0:39:39.73,Default,,0,0,0,,玉虚宫给所有弟子定期发放仙丹
Dialogue: 0,0:39:39.73,0:39:40.65,Default,,0,0,0,,吃一颗
Dialogue: 0,0:39:40.65,0:39:42.48,Default,,0,0,0,,顶...顶十年苦修
Dialogue: 0,0:39:42.77,0:39:43.85,Default,,0,0,0,,这
Dialogue: 0,0:39:43.85,0:39:45.10,Default,,0,0,0,,这太宝贵了
Dialogue: 0,0:39:45.10,0:39:46.81,Default,,0,0,0,,哥 你在晋级
Dialogue: 0,0:39:46.81,0:39:48.31,Default,,0,0,0,,还是你吃 你吃
Dialogue: 0,0:39:48.31,0:39:49.64,Default,,0,0,0,,哥吃不惯这个
Dialogue: 0,0:39:49.65,0:39:51.65,Default,,0,0,0,,就喜欢自己修炼
Dialogue: 0,0:39:51.65,0:39:52.86,Default,,0,0,0,,你...你拿回去
Dialogue: 0,0:39:52.85,0:39:53.85,Default,,0,0,0,,家里人分着吃
Dialogue: 0,0:39:55.23,0:39:55.77,Default,,0,0,0,,不行不行
Dialogue: 0,0:39:55.77,0:39:56.98,Default,,0,0,0,,爹肯定会怪我
Dialogue: 0,0:39:56.98,0:39:57.94,Default,,0,0,0,,小豹
Dialogue: 0,0:39:57.94,0:39:59.15,Default,,0,0,0,,不听哥话啦
Dialogue: 0,0:39:59.15,0:40:00.65,Default,,0,0,0,,带上仙丹快走
Dialogue: 0,0:40:00.65,0:40:02.28,Default,,0,0,0,,这是前线
Dialogue: 0,0:40:02.27,0:40:03.52,Default,,0,0,0,,再...再不走
Dialogue: 0,0:40:03.52,0:40:04.77,Default,,0,0,0,,影响我指挥
Dialogue: 0,0:40:05.19,0:40:06.69,Default,,0,0,0,,那
Dialogue: 0,0:40:06.69,0:40:08.48,Default,,0,0,0,,我
Dialogue: 0,0:40:08.48,0:40:09.77,Default,,0,0,0,,走啦
Dialogue: 0,0:40:13.52,0:40:14.44,Default,,0,0,0,,哥
Dialogue: 0,0:40:14.44,0:40:16.69,Default,,0,0,0,,你一定要当上十二金仙
Dialogue: 0,0:40:18.65,0:40:20.57,Default,,0,0,0,,我也会继续努力的
Dialogue: 0,0:40:25.90,0:40:27.40,Default,,0,0,0,,你虽帮了我
Dialogue: 0,0:40:27.40,0:40:28.61,Default,,0,0,0,,但事关重大
Dialogue: 0,0:40:28.60,0:40:30.14,Default,,0,0,0,,我还是不能放人
Dialogue: 0,0:40:30.15,0:40:31.19,Default,,0,0,0,,这夜叉
Dialogue: 0,0:40:31.19,0:40:33.07,Default,,0,0,0,,你...你也带回去
Dialogue: 0,0:40:33.06,0:40:34.44,Default,,0,0,0,,我帮的不是你
Dialogue: 0,0:40:34.44,0:40:36.11,Default,,0,0,0,,而是那个少年
Dialogue: 0,0:40:36.65,0:40:38.73,Default,,0,0,0,,一个好的榜样
Dialogue: 0,0:40:38.73,0:40:41.15,Default,,0,0,0,,能改变他的一生
Dialogue: 0,0:40:42.77,0:40:43.65,Default,,0,0,0,,等一下
Dialogue: 0,0:40:45.94,0:40:47.98,Default,,0,0,0,,留...留个药材清单
Dialogue: 0,0:41:30.06,0:41:33.06,Default,,0,0,0,,我乃哪吒三太子
Dialogue: 0,0:41:33.06,0:41:35.98,Default,,0,0,0,,能降妖来会作诗
Dialogue: 0,0:41:35.98,0:41:38.86,Default,,0,0,0,,今日到此除奸恶
Dialogue: 0,0:41:38.85,0:41:42.85,Default,,0,0,0,,尔等妖孽快受死
Dialogue: 0,0:41:46.60,0:41:47.56,Default,,0,0,0,,还吃
Dialogue: 0,0:41:47.56,0:41:49.56,Default,,0,0,0,,收你们来了
Dialogue: 0,0:41:52.06,0:41:53.73,Default,,0,0,0,,啊
Dialogue: 0,0:41:54.60,0:41:58.02,Default,,0,0,0,,谁吃了熊心豹子胆啦
Dialogue: 0,0:41:58.02,0:42:01.60,Default,,0,0,0,,敢到土肥坡来撒野啊
Dialogue: 0,0:42:02.19,0:42:03.19,Default,,0,0,0,,你就是头儿
Dialogue: 0,0:42:03.19,0:42:03.94,Default,,0,0,0,,来来来
Dialogue: 0,0:42:03.94,0:42:05.27,Default,,0,0,0,,领教下小爷的手段
Dialogue: 0,0:42:06.40,0:42:08.28,Default,,0,0,0,,小屁孩儿狂得没边儿
Dialogue: 0,0:42:08.27,0:42:09.06,Default,,0,0,0,,大哥
Dialogue: 0,0:42:09.06,0:42:10.81,Default,,0,0,0,,给他点儿颜色瞧瞧
Dialogue: 0,0:42:29.23,0:42:30.52,Default,,0,0,0,,出招吧
Dialogue: 0,0:42:32.35,0:42:33.52,Default,,0,0,0,,你上
Dialogue: 0,0:42:33.52,0:42:35.44,Default,,0,0,0,,不 不 不是 大哥
Dialogue: 0,0:42:35.44,0:42:37.48,Default,,0,0,0,,小弟怎么能跟你抢风头呢
Dialogue: 0,0:42:37.48,0:42:39.77,Default,,0,0,0,,跟小孩儿打多没面子
Dialogue: 0,0:42:39.77,0:42:41.85,Default,,0,0,0,,叫你上你就上
Dialogue: 0,0:42:41.85,0:42:43.18,Default,,0,0,0,,小 小 小孩儿
Dialogue: 0,0:42:43.19,0:42:44.02,Default,,0,0,0,,看你小
Dialogue: 0,0:42:44.02,0:42:44.90,Default,,0,0,0,,不懂事儿
Dialogue: 0,0:42:44.90,0:42:46.36,Default,,0,0,0,,咱也不跟你计较
Dialogue: 0,0:42:46.35,0:42:47.73,Default,,0,0,0,,你 你 你
Dialogue: 0,0:42:47.73,0:42:50.02,Default,,0,0,0,,现在想回家还来得及哈
Dialogue: 0,0:42:50.60,0:42:51.23,Default,,0,0,0,,咋回事儿
Dialogue: 0,0:42:51.23,0:42:52.31,Default,,0,0,0,,你怎么又醒了
Dialogue: 0,0:42:52.31,0:42:53.02,Default,,0,0,0,,不知道啊
Dialogue: 0,0:42:53.02,0:42:54.02,Default,,0,0,0,,睡不沉
Dialogue: 0,0:42:54.02,0:42:55.73,Default,,0,0,0,,你抖了几下就把我颠醒了
Dialogue: 0,0:42:56.44,0:42:57.40,Default,,0,0,0,,糟了
Dialogue: 0,0:42:57.56,0:42:58.48,Default,,0,0,0,,上次药吃多了
Dialogue: 0,0:42:58.48,0:42:59.65,Default,,0,0,0,,有抗药性了
Dialogue: 0,0:43:00.06,0:43:01.14,Default,,0,0,0,,加大药量
Dialogue: 0,0:43:01.31,0:43:05.06,Default,,0,0,0,,再不走我不客气啦
Dialogue: 0,0:43:08.98,0:43:10.31,Default,,0,0,0,,我想往右躲呀
Dialogue: 0,0:43:10.31,0:43:11.73,Default,,0,0,0,,抱歉 我以为要向左
Dialogue: 0,0:43:14.48,0:43:15.90,Default,,0,0,0,,这么不经打
Dialogue: 0,0:43:15.90,0:43:16.61,Default,,0,0,0,,师伯
Dialogue: 0,0:43:16.60,0:43:17.93,Default,,0,0,0,,要不还是我上吧
Dialogue: 0,0:43:17.94,0:43:19.32,Default,,0,0,0,,师弟多练几年再来晋级
Dialogue: 0,0:43:19.31,0:43:20.48,Default,,0,0,0,,你再等一下
Dialogue: 0,0:43:20.48,0:43:22.56,Default,,0,0,0,,他在跟妖怪开玩笑
Dialogue: 0,0:43:22.56,0:43:23.44,Default,,0,0,0,,我这个徒弟就是
Dialogue: 0,0:43:23.44,0:43:24.44,Default,,0,0,0,,就是爱装
Dialogue: 0,0:43:25.35,0:43:27.35,Default,,0,0,0,,药 药
Dialogue: 0,0:43:27.35,0:43:28.14,Default,,0,0,0,,得吃药
Dialogue: 0,0:43:28.15,0:43:30.48,Default,,0,0,0,,叫你走你不走
Dialogue: 0,0:43:30.48,0:43:33.23,Default,,0,0,0,,现在知道爷的厉害了吧
Dialogue: 0,0:43:33.23,0:43:33.69,Default,,0,0,0,,糟了
Dialogue: 0,0:43:33.69,0:43:35.02,Default,,0,0,0,,药都化汤里了
Dialogue: 0,0:43:36.02,0:43:37.98,Default,,0,0,0,,那我就喝汤
Dialogue: 0,0:43:40.02,0:43:41.90,Default,,0,0,0,,还敢偷我们汤
Dialogue: 0,0:43:41.90,0:43:43.32,Default,,0,0,0,,欠打
Dialogue: 0,0:43:44.69,0:43:46.23,Default,,0,0,0,,让我来
Dialogue: 0,0:43:49.15,0:43:49.90,Default,,0,0,0,,太恶心了
Dialogue: 0,0:43:49.90,0:43:53.61,Default,,0,0,0,,大力金刚棒
Dialogue: 0,0:43:57.81,0:43:58.48,Default,,0,0,0,,你看
Dialogue: 0,0:43:58.48,0:43:59.56,Default,,0,0,0,,我说他装的嘛
Dialogue: 0,0:44:00.44,0:44:02.32,Default,,0,0,0,,刚才是大意了
Dialogue: 0,0:44:02.31,0:44:03.02,Default,,0,0,0,,不算
Dialogue: 0,0:44:20.27,0:44:22.94,Default,,0,0,0,,不可能 不可能
Dialogue: 0,0:44:28.56,0:44:30.73,Default,,0,0,0,,你咋这菜
Dialogue: 0,0:44:30.73,0:44:31.81,Default,,0,0,0,,一边儿待着
Dialogue: 0,0:44:31.81,0:44:32.89,Default,,0,0,0,,看我怎么收拾他
Dialogue: 0,0:44:33.48,0:44:34.69,Default,,0,0,0,,你怎么全吐了呀
Dialogue: 0,0:44:34.69,0:44:35.32,Default,,0,0,0,,味道太冲
Dialogue: 0,0:44:35.31,0:44:36.23,Default,,0,0,0,,实在没忍住
Dialogue: 0,0:44:36.23,0:44:38.19,Default,,0,0,0,,看招
Dialogue: 0,0:44:41.40,0:44:42.61,Default,,0,0,0,,戏精
Dialogue: 0,0:44:42.85,0:44:43.68,Default,,0,0,0,,不行啊
Dialogue: 0,0:44:43.69,0:44:45.11,Default,,0,0,0,,只有吃药才有胜算
Dialogue: 0,0:44:53.85,0:44:54.93,Default,,0,0,0,,鹿童在这儿
Dialogue: 0,0:44:54.94,0:44:56.40,Default,,0,0,0,,我没法给你药啊
Dialogue: 0,0:44:56.40,0:44:57.65,Default,,0,0,0,,怎么办 怎么办
Dialogue: 0,0:44:57.65,0:44:59.15,Default,,0,0,0,,有
Dialogue: 0,0:44:59.15,0:45:01.69,Default,,0,0,0,,还有一个办法
Dialogue: 0,0:45:01.69,0:45:02.82,Default,,0,0,0,,你该不会是想
Dialogue: 0,0:45:02.81,0:45:05.02,Default,,0,0,0,,把吐了的全吃回来
Dialogue: 0,0:45:05.02,0:45:05.69,Default,,0,0,0,,这
Dialogue: 0,0:45:05.69,0:45:07.15,Default,,0,0,0,,这怎么行
Dialogue: 0,0:45:08.15,0:45:09.07,Default,,0,0,0,,怕什么
Dialogue: 0,0:45:09.06,0:45:10.60,Default,,0,0,0,,我连夜叉鼻涕都喝过
Dialogue: 0,0:45:11.77,0:45:13.31,Default,,0,0,0,,原来如此
Dialogue: 0,0:45:13.31,0:45:15.02,Default,,0,0,0,,能人所不能
Dialogue: 0,0:45:15.02,0:45:17.10,Default,,0,0,0,,忍人所不忍
Dialogue: 0,0:45:17.10,0:45:19.68,Default,,0,0,0,,哪吒果然是不认命
Dialogue: 0,0:45:20.65,0:45:23.57,Default,,0,0,0,,我肩负父母朋友的性命
Dialogue: 0,0:45:24.65,0:45:27.36,Default,,0,0,0,,陈塘关百姓的安危
Dialogue: 0,0:45:27.35,0:45:31.39,Default,,0,0,0,,受这点罪又算什么
Dialogue: 0,0:45:39.27,0:45:41.48,Default,,0,0,0,,无视世俗之偏见
Dialogue: 0,0:45:41.48,0:45:43.69,Default,,0,0,0,,突破心中之魔障
Dialogue: 0,0:45:43.69,0:45:46.36,Default,,0,0,0,,我要扭转命运
Dialogue: 0,0:46:05.48,0:46:07.77,Default,,0,0,0,,以前我就是低调
Dialogue: 0,0:46:07.77,0:46:09.77,Default,,0,0,0,,今儿跟大家露两手
Dialogue: 0,0:46:10.19,0:46:11.44,Default,,0,0,0,,师伯
Dialogue: 0,0:46:11.44,0:46:12.73,Default,,0,0,0,,先救哪吒
Dialogue: 0,0:46:12.73,0:46:14.52,Default,,0,0,0,,玉液琼浆只有另想办法了
Dialogue: 0,0:46:14.52,0:46:15.94,Default,,0,0,0,,没道理
Dialogue: 0,0:46:15.94,0:46:16.98,Default,,0,0,0,,我不信
Dialogue: 0,0:46:17.19,0:46:17.90,Default,,0,0,0,,小娃
Dialogue: 0,0:46:17.90,0:46:19.28,Default,,0,0,0,,再跟我打一场
Dialogue: 0,0:46:20.73,0:46:21.77,Default,,0,0,0,,装死
Dialogue: 0,0:46:21.77,0:46:24.44,Default,,0,0,0,,我捶扁你
Dialogue: 0,0:46:31.81,0:46:33.27,Default,,0,0,0,,多亏哪吒被砸晕了
Dialogue: 0,0:46:34.19,0:46:37.19,Default,,0,0,0,,说你菜你还不服
Dialogue: 0,0:46:38.40,0:46:39.90,Default,,0,0,0,,看我来替你报仇
Dialogue: 0,0:46:39.90,0:46:43.40,Default,,0,0,0,,无敌旋风拳
Dialogue: 0,0:46:57.90,0:46:59.23,Default,,0,0,0,,啊
Dialogue: 0,0:47:17.56,0:47:18.64,Default,,0,0,0,,全都得抓吗
Dialogue: 0,0:47:18.65,0:47:19.86,Default,,0,0,0,,留下一只
Dialogue: 0,0:47:19.85,0:47:21.68,Default,,0,0,0,,也会祸害这里的百姓
Dialogue: 0,0:47:21.69,0:47:22.98,Default,,0,0,0,,都带回玉虚宫
Dialogue: 0,0:47:22.98,0:47:24.98,Default,,0,0,0,,本教会将它们引入正道
Dialogue: 0,0:47:24.98,0:47:26.23,Default,,0,0,0,,改邪归正
Dialogue: 0,0:47:27.10,0:47:28.43,Default,,0,0,0,,师弟的样子
Dialogue: 0,0:47:28.44,0:47:29.86,Default,,0,0,0,,没事没事哈
Dialogue: 0,0:47:29.85,0:47:31.31,Default,,0,0,0,,他就是一会儿丑一会儿帅
Dialogue: 0,0:47:31.31,0:47:32.14,Default,,0,0,0,,灵珠嘛
Dialogue: 0,0:47:32.15,0:47:33.73,Default,,0,0,0,,肯定跟正常人不一样噻
Dialogue: 0,0:47:34.98,0:47:36.31,Default,,0,0,0,,下回稳当点儿
Dialogue: 0,0:47:36.65,0:47:38.65,Default,,0,0,0,,魂儿都给我吓没了
Dialogue: 0,0:47:50.35,0:47:51.27,Default,,0,0,0,,这小孩儿谁呀
Dialogue: 0,0:47:51.27,0:47:52.40,Default,,0,0,0,,听说叫哪吒
Dialogue: 0,0:47:52.40,0:47:53.53,Default,,0,0,0,,金吒木吒的弟弟
Dialogue: 0,0:47:53.52,0:47:56.06,Default,,0,0,0,,他是天尊钦定的灵珠转世
Dialogue: 0,0:47:58.94,0:48:01.44,Default,,0,0,0,,但形象可不咋样
Dialogue: 0,0:48:01.44,0:48:03.07,Default,,0,0,0,,弓腰驼背
Dialogue: 0,0:48:03.06,0:48:04.31,Default,,0,0,0,,脚步轻浮
Dialogue: 0,0:48:04.31,0:48:05.56,Default,,0,0,0,,低眉垂眼
Dialogue: 0,0:48:05.56,0:48:06.60,Default,,0,0,0,,相貌猥琐
Dialogue: 0,0:48:06.60,0:48:07.77,Default,,0,0,0,,还带黑眼圈
Dialogue: 0,0:48:07.77,0:48:09.52,Default,,0,0,0,,长得跟个鬼似的
Dialogue: 0,0:48:16.65,0:48:18.03,Default,,0,0,0,,莫惹事生非哈
Dialogue: 0,0:48:26.19,0:48:27.57,Default,,0,0,0,,师弟
Dialogue: 0,0:48:27.56,0:48:30.39,Default,,0,0,0,,你瞧今晚是何星象
Dialogue: 0,0:48:30.40,0:48:32.11,Default,,0,0,0,,六星连珠
Dialogue: 0,0:48:32.10,0:48:33.81,Default,,0,0,0,,十年一遇哦
Dialogue: 0,0:48:33.81,0:48:35.81,Default,,0,0,0,,每逢六星连珠
Dialogue: 0,0:48:35.81,0:48:40.02,Default,,0,0,0,,这白玉台便可万里传音送影
Dialogue: 0,0:48:40.02,0:48:42.23,Default,,0,0,0,,众师弟天南地北
Dialogue: 0,0:48:42.23,0:48:44.23,Default,,0,0,0,,难得一聚
Dialogue: 0,0:48:44.23,0:48:47.44,Default,,0,0,0,,今日正好借六星连珠之机
Dialogue: 0,0:48:47.44,0:48:49.98,Default,,0,0,0,,开一次金仙大会
Dialogue: 0,0:48:50.81,0:48:52.60,Default,,0,0,0,,我尚未晋升十二金仙
Dialogue: 0,0:48:52.60,0:48:53.89,Default,,0,0,0,,还是回避的好
Dialogue: 0,0:48:54.44,0:48:56.44,Default,,0,0,0,,早晚的事
Dialogue: 0,0:48:56.44,0:48:57.52,Default,,0,0,0,,不得行 不得行
Dialogue: 0,0:48:57.52,0:48:58.65,Default,,0,0,0,,这怎么要得嘛
Dialogue: 0,0:48:58.65,0:49:00.15,Default,,0,0,0,,使不得 使不得
Dialogue: 0,0:49:01.27,0:49:02.60,Default,,0,0,0,,那你咋坐上去了
Dialogue: 0,0:49:02.60,0:49:03.27,Default,,0,0,0,,闭嘴
Dialogue: 0,0:49:03.27,0:49:04.81,Default,,0,0,0,,见不得你师父好嗦
Dialogue: 0,0:49:14.40,0:49:15.73,Default,,0,0,0,,桑拿呀
Dialogue: 0,0:49:15.90,0:49:17.07,Default,,0,0,0,,嘘
Dialogue: 0,0:49:23.90,0:49:26.73,Default,,0,0,0,,恭迎各位师弟归位
Dialogue: 0,0:49:26.73,0:49:29.15,Default,,0,0,0,,参见大师兄
Dialogue: 0,0:49:29.15,0:49:32.07,Default,,0,0,0,,给大家引荐一位新成员
Dialogue: 0,0:49:32.06,0:49:33.90,Default,,0,0,0,,太乙师弟
Dialogue: 0,0:49:33.90,0:49:36.44,Default,,0,0,0,,他不负师尊所托
Dialogue: 0,0:49:36.44,0:49:38.19,Default,,0,0,0,,已将灵珠转世
Dialogue: 0,0:49:38.19,0:49:39.86,Default,,0,0,0,,培育成才
Dialogue: 0,0:49:41.85,0:49:43.81,Default,,0,0,0,,行礼
Dialogue: 0,0:49:45.77,0:49:49.02,Default,,0,0,0,,封神大战迫在眉睫
Dialogue: 0,0:49:49.02,0:49:53.77,Default,,0,0,0,,此次会议须得商讨备战事宜
Dialogue: 0,0:49:53.77,0:49:56.15,Default,,0,0,0,,阐教乃道统正宗
Dialogue: 0,0:49:56.15,0:49:57.82,Default,,0,0,0,,此战必胜
Dialogue: 0,0:49:57.81,0:49:59.98,Default,,0,0,0,,但近年来截教崛起迅猛
Dialogue: 0,0:49:59.98,0:50:01.19,Default,,0,0,0,,不得不防
Dialogue: 0,0:50:02.40,0:50:03.36,Default,,0,0,0,,截教
Dialogue: 0,0:50:03.35,0:50:05.60,Default,,0,0,0,,尽是披毛带角之人
Dialogue: 0,0:50:05.60,0:50:07.43,Default,,0,0,0,,湿生卵化之辈
Dialogue: 0,0:50:07.44,0:50:09.40,Default,,0,0,0,,此战关乎本门兴亡
Dialogue: 0,0:50:09.40,0:50:11.15,Default,,0,0,0,,不得掉以轻心
Dialogue: 0,0:50:11.15,0:50:13.03,Default,,0,0,0,,增强本教实力
Dialogue: 0,0:50:13.02,0:50:14.31,Default,,0,0,0,,方是根本
Dialogue: 0,0:50:14.31,0:50:16.06,Default,,0,0,0,,正是如此
Dialogue: 0,0:50:16.06,0:50:20.35,Default,,0,0,0,,为此老夫早早便开始了准备
Dialogue: 0,0:50:20.35,0:50:21.52,Default,,0,0,0,,仙丹
Dialogue: 0,0:50:21.52,0:50:23.35,Default,,0,0,0,,共有九千枚
Dialogue: 0,0:50:23.35,0:50:27.23,Default,,0,0,0,,可按级别高低分发给众门人
Dialogue: 0,0:50:27.23,0:50:29.98,Default,,0,0,0,,本教实力势必大大提升啊
Dialogue: 0,0:50:29.98,0:50:31.15,Default,,0,0,0,,怎么有这么多
Dialogue: 0,0:50:31.15,0:50:32.32,Default,,0,0,0,,近百年来
Dialogue: 0,0:50:32.31,0:50:35.06,Default,,0,0,0,,恩师一直以天元鼎加紧炼丹
Dialogue: 0,0:50:35.06,0:50:36.60,Default,,0,0,0,,日夜不息
Dialogue: 0,0:50:36.60,0:50:38.52,Default,,0,0,0,,连自己的修炼都落下了
Dialogue: 0,0:50:38.52,0:50:42.31,Default,,0,0,0,,大师兄为阐教兴衰殚精竭虑
Dialogue: 0,0:50:42.31,0:50:44.39,Default,,0,0,0,,劳苦功高
Dialogue: 0,0:50:44.56,0:50:46.94,Default,,0,0,0,,劳苦功高
Dialogue: 0,0:50:47.02,0:50:48.56,Default,,0,0,0,,除了截教
Dialogue: 0,0:50:48.56,0:50:50.89,Default,,0,0,0,,可还有无其他妖邪图谋不轨
Dialogue: 0,0:50:50.90,0:50:51.98,Default,,0,0,0,,禀师叔
Dialogue: 0,0:50:51.98,0:50:53.69,Default,,0,0,0,,一旦发现厉害妖孽
Dialogue: 0,0:50:53.69,0:50:55.32,Default,,0,0,0,,捕妖队便前往收服
Dialogue: 0,0:50:55.31,0:50:58.10,Default,,0,0,0,,所以一般散妖都不成气候
Dialogue: 0,0:50:58.10,0:50:58.85,Default,,0,0,0,,但
Dialogue: 0,0:50:58.85,0:51:00.27,Default,,0,0,0,,还有支妖族除外
Dialogue: 0,0:51:00.48,0:51:01.40,Default,,0,0,0,,哦
Dialogue: 0,0:51:01.40,0:51:02.32,Default,,0,0,0,,哪支妖族
Dialogue: 0,0:51:02.85,0:51:04.31,Default,,0,0,0,,东海龙族
Dialogue: 0,0:51:04.65,0:51:07.32,Default,,0,0,0,,龙族
Dialogue: 0,0:51:07.31,0:51:10.19,Default,,0,0,0,,龙族不是早已归降天庭了吗
Dialogue: 0,0:51:10.60,0:51:12.60,Default,,0,0,0,,非我族类其心必异
Dialogue: 0,0:51:12.60,0:51:13.73,Default,,0,0,0,,在我看来
Dialogue: 0,0:51:13.73,0:51:16.23,Default,,0,0,0,,它们的归降只是虚与委蛇
Dialogue: 0,0:51:16.23,0:51:17.27,Default,,0,0,0,,等待时机
Dialogue: 0,0:51:17.27,0:51:20.10,Default,,0,0,0,,龙族千年来镇压海底妖兽有功
Dialogue: 0,0:51:20.48,0:51:22.15,Default,,0,0,0,,何罪之有呢
Dialogue: 0,0:51:22.15,0:51:24.03,Default,,0,0,0,,但它们实力太强
Dialogue: 0,0:51:24.02,0:51:25.73,Default,,0,0,0,,若封神之战时倒戈
Dialogue: 0,0:51:25.73,0:51:28.06,Default,,0,0,0,,恐会影响整个战局
Dialogue: 0,0:51:30.02,0:51:31.40,Default,,0,0,0,,还是不可
Dialogue: 0,0:51:31.40,0:51:34.73,Default,,0,0,0,,本教名门正派之名深入人心
Dialogue: 0,0:51:34.73,0:51:36.23,Default,,0,0,0,,若师出无名
Dialogue: 0,0:51:36.23,0:51:38.02,Default,,0,0,0,,无故讨伐降将
Dialogue: 0,0:51:38.02,0:51:41.23,Default,,0,0,0,,将来还靠什么取信天下
Dialogue: 0,0:51:41.23,0:51:42.86,Default,,0,0,0,,嗯 言之有理
Dialogue: 0,0:51:42.85,0:51:44.43,Default,,0,0,0,,不可轻举妄动
Dialogue: 0,0:51:44.44,0:51:47.48,Default,,0,0,0,,此事还需从长计议
Dialogue: 0,0:51:47.48,0:51:48.06,Default,,0,0,0,,但是
Dialogue: 0,0:51:48.06,0:51:49.35,Default,,0,0,0,,行了
Dialogue: 0,0:51:49.35,0:51:51.06,Default,,0,0,0,,大家所言在理
Dialogue: 0,0:51:51.06,0:51:53.02,Default,,0,0,0,,你也不必执拗了
Dialogue: 0,0:51:53.02,0:51:54.19,Default,,0,0,0,,是
Dialogue: 0,0:51:54.19,0:51:56.65,Default,,0,0,0,,六星连珠时辰将尽
Dialogue: 0,0:51:56.65,0:51:59.82,Default,,0,0,0,,目下也无其他议题
Dialogue: 0,0:51:59.81,0:52:02.10,Default,,0,0,0,,那就散会吧
Dialogue: 0,0:52:02.10,0:52:03.23,Default,,0,0,0,,师兄
Dialogue: 0,0:52:03.23,0:52:04.19,Default,,0,0,0,,金吒 木吒
Dialogue: 0,0:52:04.19,0:52:07.11,Default,,0,0,0,,分别拜于我和普贤师弟门下
Dialogue: 0,0:52:07.10,0:52:10.18,Default,,0,0,0,,修行多年未曾归乡
Dialogue: 0,0:52:10.19,0:52:11.77,Default,,0,0,0,,连哪吒这个三弟
Dialogue: 0,0:52:11.77,0:52:13.27,Default,,0,0,0,,也素未谋面
Dialogue: 0,0:52:13.27,0:52:16.15,Default,,0,0,0,,六星连珠尚有片刻余暇
Dialogue: 0,0:52:16.15,0:52:17.61,Default,,0,0,0,,不如借此机会
Dialogue: 0,0:52:17.60,0:52:19.85,Default,,0,0,0,,让他们兄弟三人一聚
Dialogue: 0,0:52:21.15,0:52:22.61,Default,,0,0,0,,甚好 甚好
Dialogue: 0,0:52:29.15,0:52:30.40,Default,,0,0,0,,怎么办
Dialogue: 0,0:52:30.40,0:52:32.57,Default,,0,0,0,,咋整 咋整
Dialogue: 0,0:52:32.56,0:52:34.23,Default,,0,0,0,,你怎么了
Dialogue: 0,0:52:34.65,0:52:35.94,Default,,0,0,0,,你说就我这形象
Dialogue: 0,0:52:35.94,0:52:37.52,Default,,0,0,0,,会不会给人第一印象
Dialogue: 0,0:52:37.52,0:52:39.27,Default,,0,0,0,,不太好啊
Dialogue: 0,0:52:39.27,0:52:40.27,Default,,0,0,0,,肯定不会呀
Dialogue: 0,0:52:40.27,0:52:40.98,Default,,0,0,0,,真的
Dialogue: 0,0:52:40.98,0:52:42.11,Default,,0,0,0,,虽然你仪态懒散
Dialogue: 0,0:52:42.10,0:52:43.10,Default,,0,0,0,,但意志坚定
Dialogue: 0,0:52:43.10,0:52:43.93,Default,,0,0,0,,虽然你个头矮小
Dialogue: 0,0:52:43.94,0:52:45.15,Default,,0,0,0,,但内心强大
Dialogue: 0,0:52:45.15,0:52:46.19,Default,,0,0,0,,虽然你相貌丑陋
Dialogue: 0,0:52:46.19,0:52:47.27,Default,,0,0,0,,但心地善良啊
Dialogue: 0,0:52:47.27,0:52:48.23,Default,,0,0,0,,虽然你眼眶发黑
Dialogue: 0,0:52:48.23,0:52:48.86,Default,,0,0,0,,鼻孔朝天
Dialogue: 0,0:52:48.85,0:52:49.68,Default,,0,0,0,,牙还缺了一颗
Dialogue: 0,0:52:49.69,0:52:50.36,Default,,0,0,0,,但我觉得
Dialogue: 0,0:52:50.35,0:52:52.35,Default,,0,0,0,,你就是很好很好啊
Dialogue: 0,0:52:53.44,0:52:55.57,Default,,0,0,0,,你兄长一定也会这么想的
Dialogue: 0,0:52:56.81,0:52:58.52,Default,,0,0,0,,谢谢你的夸奖
Dialogue: 0,0:52:59.98,0:53:00.44,Default,,0,0,0,,你干嘛
Dialogue: 0,0:53:00.65,0:53:01.86,Default,,0,0,0,,你替我去见哥哥
Dialogue: 0,0:53:01.85,0:53:03.27,Default,,0,0,0,,这 这怎么行
Dialogue: 0,0:53:03.27,0:53:04.35,Default,,0,0,0,,这种事怎么能替啊
Dialogue: 0,0:53:04.35,0:53:05.39,Default,,0,0,0,,不行啊哪吒
Dialogue: 0,0:53:05.40,0:53:06.40,Default,,0,0,0,,哪吒
Dialogue: 0,0:53:12.77,0:53:14.27,Default,,0,0,0,,这娃儿还害羞了
Dialogue: 0,0:53:19.98,0:53:20.86,Default,,0,0,0,,哪吒
Dialogue: 0,0:53:21.35,0:53:22.31,Default,,0,0,0,,三弟
Dialogue: 0,0:53:48.60,0:53:49.93,Default,,0,0,0,,敖丙
Dialogue: 0,0:53:49.94,0:53:51.52,Default,,0,0,0,,你哭了
Dialogue: 0,0:53:52.81,0:53:55.02,Default,,0,0,0,,我刚才想起了我两个哥哥
Dialogue: 0,0:53:55.02,0:53:56.35,Default,,0,0,0,,你也有哥哥
Dialogue: 0,0:53:56.85,0:53:57.60,Default,,0,0,0,,嗯
Dialogue: 0,0:53:57.98,0:53:59.06,Default,,0,0,0,,以前
Dialogue: 0,0:54:00.31,0:54:02.27,Default,,0,0,0,,有两个这么好的哥哥
Dialogue: 0,0:54:02.27,0:54:02.98,Default,,0,0,0,,真幸福
Dialogue: 0,0:54:04.48,0:54:06.86,Default,,0,0,0,,刚刚你们聊了些啥呀
Dialogue: 0,0:54:07.56,0:54:09.02,Default,,0,0,0,,他们说
Dialogue: 0,0:54:09.02,0:54:11.15,Default,,0,0,0,,很抱歉一直没机会回去看看你
Dialogue: 0,0:54:12.06,0:54:12.98,Default,,0,0,0,,他们问
Dialogue: 0,0:54:14.06,0:54:15.69,Default,,0,0,0,,这些年家里怎么样了
Dialogue: 0,0:54:15.69,0:54:16.86,Default,,0,0,0,,父母是否安康
Dialogue: 0,0:54:16.85,0:54:17.89,Default,,0,0,0,,你有什么爱好
Dialogue: 0,0:54:17.90,0:54:19.73,Default,,0,0,0,,有哪些朋友
Dialogue: 0,0:54:19.73,0:54:21.19,Default,,0,0,0,,他们还说
Dialogue: 0,0:54:21.19,0:54:22.90,Default,,0,0,0,,今后无论遇到什么困难
Dialogue: 0,0:54:22.90,0:54:24.48,Default,,0,0,0,,都要告诉他们
Dialogue: 0,0:54:24.48,0:54:26.15,Default,,0,0,0,,让你记得有两个哥哥
Dialogue: 0,0:54:26.85,0:54:29.02,Default,,0,0,0,,永远永远都会帮助你保护你
Dialogue: 0,0:54:30.65,0:54:31.28,Default,,0,0,0,,你怎么也
Dialogue: 0,0:54:31.27,0:54:32.10,Default,,0,0,0,,没有
Dialogue: 0,0:54:32.10,0:54:33.73,Default,,0,0,0,,眼睛里进沙子了
Dialogue: 0,0:54:35.06,0:54:36.81,Default,,0,0,0,,这次不是沙子里进眼睛了
Dialogue: 0,0:54:36.81,0:54:37.35,Default,,0,0,0,,讨厌
Dialogue: 0,0:54:37.35,0:54:38.06,Default,,0,0,0,,都说不是了
Dialogue: 0,0:54:39.02,0:54:40.06,Default,,0,0,0,,你说不是就不是
Dialogue: 0,0:54:44.77,0:54:45.48,Default,,0,0,0,,不理你了
Dialogue: 0,0:54:47.02,0:54:47.90,Default,,0,0,0,,好好好
Dialogue: 0,0:54:47.90,0:54:49.28,Default,,0,0,0,,我不笑了 不笑了
Dialogue: 0,0:54:51.94,0:54:53.19,Default,,0,0,0,,你还在生气吗
Dialogue: 0,0:54:53.19,0:54:53.82,Default,,0,0,0,,哪吒
Dialogue: 0,0:54:54.10,0:54:54.98,Default,,0,0,0,,哪吒
Dialogue: 0,0:54:55.69,0:54:56.73,Default,,0,0,0,,敖丙
Dialogue: 0,0:54:57.98,0:54:59.40,Default,,0,0,0,,我从小就暴戾放纵
Dialogue: 0,0:55:00.23,0:55:02.81,Default,,0,0,0,,爹娘为我操碎了心
Dialogue: 0,0:55:03.31,0:55:04.48,Default,,0,0,0,,你爹
Dialogue: 0,0:55:04.48,0:55:06.36,Default,,0,0,0,,虽围困了陈塘关
Dialogue: 0,0:55:06.35,0:55:08.89,Default,,0,0,0,,但我知道他也是为了你
Dialogue: 0,0:55:08.90,0:55:10.11,Default,,0,0,0,,才不顾一切
Dialogue: 0,0:55:11.06,0:55:12.48,Default,,0,0,0,,今天
Dialogue: 0,0:55:12.48,0:55:15.02,Default,,0,0,0,,哥哥们也对我这么好
Dialogue: 0,0:55:15.94,0:55:18.15,Default,,0,0,0,,家人为我们付出了太多
Dialogue: 0,0:55:18.48,0:55:19.56,Default,,0,0,0,,你是妖
Dialogue: 0,0:55:19.56,0:55:20.89,Default,,0,0,0,,我是魔
Dialogue: 0,0:55:20.90,0:55:22.86,Default,,0,0,0,,是我们拖累了他们
Dialogue: 0,0:55:26.02,0:55:27.65,Default,,0,0,0,,天生妖魔又怎样
Dialogue: 0,0:55:27.65,0:55:30.19,Default,,0,0,0,,是魔是仙今后就得我自己来选
Dialogue: 0,0:55:30.56,0:55:31.35,Default,,0,0,0,,等救了你
Dialogue: 0,0:55:31.35,0:55:32.98,Default,,0,0,0,,我们一定要得道成仙
Dialogue: 0,0:55:32.98,0:55:34.36,Default,,0,0,0,,不再让家人操心
Dialogue: 0,0:55:34.35,0:55:35.18,Default,,0,0,0,,对
Dialogue: 0,0:55:35.19,0:55:36.15,Default,,0,0,0,,成了仙
Dialogue: 0,0:55:36.15,0:55:37.65,Default,,0,0,0,,才能堂堂正正地活下去
Dialogue: 0,0:55:37.65,0:55:38.61,Default,,0,0,0,,说定了
Dialogue: 0,0:55:39.06,0:55:42.02,Default,,0,0,0,,小爷就要当神仙
Dialogue: 0,0:55:47.98,0:55:51.81,Default,,0,0,0,,勇猛精进方能一日千里
Dialogue: 0,0:55:51.81,0:55:53.44,Default,,0,0,0,,照你们这样
Dialogue: 0,0:55:53.44,0:55:56.32,Default,,0,0,0,,再修百年也是枉然
Dialogue: 0,0:55:56.60,0:55:58.27,Default,,0,0,0,,修仙修仙
Dialogue: 0,0:55:58.27,0:56:00.81,Default,,0,0,0,,首先修的就是精气神
Dialogue: 0,0:56:00.81,0:56:01.94,Default,,0,0,0,,觉得苦
Dialogue: 0,0:56:01.94,0:56:02.98,Default,,0,0,0,,觉得累
Dialogue: 0,0:56:02.98,0:56:07.23,Default,,0,0,0,,要恨就恨你们为什么生来就是妖
Dialogue: 0,0:56:07.23,0:56:08.73,Default,,0,0,0,,拼尽全力
Dialogue: 0,0:56:08.73,0:56:10.98,Default,,0,0,0,,才有机会逆天改命
Dialogue: 0,0:56:10.98,0:56:12.65,Default,,0,0,0,,得道成仙
Dialogue: 0,0:56:14.44,0:56:17.44,Default,,0,0,0,,从来生死都看淡
Dialogue: 0,0:56:17.44,0:56:20.44,Default,,0,0,0,,专和老天对着干
Dialogue: 0,0:56:20.44,0:56:23.44,Default,,0,0,0,,我命由我不由天
Dialogue: 0,0:56:23.44,0:56:27.02,Default,,0,0,0,,小爷非要当神仙
Dialogue: 0,0:56:28.52,0:56:30.10,Default,,0,0,0,,好
Dialogue: 0,0:56:31.06,0:56:33.48,Default,,0,0,0,,短短几句便振聋发聩
Dialogue: 0,0:56:33.48,0:56:34.98,Default,,0,0,0,,鼓舞人心
Dialogue: 0,0:56:34.98,0:56:36.98,Default,,0,0,0,,好诗 好诗
Dialogue: 0,0:56:36.98,0:56:40.40,Default,,0,0,0,,这首诗的精神值得你们所有人学习
Dialogue: 0,0:56:42.06,0:56:42.81,Default,,0,0,0,,是吗
Dialogue: 0,0:56:42.81,0:56:43.98,Default,,0,0,0,,有这么好吗
Dialogue: 0,0:56:44.35,0:56:45.48,Default,,0,0,0,,嘿嘿 我自己瞎编的
Dialogue: 0,0:56:45.48,0:56:46.65,Default,,0,0,0,,非也非也
Dialogue: 0,0:56:46.65,0:56:47.57,Default,,0,0,0,,字字珠玑
Dialogue: 0,0:56:47.56,0:56:48.69,Default,,0,0,0,,催人上进
Dialogue: 0,0:56:48.69,0:56:50.44,Default,,0,0,0,,能作出这样的诗
Dialogue: 0,0:56:50.44,0:56:52.98,Default,,0,0,0,,可见你小小年纪就志存高远
Dialogue: 0,0:56:52.98,0:56:54.44,Default,,0,0,0,,真是少年英雄
Dialogue: 0,0:56:54.44,0:56:55.73,Default,,0,0,0,,前途无量啊
Dialogue: 0,0:56:55.90,0:56:57.48,Default,,0,0,0,,哎呦喂 没那么好啦
Dialogue: 0,0:56:57.48,0:56:59.15,Default,,0,0,0,,其实还是有些小缺陷的啦
Dialogue: 0,0:56:59.15,0:57:00.57,Default,,0,0,0,,你缺陷大了去了
Dialogue: 0,0:57:00.56,0:57:01.02,Default,,0,0,0,,我问你
Dialogue: 0,0:57:01.02,0:57:01.81,Default,,0,0,0,,你那黑眼圈怎么回事儿
Dialogue: 0,0:57:02.81,0:57:05.02,Default,,0,0,0,,一看便知你时常熬夜
Dialogue: 0,0:57:05.02,0:57:06.15,Default,,0,0,0,,生活没规律
Dialogue: 0,0:57:06.15,0:57:07.23,Default,,0,0,0,,饮食不健康
Dialogue: 0,0:57:07.23,0:57:09.11,Default,,0,0,0,,连起码的自律都做不到
Dialogue: 0,0:57:09.10,0:57:11.14,Default,,0,0,0,,你也配修仙
Dialogue: 0,0:57:11.15,0:57:12.53,Default,,0,0,0,,我黑眼圈天生的
Dialogue: 0,0:57:12.52,0:57:14.15,Default,,0,0,0,,相由心生懂不懂
Dialogue: 0,0:57:14.15,0:57:15.44,Default,,0,0,0,,自己拿镜子照照
Dialogue: 0,0:57:15.44,0:57:16.23,Default,,0,0,0,,怪模怪样
Dialogue: 0,0:57:16.23,0:57:16.98,Default,,0,0,0,,吊儿郎当
Dialogue: 0,0:57:16.98,0:57:17.94,Default,,0,0,0,,你要是我的徒弟
Dialogue: 0,0:57:17.94,0:57:19.86,Default,,0,0,0,,肯定教你重修人形
Dialogue: 0,0:57:19.85,0:57:20.93,Default,,0,0,0,,可以重修
Dialogue: 0,0:57:21.27,0:57:22.60,Default,,0,0,0,,那这相貌还有救啰
Dialogue: 0,0:57:23.02,0:57:23.98,Default,,0,0,0,,你教教我呗
Dialogue: 0,0:57:23.98,0:57:25.77,Default,,0,0,0,,早知道你是来拜师的
Dialogue: 0,0:57:25.77,0:57:26.69,Default,,0,0,0,,这样 小鬼
Dialogue: 0,0:57:26.69,0:57:28.52,Default,,0,0,0,,我看你也是志向远大
Dialogue: 0,0:57:28.52,0:57:30.10,Default,,0,0,0,,就收了你这个徒弟
Dialogue: 0,0:57:30.10,0:57:30.52,Default,,0,0,0,,好啊
Dialogue: 0,0:57:30.69,0:57:32.27,Default,,0,0,0,,师父
Dialogue: 0,0:57:34.10,0:57:34.64,Default,,0,0,0,,来
Dialogue: 0,0:57:34.65,0:57:35.90,Default,,0,0,0,,跟师兄们一起练
Dialogue: 0,0:57:35.90,0:57:36.57,Default,,0,0,0,,练啥
Dialogue: 0,0:57:36.56,0:57:37.39,Default,,0,0,0,,修仙呐
Dialogue: 0,0:57:37.40,0:57:38.61,Default,,0,0,0,,修仙不用你教
Dialogue: 0,0:57:38.60,0:57:39.48,Default,,0,0,0,,你教我美颜
Dialogue: 0,0:57:39.48,0:57:40.40,Default,,0,0,0,,混账
Dialogue: 0,0:57:40.40,0:57:42.36,Default,,0,0,0,,修仙不学 你学美颜
Dialogue: 0,0:57:42.35,0:57:43.64,Default,,0,0,0,,舍本逐末
Dialogue: 0,0:57:43.65,0:57:45.15,Default,,0,0,0,,你到底教不教啊
Dialogue: 0,0:57:45.15,0:57:47.28,Default,,0,0,0,,从此我们断绝师徒关系
Dialogue: 0,0:57:47.27,0:57:49.23,Default,,0,0,0,,活该你当一辈子熊猫眼
Dialogue: 0,0:57:49.23,0:57:50.23,Default,,0,0,0,,过分了啊
Dialogue: 0,0:57:50.23,0:57:51.98,Default,,0,0,0,,本来我还准备下手轻点儿呢
Dialogue: 0,0:57:51.98,0:57:52.44,Default,,0,0,0,,干啥
Dialogue: 0,0:57:52.44,0:57:53.52,Default,,0,0,0,,踢馆啊
Dialogue: 0,0:57:53.52,0:57:54.48,Default,,0,0,0,,三颗该够了
Dialogue: 0,0:57:54.48,0:57:55.19,Default,,0,0,0,,小鬼
Dialogue: 0,0:57:55.60,0:57:57.35,Default,,0,0,0,,你打哪儿来回哪儿去
Dialogue: 0,0:57:57.35,0:57:59.43,Default,,0,0,0,,再干扰我们正常教学
Dialogue: 0,0:57:59.44,0:58:01.48,Default,,0,0,0,,我可要动粗啦
Dialogue: 0,0:58:02.60,0:58:03.18,Default,,0,0,0,,得罪
Dialogue: 0,0:58:42.90,0:58:44.48,Default,,0,0,0,,你不是我对手
Dialogue: 0,0:58:45.77,0:58:47.94,Default,,0,0,0,,好小子
Dialogue: 0,0:58:47.94,0:58:49.73,Default,,0,0,0,,老夫小看你了
Dialogue: 0,0:59:03.98,0:59:04.65,Default,,0,0,0,,着
Dialogue: 0,0:59:08.44,0:59:10.44,Default,,0,0,0,,好 教训这无知小儿
Dialogue: 0,0:59:10.44,0:59:11.69,Default,,0,0,0,,师父必胜
Dialogue: 0,0:59:11.69,0:59:13.11,Default,,0,0,0,,好快的身法
Dialogue: 0,0:59:13.10,0:59:14.10,Default,,0,0,0,,你看清楚没得
Dialogue: 0,0:59:16.35,0:59:18.31,Default,,0,0,0,,我们并无深仇大恨
Dialogue: 0,0:59:18.31,0:59:20.10,Default,,0,0,0,,你还是回去吧
Dialogue: 0,0:59:20.10,0:59:20.81,Default,,0,0,0,,我不能败
Dialogue: 0,0:59:32.31,0:59:34.15,Default,,0,0,0,,你碰都碰不到我
Dialogue: 0,0:59:34.15,0:59:35.32,Default,,0,0,0,,怎么跟我斗
Dialogue: 0,0:59:48.65,0:59:49.32,Default,,0,0,0,,聪明
Dialogue: 0,0:59:49.31,0:59:50.02,Default,,0,0,0,,逮到不放
Dialogue: 0,0:59:50.02,0:59:51.19,Default,,0,0,0,,他速度再快也没用
Dialogue: 0,0:59:52.48,0:59:53.56,Default,,0,0,0,,还不降
Dialogue: 0,1:00:06.06,1:00:07.52,Default,,0,0,0,,原来你是
Dialogue: 0,1:00:08.44,1:00:09.36,Default,,0,0,0,,发现啦
Dialogue: 0,1:00:09.65,1:00:11.40,Default,,0,0,0,,我并非动作快
Dialogue: 0,1:00:11.40,1:00:13.15,Default,,0,0,0,,而是身体能化作电流
Dialogue: 0,1:00:13.15,1:00:15.36,Default,,0,0,0,,瞬间传导到任何位置
Dialogue: 0,1:00:15.35,1:00:16.56,Default,,0,0,0,,在水里
Dialogue: 0,1:00:16.56,1:00:19.02,Default,,0,0,0,,我是无敌的
Dialogue: 0,1:00:33.73,1:00:35.48,Default,,0,0,0,,好厉害的寒气
Dialogue: 0,1:00:38.69,1:00:39.94,Default,,0,0,0,,稳到点儿啊
Dialogue: 0,1:00:39.94,1:00:42.07,Default,,0,0,0,,力使猛了肉身要崩啊
Dialogue: 0,1:00:42.06,1:00:43.27,Default,,0,0,0,,冰不导电
Dialogue: 0,1:00:43.27,1:00:45.02,Default,,0,0,0,,看你还有什么能耐
Dialogue: 0,1:00:46.35,1:00:47.14,Default,,0,0,0,,五湖四海
Dialogue: 0,1:00:47.15,1:00:47.94,Default,,0,0,0,,云漫苍穹
Dialogue: 0,1:00:47.94,1:00:48.69,Default,,0,0,0,,神符命汝
Dialogue: 0,1:00:48.69,1:00:49.57,Default,,0,0,0,,降雨行风
Dialogue: 0,1:00:49.56,1:00:51.56,Default,,0,0,0,,急急如律令
Dialogue: 0,1:01:02.60,1:01:03.43,Default,,0,0,0,,爹
Dialogue: 0,1:01:11.10,1:01:11.93,Default,,0,0,0,,糟了
Dialogue: 0,1:01:11.94,1:01:13.02,Default,,0,0,0,,布雨咒
Dialogue: 0,1:01:13.02,1:01:13.98,Default,,0,0,0,,速战速决
Dialogue: 0,1:01:27.90,1:01:28.53,Default,,0,0,0,,迟了
Dialogue: 0,1:01:44.44,1:01:45.98,Default,,0,0,0,,你完了
Dialogue: 0,1:02:05.27,1:02:07.60,Default,,0,0,0,,师父 师父
Dialogue: 0,1:02:07.60,1:02:09.10,Default,,0,0,0,,师父你怎么了
Dialogue: 0,1:02:09.10,1:02:10.43,Default,,0,0,0,,我并非取你性命
Dialogue: 0,1:02:10.44,1:02:11.94,Default,,0,0,0,,你又何苦自断一臂
Dialogue: 0,1:02:11.94,1:02:13.48,Default,,0,0,0,,众弟子听令
Dialogue: 0,1:02:13.48,1:02:15.65,Default,,0,0,0,,将妖孽押解回宫
Dialogue: 0,1:02:15.65,1:02:17.23,Default,,0,0,0,,诺
Dialogue: 0,1:02:18.40,1:02:19.11,Default,,0,0,0,,住手
Dialogue: 0,1:02:19.10,1:02:19.93,Default,,0,0,0,,放下
Dialogue: 0,1:02:19.94,1:02:21.32,Default,,0,0,0,,都给我放下
Dialogue: 0,1:02:21.31,1:02:24.56,Default,,0,0,0,,敢问阁下是否阐教门人
Dialogue: 0,1:02:24.56,1:02:25.39,Default,,0,0,0,,正是
Dialogue: 0,1:02:25.40,1:02:26.69,Default,,0,0,0,,哦
Dialogue: 0,1:02:32.90,1:02:34.61,Default,,0,0,0,,这都是玉虚宫的仙长
Dialogue: 0,1:02:34.60,1:02:36.60,Default,,0,0,0,,尔等不得无礼
Dialogue: 0,1:02:36.60,1:02:37.93,Default,,0,0,0,,我等进了玉虚宫
Dialogue: 0,1:02:37.94,1:02:40.15,Default,,0,0,0,,就能接受正道教化
Dialogue: 0,1:02:40.15,1:02:42.07,Default,,0,0,0,,未尝不是好事
Dialogue: 0,1:02:42.06,1:02:44.60,Default,,0,0,0,,尔等都把兵刃给我扔了
Dialogue: 0,1:02:53.23,1:02:54.19,Default,,0,0,0,,爹
Dialogue: 0,1:02:54.44,1:02:55.36,Default,,0,0,0,,小豹
Dialogue: 0,1:02:55.35,1:02:56.43,Default,,0,0,0,,你怎么回来啦
Dialogue: 0,1:03:02.44,1:03:03.40,Default,,0,0,0,,小豹
Dialogue: 0,1:03:03.40,1:03:04.57,Default,,0,0,0,,不得无礼
Dialogue: 0,1:03:12.52,1:03:13.60,Default,,0,0,0,,小豹
Dialogue: 0,1:03:19.44,1:03:20.65,Default,,0,0,0,,放肆
Dialogue: 0,1:03:20.65,1:03:22.44,Default,,0,0,0,,胆敢伤我门人
Dialogue: 0,1:03:23.15,1:03:24.78,Default,,0,0,0,,不要
Dialogue: 0,1:03:39.44,1:03:40.57,Default,,0,0,0,,爹
Dialogue: 0,1:03:44.40,1:03:44.98,Default,,0,0,0,,哪吒
Dialogue: 0,1:03:44.98,1:03:46.31,Default,,0,0,0,,快封冻河水
Dialogue: 0,1:03:59.23,1:04:00.90,Default,,0,0,0,,哪里逃
Dialogue: 0,1:04:20.69,1:04:21.73,Default,,0,0,0,,爹
Dialogue: 0,1:04:21.73,1:04:23.11,Default,,0,0,0,,走
Dialogue: 0,1:04:23.10,1:04:24.98,Default,,0,0,0,,快走
Dialogue: 0,1:04:24.98,1:04:26.98,Default,,0,0,0,,逃啊
Dialogue: 0,1:04:26.98,1:04:28.77,Default,,0,0,0,,爹
Dialogue: 0,1:04:35.40,1:04:36.98,Default,,0,0,0,,逃不掉的
Dialogue: 0,1:04:39.10,1:04:40.10,Default,,0,0,0,,让开
Dialogue: 0,1:04:40.10,1:04:41.52,Default,,0,0,0,,他只是救父心切
Dialogue: 0,1:04:41.52,1:04:42.90,Default,,0,0,0,,何苦下此重手
Dialogue: 0,1:04:47.35,1:04:48.06,Default,,0,0,0,,哼
Dialogue: 0,1:04:52.85,1:04:54.27,Default,,0,0,0,,三七
Dialogue: 0,1:04:54.94,1:04:56.27,Default,,0,0,0,,蒲黄
Dialogue: 0,1:04:56.73,1:04:58.11,Default,,0,0,0,,茜草
Dialogue: 0,1:04:58.69,1:04:59.73,Default,,0,0,0,,冰片
Dialogue: 0,1:05:00.19,1:05:01.32,Default,,0,0,0,,血竭
Dialogue: 0,1:05:01.31,1:05:02.10,Default,,0,0,0,,再来一筐
Dialogue: 0,1:05:02.10,1:05:03.02,Default,,0,0,0,,红花
Dialogue: 0,1:05:03.56,1:05:04.69,Default,,0,0,0,,当归
Dialogue: 0,1:05:05.23,1:05:06.77,Default,,0,0,0,,田七粉
Dialogue: 0,1:05:07.06,1:05:08.06,Default,,0,0,0,,苏木
Dialogue: 0,1:05:08.52,1:05:10.10,Default,,0,0,0,,马钱子
Dialogue: 0,1:05:10.40,1:05:11.07,Default,,0,0,0,,大人
Dialogue: 0,1:05:11.27,1:05:13.56,Default,,0,0,0,,清单上的全齐了
Dialogue: 0,1:05:13.56,1:05:16.19,Default,,0,0,0,,另外还多了一百筐鱼虾水产
Dialogue: 0,1:05:16.19,1:05:18.57,Default,,0,0,0,,城里正好缺粮草啊
Dialogue: 0,1:05:21.27,1:05:22.44,Default,,0,0,0,,申道长留步
Dialogue: 0,1:05:23.77,1:05:25.06,Default,,0,0,0,,我们备了些酒菜
Dialogue: 0,1:05:25.60,1:05:27.56,Default,,0,0,0,,道长可否赏脸一聚
Dialogue: 0,1:05:33.10,1:05:34.23,Default,,0,0,0,,你
Dialogue: 0,1:05:34.90,1:05:36.53,Default,,0,0,0,,承蒙李大人开恩
Dialogue: 0,1:05:36.52,1:05:38.94,Default,,0,0,0,,收留我当了个差役
Dialogue: 0,1:05:39.19,1:05:40.40,Default,,0,0,0,,他虽是妖
Dialogue: 0,1:05:40.40,1:05:41.90,Default,,0,0,0,,但心地不坏
Dialogue: 0,1:05:41.90,1:05:43.61,Default,,0,0,0,,只要安分守己
Dialogue: 0,1:05:43.60,1:05:45.35,Default,,0,0,0,,未尝没有个好的归宿
Dialogue: 0,1:05:46.81,1:05:48.23,Default,,0,0,0,,不知合不合道长口味
Dialogue: 0,1:05:48.56,1:05:49.31,Default,,0,0,0,,不
Dialogue: 0,1:05:50.27,1:05:50.94,Default,,0,0,0,,不错
Dialogue: 0,1:05:51.48,1:05:52.61,Default,,0,0,0,,那您多吃些
Dialogue: 0,1:05:52.60,1:05:54.02,Default,,0,0,0,,这酒您也尝尝
Dialogue: 0,1:05:54.35,1:05:55.52,Default,,0,0,0,,早戒了
Dialogue: 0,1:05:55.52,1:05:59.27,Default,,0,0,0,,修仙者需克...克制欲念
Dialogue: 0,1:05:59.27,1:06:00.56,Default,,0,0,0,,有言道
Dialogue: 0,1:06:00.56,1:06:02.77,Default,,0,0,0,,剪情欲则神全
Dialogue: 0,1:06:02.77,1:06:04.19,Default,,0,0,0,,亦有言道
Dialogue: 0,1:06:04.19,1:06:06.94,Default,,0,0,0,,行善道则德全
Dialogue: 0,1:06:08.15,1:06:09.53,Default,,0,0,0,,多说无用
Dialogue: 0,1:06:09.52,1:06:12.44,Default,,0,0,0,,我早已无...无路可退
Dialogue: 0,1:06:12.44,1:06:15.07,Default,,0,0,0,,隐瞒逃避不是长久之计
Dialogue: 0,1:06:15.06,1:06:17.31,Default,,0,0,0,,终有事情败露的一天
Dialogue: 0,1:06:18.15,1:06:19.53,Default,,0,0,0,,若残害生灵
Dialogue: 0,1:06:19.52,1:06:20.94,Default,,0,0,0,,错上加错
Dialogue: 0,1:06:20.94,1:06:22.65,Default,,0,0,0,,就算瞒天过海
Dialogue: 0,1:06:22.65,1:06:24.73,Default,,0,0,0,,也心障难除
Dialogue: 0,1:06:24.94,1:06:28.52,Default,,0,0,0,,往后的修行更难有寸进
Dialogue: 0,1:06:28.52,1:06:29.85,Default,,0,0,0,,修仙的根本
Dialogue: 0,1:06:29.85,1:06:31.23,Default,,0,0,0,,乃是积善德
Dialogue: 0,1:06:31.23,1:06:32.06,Default,,0,0,0,,行正道
Dialogue: 0,1:06:32.06,1:06:32.65,Default,,0,0,0,,住口
Dialogue: 0,1:06:32.65,1:06:34.19,Default,,0,0,0,,什么行善积德
Dialogue: 0,1:06:34.19,1:06:35.19,Default,,0,0,0,,你对修仙
Dialogue: 0,1:06:35.19,1:06:36.77,Default,,0,0,0,,一无所知
Dialogue: 0,1:06:45.02,1:06:46.15,Default,,0,0,0,,报
Dialogue: 0,1:06:46.73,1:06:48.40,Default,,0,0,0,,有人求见申道长
Dialogue: 0,1:06:57.10,1:06:58.39,Default,,0,0,0,,哥
Dialogue: 0,1:06:59.10,1:07:00.39,Default,,0,0,0,,怎么伤成这样
Dialogue: 0,1:07:00.40,1:07:02.28,Default,,0,0,0,,一帮道士
Dialogue: 0,1:07:02.27,1:07:05.35,Default,,0,0,0,,围 围攻咱家
Dialogue: 0,1:07:06.60,1:07:07.77,Default,,0,0,0,,爹
Dialogue: 0,1:07:08.27,1:07:10.10,Default,,0,0,0,,还被人砍断了
Dialogue: 0,1:07:11.10,1:07:12.85,Default,,0,0,0,,手臂
Dialogue: 0,1:07:12.85,1:07:14.14,Default,,0,0,0,,谁砍的
Dialogue: 0,1:07:14.52,1:07:17.77,Default,,0,0,0,,那 那人叫
Dialogue: 0,1:07:18.40,1:07:19.98,Default,,0,0,0,,哪
Dialogue: 0,1:07:19.98,1:07:22.73,Default,,0,0,0,,吒
Dialogue: 0,1:07:38.27,1:07:40.44,Default,,0,0,0,,恭喜师弟过了第二关
Dialogue: 0,1:07:40.73,1:07:42.40,Default,,0,0,0,,还请通禀无量师兄
Dialogue: 0,1:07:42.40,1:07:44.73,Default,,0,0,0,,师父今日闭关炼丹
Dialogue: 0,1:07:44.73,1:07:46.23,Default,,0,0,0,,尚未出关
Dialogue: 0,1:07:46.23,1:07:47.90,Default,,0,0,0,,第三次考核前
Dialogue: 0,1:07:47.90,1:07:49.90,Default,,0,0,0,,师弟不如先休养几日
Dialogue: 0,1:07:49.90,1:07:51.73,Default,,0,0,0,,我们只剩两天了
Dialogue: 0,1:07:51.73,1:07:52.77,Default,,0,0,0,,不用
Dialogue: 0,1:07:52.77,1:07:53.98,Default,,0,0,0,,我精神得很
Dialogue: 0,1:07:53.98,1:07:55.02,Default,,0,0,0,,接着考
Dialogue: 0,1:07:55.02,1:07:55.98,Default,,0,0,0,,那
Dialogue: 0,1:07:55.98,1:07:57.27,Default,,0,0,0,,也好
Dialogue: 0,1:07:57.27,1:07:58.48,Default,,0,0,0,,最后一只妖王
Dialogue: 0,1:07:58.48,1:08:00.65,Default,,0,0,0,,是骷髅山的
Dialogue: 0,1:08:00.65,1:08:02.36,Default,,0,0,0,,石矶
Dialogue: 0,1:08:04.52,1:08:06.40,Default,,0,0,0,,殿外有人急事求见太乙仙长
Dialogue: 0,1:08:06.40,1:08:07.15,Default,,0,0,0,,啊
Dialogue: 0,1:08:07.15,1:08:08.78,Default,,0,0,0,,不好啦
Dialogue: 0,1:08:08.77,1:08:10.56,Default,,0,0,0,,陈 塘关
Dialogue: 0,1:08:10.56,1:08:12.52,Default,,0,0,0,,出事儿啦
Dialogue: 0,1:08:35.73,1:08:36.31,Default,,0,0,0,,爹
Dialogue: 0,1:08:38.40,1:08:39.28,Default,,0,0,0,,娘
Dialogue: 0,1:08:42.35,1:08:42.89,Default,,0,0,0,,爹
Dialogue: 0,1:08:45.10,1:08:45.64,Default,,0,0,0,,娘
Dialogue: 0,1:08:48.73,1:08:49.65,Default,,0,0,0,,爹
Dialogue: 0,1:08:50.77,1:08:52.15,Default,,0,0,0,,娘
Dialogue: 0,1:09:01.44,1:09:03.23,Default,,0,0,0,,爹
Dialogue: 0,1:09:04.15,1:09:06.57,Default,,0,0,0,,娘
Dialogue: 0,1:09:27.81,1:09:29.19,Default,,0,0,0,,不要急 不要急
Dialogue: 0,1:09:29.19,1:09:29.90,Default,,0,0,0,,我们再找找
Dialogue: 0,1:09:29.90,1:09:30.82,Default,,0,0,0,,再找找
Dialogue: 0,1:09:33.69,1:09:36.40,Default,,0,0,0,,我刚出关便收到急报
Dialogue: 0,1:09:36.40,1:09:39.40,Default,,0,0,0,,到底是何人犯下如此滔天罪行
Dialogue: 0,1:09:39.40,1:09:40.40,Default,,0,0,0,,启禀师父
Dialogue: 0,1:09:40.40,1:09:41.73,Default,,0,0,0,,据结界兽所说
Dialogue: 0,1:09:41.73,1:09:43.81,Default,,0,0,0,,事前他们遭受巨大力量冲击
Dialogue: 0,1:09:43.81,1:09:45.14,Default,,0,0,0,,失去知觉
Dialogue: 0,1:09:45.15,1:09:46.19,Default,,0,0,0,,醒来时发现
Dialogue: 0,1:09:46.19,1:09:48.19,Default,,0,0,0,,陈塘关已被屠城
Dialogue: 0,1:09:48.73,1:09:50.31,Default,,0,0,0,,还没得到玉液琼浆啊
Dialogue: 0,1:09:50.31,1:09:52.48,Default,,0,0,0,,他们怎么会动手喃
Dialogue: 0,1:09:52.48,1:09:53.15,Default,,0,0,0,,师弟
Dialogue: 0,1:09:53.69,1:09:54.94,Default,,0,0,0,,你可有头绪
Dialogue: 0,1:09:54.94,1:09:56.02,Default,,0,0,0,,没得 没得
Dialogue: 0,1:09:56.02,1:09:56.81,Default,,0,0,0,,我是在想
Dialogue: 0,1:09:56.81,1:09:59.10,Default,,0,0,0,,这些岩浆是从哪儿来的
Dialogue: 0,1:09:59.77,1:10:00.90,Default,,0,0,0,,是啊
Dialogue: 0,1:10:00.90,1:10:03.07,Default,,0,0,0,,方圆千里杳无火山
Dialogue: 0,1:10:03.06,1:10:05.06,Default,,0,0,0,,当真匪夷所思
Dialogue: 0,1:10:06.06,1:10:06.85,Default,,0,0,0,,大家快来
Dialogue: 0,1:10:09.19,1:10:11.02,Default,,0,0,0,,是何妖物
Dialogue: 0,1:10:11.48,1:10:13.06,Default,,0,0,0,,这是
Dialogue: 0,1:10:14.31,1:10:15.35,Default,,0,0,0,,龙族爪印
Dialogue: 0,1:10:16.56,1:10:17.60,Default,,0,0,0,,不可能
Dialogue: 0,1:10:18.19,1:10:21.11,Default,,0,0,0,,全体龙族都在东海龙宫
Dialogue: 0,1:10:21.10,1:10:23.10,Default,,0,0,0,,镇守锁妖阵
Dialogue: 0,1:10:23.10,1:10:25.73,Default,,0,0,0,,一条都不可能离得开
Dialogue: 0,1:10:25.73,1:10:26.48,Default,,0,0,0,,师父
Dialogue: 0,1:10:26.48,1:10:27.98,Default,,0,0,0,,弟子没记错的话
Dialogue: 0,1:10:27.98,1:10:30.11,Default,,0,0,0,,关押在海底的西海龙王敖闰
Dialogue: 0,1:10:30.10,1:10:31.85,Default,,0,0,0,,是否有种特殊技能
Dialogue: 0,1:10:31.85,1:10:32.89,Default,,0,0,0,,叫做裂
Dialogue: 0,1:10:33.73,1:10:35.06,Default,,0,0,0,,裂空爪
Dialogue: 0,1:10:35.06,1:10:37.10,Default,,0,0,0,,你是说她用裂空爪
Dialogue: 0,1:10:37.10,1:10:38.60,Default,,0,0,0,,穿越到了陈塘关
Dialogue: 0,1:10:38.60,1:10:40.39,Default,,0,0,0,,这些岩浆便就说得通了
Dialogue: 0,1:10:40.40,1:10:43.32,Default,,0,0,0,,必是从海底炼狱隔空传送而来
Dialogue: 0,1:10:43.31,1:10:45.10,Default,,0,0,0,,但她被东海龙王镇压在狱中
Dialogue: 0,1:10:45.10,1:10:47.06,Default,,0,0,0,,不可能穿越至此啊
Dialogue: 0,1:10:47.06,1:10:49.39,Default,,0,0,0,,那就只剩一种可能啦
Dialogue: 0,1:10:49.98,1:10:52.31,Default,,0,0,0,,弟子最担心的事
Dialogue: 0,1:10:52.31,1:10:54.19,Default,,0,0,0,,还是发生了
Dialogue: 0,1:10:54.19,1:10:56.36,Default,,0,0,0,,东海龙王叛变
Dialogue: 0,1:10:57.15,1:10:59.15,Default,,0,0,0,,此事牵连重大
Dialogue: 0,1:10:59.15,1:11:01.65,Default,,0,0,0,,会不会是我们猜错了
Dialogue: 0,1:11:02.06,1:11:03.77,Default,,0,0,0,,不会错
Dialogue: 0,1:11:03.77,1:11:05.65,Default,,0,0,0,,就是他们
Dialogue: 0,1:11:08.35,1:11:09.48,Default,,0,0,0,,你要干什么
Dialogue: 0,1:11:17.56,1:11:18.23,Default,,0,0,0,,莫冲动
Dialogue: 0,1:11:18.98,1:11:20.65,Default,,0,0,0,,你是要去龙宫吗
Dialogue: 0,1:11:20.65,1:11:21.86,Default,,0,0,0,,那是骷髅山的方向
Dialogue: 0,1:11:23.31,1:11:26.39,Default,,0,0,0,,龙族屠戮无辜百姓
Dialogue: 0,1:11:26.40,1:11:29.11,Default,,0,0,0,,犯下这滔天恶行
Dialogue: 0,1:11:29.10,1:11:31.85,Default,,0,0,0,,无需再通过金仙大会
Dialogue: 0,1:11:31.85,1:11:33.98,Default,,0,0,0,,老夫要先斩后奏
Dialogue: 0,1:11:33.98,1:11:35.15,Default,,0,0,0,,鹤童
Dialogue: 0,1:11:35.15,1:11:36.19,Default,,0,0,0,,随我回宫
Dialogue: 0,1:11:36.19,1:11:39.11,Default,,0,0,0,,召集捕妖队全体成员
Dialogue: 0,1:11:39.10,1:11:39.89,Default,,0,0,0,,诺
Dialogue: 0,1:11:39.90,1:11:41.32,Default,,0,0,0,,师弟
Dialogue: 0,1:11:41.31,1:11:43.56,Default,,0,0,0,,哪吒父母为妖族所害
Dialogue: 0,1:11:43.56,1:11:46.81,Default,,0,0,0,,不能再让这孩子有个三长两短
Dialogue: 0,1:11:46.81,1:11:48.98,Default,,0,0,0,,你与鹿童赶紧去接应他
Dialogue: 0,1:11:48.98,1:11:50.56,Default,,0,0,0,,诺
Dialogue: 0,1:11:54.10,1:11:55.77,Default,,0,0,0,,我知道你现在很难过
Dialogue: 0,1:11:56.02,1:11:57.10,Default,,0,0,0,,你可不可以先
Dialogue: 0,1:11:57.27,1:11:58.06,Default,,0,0,0,,先冷静一下
Dialogue: 0,1:12:01.56,1:12:02.10,Default,,0,0,0,,你
Dialogue: 0,1:12:02.44,1:12:03.61,Default,,0,0,0,,能不能先带我回龙宫
Dialogue: 0,1:12:04.31,1:12:05.56,Default,,0,0,0,,我会向父王和师父
Dialogue: 0,1:12:05.90,1:12:06.48,Default,,0,0,0,,问个明白
Dialogue: 0,1:12:07.02,1:12:09.73,Default,,0,0,0,,问明白就能救活我爹娘吗
Dialogue: 0,1:12:22.65,1:12:24.78,Default,,0,0,0,,铜镜铜镜告诉我
Dialogue: 0,1:12:24.77,1:12:27.65,Default,,0,0,0,,谁是方圆十里最美的女人
Dialogue: 0,1:12:27.65,1:12:28.53,Default,,0,0,0,,是你
Dialogue: 0,1:12:28.52,1:12:29.27,Default,,0,0,0,,我的主人
Dialogue: 0,1:12:30.52,1:12:33.15,Default,,0,0,0,,那谁是方圆百里最美的女人
Dialogue: 0,1:12:33.15,1:12:34.69,Default,,0,0,0,,是你 我的主人
Dialogue: 0,1:12:34.69,1:12:35.77,Default,,0,0,0,,那方圆千里呢
Dialogue: 0,1:12:35.77,1:12:36.65,Default,,0,0,0,,是你
Dialogue: 0,1:12:36.65,1:12:37.48,Default,,0,0,0,,万里呢
Dialogue: 0,1:12:37.48,1:12:37.94,Default,,0,0,0,,是你
Dialogue: 0,1:12:37.94,1:12:38.52,Default,,0,0,0,,全天下呢
Dialogue: 0,1:12:38.52,1:12:40.40,Default,,0,0,0,,还是你
Dialogue: 0,1:12:40.94,1:12:42.02,Default,,0,0,0,,你敷衍谁呢
Dialogue: 0,1:12:42.02,1:12:42.90,Default,,0,0,0,,靠点谱行不
Dialogue: 0,1:12:42.90,1:12:44.07,Default,,0,0,0,,没没
Dialogue: 0,1:12:44.06,1:12:46.44,Default,,0,0,0,,这 这不怕您生气吗
Dialogue: 0,1:12:46.44,1:12:47.94,Default,,0,0,0,,我告诉你
Dialogue: 0,1:12:47.94,1:12:49.94,Default,,0,0,0,,你说真话我反而不生气
Dialogue: 0,1:12:49.94,1:12:51.61,Default,,0,0,0,,真 不生气
Dialogue: 0,1:12:51.60,1:12:54.85,Default,,0,0,0,,虽然石矶娘娘我貌美如花
Dialogue: 0,1:12:54.85,1:12:56.98,Default,,0,0,0,,但山外有山的道理我岂能不懂
Dialogue: 0,1:12:57.52,1:12:58.31,Default,,0,0,0,,那你问吧
Dialogue: 0,1:12:58.31,1:12:59.81,Default,,0,0,0,,我是不是全天下最美的女人
Dialogue: 0,1:12:59.81,1:13:00.23,Default,,0,0,0,,不是
Dialogue: 0,1:13:01.27,1:13:02.77,Default,,0,0,0,,这才真实嘛
Dialogue: 0,1:13:02.77,1:13:05.52,Default,,0,0,0,,我是不是方圆万里最美的女人
Dialogue: 0,1:13:05.52,1:13:05.98,Default,,0,0,0,,不是
Dialogue: 0,1:13:05.98,1:13:07.44,Default,,0,0,0,,方圆千里呢
Dialogue: 0,1:13:07.44,1:13:07.86,Default,,0,0,0,,不是
Dialogue: 0,1:13:07.85,1:13:08.56,Default,,0,0,0,,百里呢
Dialogue: 0,1:13:08.56,1:13:09.19,Default,,0,0,0,,不是
Dialogue: 0,1:13:09.19,1:13:10.32,Default,,0,0,0,,十里
Dialogue: 0,1:13:10.31,1:13:11.06,Default,,0,0,0,,不是
Dialogue: 0,1:13:11.06,1:13:14.44,Default,,0,0,0,,那我是不是这座山里最美的女人
Dialogue: 0,1:13:14.44,1:13:16.19,Default,,0,0,0,,不是啊
Dialogue: 0,1:13:16.19,1:13:16.90,Default,,0,0,0,,你骗鬼啊
Dialogue: 0,1:13:16.90,1:13:19.11,Default,,0,0,0,,这座山里除了我 根本没其他人
Dialogue: 0,1:13:19.10,1:13:20.52,Default,,0,0,0,,我也是女的
Dialogue: 0,1:13:22.02,1:13:23.73,Default,,0,0,0,,你说过不生气的哦
Dialogue: 0,1:13:25.44,1:13:26.73,Default,,0,0,0,,你哪点比我漂亮
Dialogue: 0,1:13:26.73,1:13:27.48,Default,,0,0,0,,救命啊
Dialogue: 0,1:13:27.48,1:13:29.36,Default,,0,0,0,,哪点比我漂亮
Dialogue: 0,1:13:32.35,1:13:34.85,Default,,0,0,0,,石妖何在
Dialogue: 0,1:13:34.85,1:13:36.27,Default,,0,0,0,,什么石妖不石妖的
Dialogue: 0,1:13:36.27,1:13:37.44,Default,,0,0,0,,叫我石矶娘娘
Dialogue: 0,1:13:50.10,1:13:50.93,Default,,0,0,0,,臭小子
Dialogue: 0,1:13:50.94,1:13:51.94,Default,,0,0,0,,我们见过吗
Dialogue: 0,1:13:51.94,1:13:53.48,Default,,0,0,0,,你跟老娘我拼什么命
Dialogue: 0,1:13:55.65,1:13:56.69,Default,,0,0,0,,你会暴露的
Dialogue: 0,1:13:56.69,1:13:57.61,Default,,0,0,0,,让我来吧
Dialogue: 0,1:13:57.60,1:13:58.56,Default,,0,0,0,,你少管
Dialogue: 0,1:14:22.31,1:14:25.73,Default,,0,0,0,,石矶娘娘我是那么容易被打败的吗
Dialogue: 0,1:14:47.23,1:14:51.81,Default,,0,0,0,,这整座山都是老娘我的身体
Dialogue: 0,1:14:51.81,1:14:54.27,Default,,0,0,0,,看你怎么灭得了我
Dialogue: 0,1:15:03.94,1:15:04.94,Default,,0,0,0,,再使力
Dialogue: 0,1:15:04.94,1:15:06.61,Default,,0,0,0,,你肉身会崩的
Dialogue: 0,1:15:06.60,1:15:08.10,Default,,0,0,0,,我说
Dialogue: 0,1:15:08.10,1:15:12.18,Default,,0,0,0,,不要你管
Dialogue: 0,1:15:21.52,1:15:22.77,Default,,0,0,0,,已经交手了
Dialogue: 0,1:15:23.69,1:15:24.44,Default,,0,0,0,,糟了糟了
Dialogue: 0,1:15:32.56,1:15:34.31,Default,,0,0,0,,要了命了
Dialogue: 0,1:15:36.06,1:15:37.48,Default,,0,0,0,,还好剩一点点
Dialogue: 0,1:15:37.48,1:15:39.86,Default,,0,0,0,,留得青山在不怕没柴烧
Dialogue: 0,1:15:39.85,1:15:40.77,Default,,0,0,0,,臭小子
Dialogue: 0,1:15:40.77,1:15:42.27,Default,,0,0,0,,给老娘我记着
Dialogue: 0,1:15:44.10,1:15:45.60,Default,,0,0,0,,九龙神火罩
Dialogue: 0,1:15:54.85,1:15:56.35,Default,,0,0,0,,跑不脱
Dialogue: 0,1:15:58.23,1:15:59.02,Default,,0,0,0,,嗨呀
Dialogue: 0,1:15:59.02,1:16:00.52,Default,,0,0,0,,怎么那么冲动嘛
Dialogue: 0,1:16:01.48,1:16:02.94,Default,,0,0,0,,肉身都差点崩了
Dialogue: 0,1:16:02.94,1:16:04.44,Default,,0,0,0,,你不要命了呀
Dialogue: 0,1:16:04.77,1:16:06.69,Default,,0,0,0,,刚才的火焰是怎么回事
Dialogue: 0,1:16:06.69,1:16:08.02,Default,,0,0,0,,师弟
Dialogue: 0,1:16:08.02,1:16:09.65,Default,,0,0,0,,不是冰系的吗
Dialogue: 0,1:16:09.65,1:16:11.28,Default,,0,0,0,,哪 哪个说他是冰系的
Dialogue: 0,1:16:11.27,1:16:12.60,Default,,0,0,0,,冰啊火啊我都教过
Dialogue: 0,1:16:12.60,1:16:13.81,Default,,0,0,0,,他练的是
Dialogue: 0,1:16:13.81,1:16:14.94,Default,,0,0,0,,冰火两重天
Dialogue: 0,1:16:14.94,1:16:16.77,Default,,0,0,0,,这也行
Dialogue: 0,1:16:16.77,1:16:17.65,Default,,0,0,0,,灵珠天赋异禀
Dialogue: 0,1:16:17.65,1:16:18.73,Default,,0,0,0,,岂能用常理判断
Dialogue: 0,1:16:19.23,1:16:20.65,Default,,0,0,0,,你是师叔还是我是师叔
Dialogue: 0,1:16:20.65,1:16:21.69,Default,,0,0,0,,你懂还是我懂
Dialogue: 0,1:16:21.69,1:16:22.69,Default,,0,0,0,,弟子不敢
Dialogue: 0,1:16:22.69,1:16:24.11,Default,,0,0,0,,但
Dialogue: 0,1:16:24.10,1:16:26.10,Default,,0,0,0,,先前弟子似乎还感受到
Dialogue: 0,1:16:26.10,1:16:28.27,Default,,0,0,0,,一股强大的魔气
Dialogue: 0,1:16:28.27,1:16:29.69,Default,,0,0,0,,那个嘛
Dialogue: 0,1:16:29.69,1:16:31.19,Default,,0,0,0,,当然是这个石矶放出来的
Dialogue: 0,1:16:31.19,1:16:32.82,Default,,0,0,0,,胖子你说什么
Dialogue: 0,1:16:32.81,1:16:33.89,Default,,0,0,0,,老娘我明明
Dialogue: 0,1:16:33.90,1:16:35.61,Default,,0,0,0,,是不是你 是不是你 是不是你
Dialogue: 0,1:16:35.60,1:16:36.18,Default,,0,0,0,,快说
Dialogue: 0,1:16:36.19,1:16:37.61,Default,,0,0,0,,是我放的 是我放的
Dialogue: 0,1:16:37.60,1:16:38.56,Default,,0,0,0,,别摇啦
Dialogue: 0,1:16:38.56,1:16:39.81,Default,,0,0,0,,要吐啦
Dialogue: 0,1:16:41.06,1:16:42.10,Default,,0,0,0,,你看 我说噻
Dialogue: 0,1:16:46.23,1:16:47.02,Default,,0,0,0,,哪吒
Dialogue: 0,1:16:47.02,1:16:48.81,Default,,0,0,0,,你连过三关
Dialogue: 0,1:16:49.15,1:16:49.82,Default,,0,0,0,,今日
Dialogue: 0,1:16:49.81,1:16:52.44,Default,,0,0,0,,老夫要亲自为你吟诵
Dialogue: 0,1:16:52.44,1:16:53.94,Default,,0,0,0,,升仙咒
Dialogue: 0,1:17:02.35,1:17:04.39,Default,,0,0,0,,遥想当年我也经历过这些
Dialogue: 0,1:17:04.40,1:17:06.07,Default,,0,0,0,,那时候可能太紧张了
Dialogue: 0,1:17:06.06,1:17:08.14,Default,,0,0,0,,咋没觉得升仙咒那么长呢
Dialogue: 0,1:17:18.27,1:17:20.35,Default,,0,0,0,,从今往后
Dialogue: 0,1:17:20.35,1:17:23.64,Default,,0,0,0,,你便也是阐教仙人了
Dialogue: 0,1:17:44.98,1:17:48.19,Default,,0,0,0,,这玉虚宝库中珍藏的
Dialogue: 0,1:17:48.19,1:17:50.36,Default,,0,0,0,,样样都是稀世法宝
Dialogue: 0,1:17:50.35,1:17:51.43,Default,,0,0,0,,玉液琼浆
Dialogue: 0,1:17:52.90,1:17:54.48,Default,,0,0,0,,只能选一样
Dialogue: 0,1:17:54.48,1:17:55.94,Default,,0,0,0,,你不多考虑考虑
Dialogue: 0,1:17:55.94,1:17:57.40,Default,,0,0,0,,玉液琼浆
Dialogue: 0,1:18:59.15,1:19:01.44,Default,,0,0,0,,玉虚宫已派出信使
Dialogue: 0,1:19:01.44,1:19:05.02,Default,,0,0,0,,向十二金仙通报龙族罪状
Dialogue: 0,1:19:05.02,1:19:06.69,Default,,0,0,0,,但山高路远
Dialogue: 0,1:19:06.69,1:19:10.19,Default,,0,0,0,,仓促间众师弟难以赶来
Dialogue: 0,1:19:10.19,1:19:11.15,Default,,0,0,0,,此次
Dialogue: 0,1:19:11.15,1:19:13.48,Default,,0,0,0,,老夫要亲率捕妖队
Dialogue: 0,1:19:13.48,1:19:15.90,Default,,0,0,0,,讨伐龙族
Dialogue: 0,1:19:15.90,1:19:17.07,Default,,0,0,0,,哪吒
Dialogue: 0,1:19:17.06,1:19:19.98,Default,,0,0,0,,你愿与老夫一同出征否
Dialogue: 0,1:19:19.98,1:19:22.56,Default,,0,0,0,,我先回陈塘关一趟
Dialogue: 0,1:19:22.56,1:19:25.31,Default,,0,0,0,,之后就去找龙王算账
Dialogue: 0,1:19:25.31,1:19:26.60,Default,,0,0,0,,好
Dialogue: 0,1:19:26.60,1:19:28.56,Default,,0,0,0,,你战力非凡
Dialogue: 0,1:19:28.56,1:19:32.89,Default,,0,0,0,,定可助老夫荡平龙宫
Dialogue: 0,1:19:50.90,1:19:52.03,Default,,0,0,0,,欠你的
Dialogue: 0,1:19:53.77,1:19:54.90,Default,,0,0,0,,都还清了
Dialogue: 0,1:19:55.98,1:19:57.11,Default,,0,0,0,,你等等
Dialogue: 0,1:19:57.10,1:19:58.43,Default,,0,0,0,,等我肉身恢复
Dialogue: 0,1:19:58.44,1:19:59.52,Default,,0,0,0,,我们一起去龙宫好不好
Dialogue: 0,1:19:59.52,1:20:01.44,Default,,0,0,0,,你知道我会做什么
Dialogue: 0,1:20:02.65,1:20:05.23,Default,,0,0,0,,你去了只会更难受
Dialogue: 0,1:20:07.15,1:20:09.69,Default,,0,0,0,,下次见面
Dialogue: 0,1:20:10.23,1:20:12.52,Default,,0,0,0,,是敌非友
Dialogue: 0,1:20:14.27,1:20:14.98,Default,,0,0,0,,哎
Dialogue: 0,1:20:14.98,1:20:16.15,Default,,0,0,0,,冤孽啊
Dialogue: 0,1:20:20.44,1:20:21.57,Default,,0,0,0,,你走不得 走不得
Dialogue: 0,1:20:22.31,1:20:24.31,Default,,0,0,0,,还没到龙宫你魂儿都散了
Dialogue: 0,1:20:29.15,1:20:30.90,Default,,0,0,0,,九龙神火罩
Dialogue: 0,1:20:38.31,1:20:39.81,Default,,0,0,0,,你冷静下好不好嘛
Dialogue: 0,1:20:39.81,1:20:40.56,Default,,0,0,0,,你现在去了
Dialogue: 0,1:20:40.56,1:20:42.39,Default,,0,0,0,,也改变不了任何事情啊
Dialogue: 0,1:20:43.15,1:20:44.36,Default,,0,0,0,,你别管我
Dialogue: 0,1:20:44.35,1:20:45.48,Default,,0,0,0,,放我出去
Dialogue: 0,1:20:45.48,1:20:46.06,Default,,0,0,0,,不行
Dialogue: 0,1:20:46.06,1:20:47.10,Default,,0,0,0,,我答应过哪吒
Dialogue: 0,1:20:47.10,1:20:48.81,Default,,0,0,0,,一定要把你救活
Dialogue: 0,1:20:59.27,1:21:01.60,Default,,0,0,0,,呸 呸 呸
Dialogue: 0,1:21:01.60,1:21:03.64,Default,,0,0,0,,憋死我了
Dialogue: 0,1:21:56.48,1:21:58.52,Default,,0,0,0,,何方神圣
Dialogue: 0,1:21:58.52,1:22:01.52,Default,,0,0,0,,老夫乃阐教无量仙翁
Dialogue: 0,1:22:01.52,1:22:02.60,Default,,0,0,0,,敖光
Dialogue: 0,1:22:02.60,1:22:03.93,Default,,0,0,0,,你可知罪
Dialogue: 0,1:22:05.81,1:22:07.06,Default,,0,0,0,,你们
Dialogue: 0,1:22:07.06,1:22:08.69,Default,,0,0,0,,都知道了
Dialogue: 0,1:22:08.69,1:22:09.57,Default,,0,0,0,,那
Dialogue: 0,1:22:09.56,1:22:11.35,Default,,0,0,0,,敖丙还活着吗
Dialogue: 0,1:22:11.35,1:22:12.73,Default,,0,0,0,,我任由你们处置
Dialogue: 0,1:22:12.73,1:22:14.69,Default,,0,0,0,,能否放我儿一条生路
Dialogue: 0,1:22:14.69,1:22:16.27,Default,,0,0,0,,不知所谓
Dialogue: 0,1:22:16.27,1:22:19.90,Default,,0,0,0,,天庭令你龙族镇压海底妖兽
Dialogue: 0,1:22:19.90,1:22:21.73,Default,,0,0,0,,你们却勾结妖兽
Dialogue: 0,1:22:21.73,1:22:24.15,Default,,0,0,0,,屠戮陈塘关
Dialogue: 0,1:22:24.15,1:22:25.40,Default,,0,0,0,,陈塘关
Dialogue: 0,1:22:25.40,1:22:28.28,Default,,0,0,0,,龙族犯下滔天罪行
Dialogue: 0,1:22:28.27,1:22:28.94,Default,,0,0,0,,今日
Dialogue: 0,1:22:28.94,1:22:31.82,Default,,0,0,0,,老夫要替天行道
Dialogue: 0,1:22:48.90,1:22:50.57,Default,,0,0,0,,包罗天地
Dialogue: 0,1:22:50.56,1:22:52.23,Default,,0,0,0,,无量神通
Dialogue: 0,1:22:52.23,1:22:54.06,Default,,0,0,0,,天元现世
Dialogue: 0,1:22:54.06,1:22:56.56,Default,,0,0,0,,傲视群雄
Dialogue: 0,1:22:56.56,1:22:57.98,Default,,0,0,0,,开
Dialogue: 0,1:23:28.15,1:23:29.94,Default,,0,0,0,,给我出来
Dialogue: 0,1:23:33.10,1:23:36.18,Default,,0,0,0,,你们对陈塘关干了什么
Dialogue: 0,1:23:36.19,1:23:37.69,Default,,0,0,0,,大哥不是叫我等
Dialogue: 0,1:23:37.69,1:23:39.94,Default,,0,0,0,,听申道长的吩咐吗
Dialogue: 0,1:23:40.31,1:23:42.39,Default,,0,0,0,,申公豹
Dialogue: 0,1:23:52.06,1:23:54.14,Default,,0,0,0,,火烧眉毛
Dialogue: 0,1:23:54.15,1:23:56.90,Default,,0,0,0,,大哥还是先顾眼前吧
Dialogue: 0,1:23:58.98,1:23:59.81,Default,,0,0,0,,大王
Dialogue: 0,1:23:59.81,1:24:00.77,Default,,0,0,0,,不能坐以待毙啊
Dialogue: 0,1:24:00.77,1:24:02.27,Default,,0,0,0,,我若出战
Dialogue: 0,1:24:02.27,1:24:03.65,Default,,0,0,0,,这锁妖阵
Dialogue: 0,1:24:03.65,1:24:04.61,Default,,0,0,0,,锁妖阵交给我们吧
Dialogue: 0,1:24:04.60,1:24:05.56,Default,,0,0,0,,拼尽全力
Dialogue: 0,1:24:05.56,1:24:07.52,Default,,0,0,0,,我们一炷香还是撑得了的
Dialogue: 0,1:24:08.23,1:24:09.61,Default,,0,0,0,,好
Dialogue: 0,1:24:23.98,1:24:26.31,Default,,0,0,0,,欺人太甚
Dialogue: 0,1:24:36.23,1:24:37.27,Default,,0,0,0,,妖孽大胆
Dialogue: 0,1:24:48.19,1:24:52.23,Default,,0,0,0,,我们报仇雪恨的千载良机到了
Dialogue: 0,1:24:52.23,1:24:54.52,Default,,0,0,0,,杀出炼狱
Dialogue: 0,1:24:54.52,1:24:56.48,Default,,0,0,0,,荡平龙宫
Dialogue: 0,1:26:29.06,1:26:30.73,Default,,0,0,0,,人刀合一
Dialogue: 0,1:26:51.19,1:26:51.98,Default,,0,0,0,,老鬼
Dialogue: 0,1:26:51.98,1:26:52.81,Default,,0,0,0,,看刀
Dialogue: 0,1:27:08.27,1:27:09.85,Default,,0,0,0,,这样释放魔气
Dialogue: 0,1:27:09.85,1:27:11.98,Default,,0,0,0,,你小子不怕暴露身份吗
Dialogue: 0,1:27:12.15,1:27:14.11,Default,,0,0,0,,我说过
Dialogue: 0,1:27:14.10,1:27:16.81,Default,,0,0,0,,你要是敢动陈塘关
Dialogue: 0,1:27:16.81,1:27:20.60,Default,,0,0,0,,我就把龙宫砸个稀巴烂
Dialogue: 0,1:27:25.02,1:27:25.85,Default,,0,0,0,,说
Dialogue: 0,1:27:25.85,1:27:27.68,Default,,0,0,0,,敖丙是不是死了
Dialogue: 0,1:28:32.60,1:28:34.77,Default,,0,0,0,,闪开 都闪开
Dialogue: 0,1:29:10.31,1:29:11.39,Default,,0,0,0,,起
Dialogue: 0,1:30:21.94,1:30:23.94,Default,,0,0,0,,你不想活了
Dialogue: 0,1:30:23.94,1:30:27.23,Default,,0,0,0,,看你肉身撑得了多久
Dialogue: 0,1:30:27.23,1:30:29.11,Default,,0,0,0,,我活不活无所谓
Dialogue: 0,1:30:29.10,1:30:31.39,Default,,0,0,0,,我只要你死
Dialogue: 0,1:30:49.44,1:30:51.27,Default,,0,0,0,,机不可失
Dialogue: 0,1:31:09.56,1:31:11.64,Default,,0,0,0,,看你们干的蠢事
Dialogue: 0,1:31:11.65,1:31:15.11,Default,,0,0,0,,难道同归于尽就是你们想要的结果
Dialogue: 0,1:31:17.73,1:31:19.06,Default,,0,0,0,,锁链
Dialogue: 0,1:31:25.69,1:31:28.98,Default,,0,0,0,,东海龙王竟也不是你对手
Dialogue: 0,1:31:28.98,1:31:31.44,Default,,0,0,0,,老夫果然没有看错
Dialogue: 0,1:31:31.44,1:31:35.40,Default,,0,0,0,,阐教就需要你这样的栋梁之才
Dialogue: 0,1:31:35.40,1:31:38.57,Default,,0,0,0,,你父母一生嫉恶如仇
Dialogue: 0,1:31:38.56,1:31:39.56,Default,,0,0,0,,今后
Dialogue: 0,1:31:39.56,1:31:42.56,Default,,0,0,0,,你也要继承他们的遗志
Dialogue: 0,1:31:42.56,1:31:46.19,Default,,0,0,0,,斩尽天下妖孽
Dialogue: 0,1:31:46.77,1:31:49.40,Default,,0,0,0,,老夫这就替你主持公道
Dialogue: 0,1:31:49.85,1:31:51.73,Default,,0,0,0,,炼了这帮畜生
Dialogue: 0,1:31:52.15,1:31:53.53,Default,,0,0,0,,替我护法
Dialogue: 0,1:31:53.52,1:31:54.40,Default,,0,0,0,,诺
Dialogue: 0,1:32:41.81,1:32:42.69,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:43.19,1:32:43.77,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:44.40,1:32:45.23,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:45.48,1:32:46.19,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:46.98,1:32:48.11,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:48.35,1:32:49.02,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:49.56,1:32:50.31,Default,,0,0,0,,爹
Dialogue: 0,1:32:50.52,1:32:51.52,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:51.60,1:32:52.35,Default,,0,0,0,,娘
Dialogue: 0,1:32:52.69,1:32:53.36,Default,,0,0,0,,吒儿
Dialogue: 0,1:32:54.52,1:32:55.73,Default,,0,0,0,,吒儿
Dialogue: 0,1:33:00.27,1:33:02.19,Default,,0,0,0,,儿啊 你没事吧
Dialogue: 0,1:33:02.19,1:33:03.73,Default,,0,0,0,,你的肉身
Dialogue: 0,1:33:03.73,1:33:07.11,Default,,0,0,0,,我 我 我
Dialogue: 0,1:33:07.10,1:33:08.31,Default,,0,0,0,,他们其实已经知晓
Dialogue: 0,1:33:08.31,1:33:09.85,Default,,0,0,0,,你和敖丙的身份
Dialogue: 0,1:33:11.19,1:33:13.44,Default,,0,0,0,,我 我
Dialogue: 0,1:33:13.44,1:33:15.77,Default,,0,0,0,,我以为
Dialogue: 0,1:33:15.77,1:33:20.81,Default,,0,0,0,,再也见不到你们了
Dialogue: 0,1:33:28.56,1:33:30.14,Default,,0,0,0,,师父还在施法
Dialogue: 0,1:33:30.15,1:33:33.23,Default,,0,0,0,,能拖一会儿是一会儿
Dialogue: 0,1:33:33.23,1:33:33.90,Default,,0,0,0,,哪吒
Dialogue: 0,1:33:33.90,1:33:35.86,Default,,0,0,0,,灭陈塘关的不是我父王
Dialogue: 0,1:33:37.31,1:33:38.69,Default,,0,0,0,,真凶
Dialogue: 0,1:33:38.69,1:33:40.77,Default,,0,0,0,,就是这无量仙翁
Dialogue: 0,1:33:59.81,1:34:00.48,Default,,0,0,0,,结界兽
Dialogue: 0,1:34:48.85,1:34:50.35,Default,,0,0,0,,龙族
Dialogue: 0,1:34:50.35,1:34:51.68,Default,,0,0,0,,大师兄
Dialogue: 0,1:34:52.10,1:34:54.93,Default,,0,0,0,,别来无恙乎
Dialogue: 0,1:34:54.94,1:34:56.65,Default,,0,0,0,,你怎么在这儿
Dialogue: 0,1:34:57.77,1:34:58.56,Default,,0,0,0,,申公豹
Dialogue: 0,1:34:58.56,1:35:00.06,Default,,0,0,0,,你勾结龙族
Dialogue: 0,1:35:00.06,1:35:01.31,Default,,0,0,0,,意欲何为
Dialogue: 0,1:35:01.31,1:35:03.81,Default,,0,0,0,,我倒要问...问问你
Dialogue: 0,1:35:03.81,1:35:05.19,Default,,0,0,0,,你抓我爹
Dialogue: 0,1:35:05.19,1:35:06.86,Default,,0,0,0,,意欲何为
Dialogue: 0,1:35:07.48,1:35:09.90,Default,,0,0,0,,谁说我抓了你爹
Dialogue: 0,1:35:09.90,1:35:11.98,Default,,0,0,0,,我家情况只有你清楚
Dialogue: 0,1:35:11.98,1:35:13.98,Default,,0,0,0,,若非你授意
Dialogue: 0,1:35:13.98,1:35:17.69,Default,,0,0,0,,哪吒和捕妖队怎会找上我爹
Dialogue: 0,1:35:17.69,1:35:20.11,Default,,0,0,0,,而且我弟的箭伤
Dialogue: 0,1:35:20.10,1:35:22.06,Default,,0,0,0,,一看可知
Dialogue: 0,1:35:22.06,1:35:25.23,Default,,0,0,0,,是你徒儿鹿童所为
Dialogue: 0,1:35:29.65,1:35:33.48,Default,,0,0,0,,不愧是老夫引荐入门的人才
Dialogue: 0,1:35:33.48,1:35:36.77,Default,,0,0,0,,什么都逃不过你的眼睛
Dialogue: 0,1:35:38.02,1:35:41.35,Default,,0,0,0,,毕竟替你干过那么多年脏活儿
Dialogue: 0,1:35:41.35,1:35:43.10,Default,,0,0,0,,我还能猜到你来陈塘关
Dialogue: 0,1:35:43.10,1:35:45.48,Default,,0,0,0,,装神弄鬼的目的
Dialogue: 0,1:35:45.48,1:35:49.11,Default,,0,0,0,,是想嫁...嫁祸龙族吧
Dialogue: 0,1:35:49.10,1:35:53.14,Default,,0,0,0,,你就是这样报答大师兄的栽培
Dialogue: 0,1:35:53.15,1:35:56.53,Default,,0,0,0,,你一直把...把我当工具
Dialogue: 0,1:35:56.52,1:35:57.85,Default,,0,0,0,,你我之间
Dialogue: 0,1:35:57.85,1:35:59.52,Default,,0,0,0,,有怨无恩
Dialogue: 0,1:36:01.27,1:36:04.06,Default,,0,0,0,,有兴趣做个交易吗
Dialogue: 0,1:36:04.06,1:36:05.31,Default,,0,0,0,,仙长
Dialogue: 0,1:36:06.15,1:36:09.03,Default,,0,0,0,,贵为玉虚宫的主事
Dialogue: 0,1:36:09.02,1:36:13.44,Default,,0,0,0,,想必知道解开这定海锁链的法咒
Dialogue: 0,1:36:13.44,1:36:15.07,Default,,0,0,0,,知道
Dialogue: 0,1:36:15.06,1:36:16.52,Default,,0,0,0,,又怎样
Dialogue: 0,1:36:16.52,1:36:18.31,Default,,0,0,0,,你...你们要叛变
Dialogue: 0,1:36:18.31,1:36:21.10,Default,,0,0,0,,千年前四弟兄一起对抗仙界
Dialogue: 0,1:36:21.10,1:36:22.60,Default,,0,0,0,,到底是谁先背信弃义
Dialogue: 0,1:36:22.60,1:36:23.93,Default,,0,0,0,,将我们打入炼狱
Dialogue: 0,1:36:23.94,1:36:26.61,Default,,0,0,0,,无量仙翁要对付敖光
Dialogue: 0,1:36:26.60,1:36:28.18,Default,,0,0,0,,我们求之不得
Dialogue: 0,1:36:28.73,1:36:32.56,Default,,0,0,0,,久闻无量仙翁用人不拘一格
Dialogue: 0,1:36:32.56,1:36:36.02,Default,,0,0,0,,我等三个的实力想必您也了解
Dialogue: 0,1:36:36.02,1:36:38.65,Default,,0,0,0,,若能解救我等脱离炼狱
Dialogue: 0,1:36:38.65,1:36:40.57,Default,,0,0,0,,得道成仙
Dialogue: 0,1:36:40.56,1:36:43.19,Default,,0,0,0,,我等甘愿为仆为奴
Dialogue: 0,1:36:43.19,1:36:46.86,Default,,0,0,0,,外加奉上灵珠和魔丸的秘密
Dialogue: 0,1:36:46.85,1:36:48.35,Default,,0,0,0,,灵珠和魔丸
Dialogue: 0,1:36:48.35,1:36:49.27,Default,,0,0,0,,卑贱
Dialogue: 0,1:36:49.27,1:36:52.65,Default,,0,0,0,,你们反...反抗仙界的傲骨呢
Dialogue: 0,1:36:52.65,1:36:54.82,Default,,0,0,0,,以前年少无知
Dialogue: 0,1:36:56.90,1:36:59.28,Default,,0,0,0,,经过千年牢狱
Dialogue: 0,1:36:59.94,1:37:02.44,Default,,0,0,0,,才明白这世间的规则
Dialogue: 0,1:37:02.85,1:37:04.93,Default,,0,0,0,,是由谁定
Dialogue: 0,1:37:06.15,1:37:07.48,Default,,0,0,0,,聪明
Dialogue: 0,1:37:07.48,1:37:09.52,Default,,0,0,0,,但你们反复无常
Dialogue: 0,1:37:09.52,1:37:11.31,Default,,0,0,0,,我怎信得过
Dialogue: 0,1:37:11.31,1:37:14.19,Default,,0,0,0,,除非让老夫在你们身上
Dialogue: 0,1:37:14.19,1:37:15.57,Default,,0,0,0,,我等愿意
Dialogue: 0,1:37:25.73,1:37:27.40,Default,,0,0,0,,三个龙王自愿接受
Dialogue: 0,1:37:27.40,1:37:29.86,Default,,0,0,0,,无量仙翁在他们身上下咒
Dialogue: 0,1:37:29.85,1:37:31.56,Default,,0,0,0,,今后若敢抗命
Dialogue: 0,1:37:31.56,1:37:34.64,Default,,0,0,0,,无量仙翁随时可取他们性命
Dialogue: 0,1:37:35.52,1:37:37.90,Default,,0,0,0,,而无量仙翁则履行承诺
Dialogue: 0,1:37:37.90,1:37:40.57,Default,,0,0,0,,解开了他们身上的定海锁链
Dialogue: 0,1:37:41.73,1:37:43.73,Default,,0,0,0,,一旦发现强大势力
Dialogue: 0,1:37:43.73,1:37:44.98,Default,,0,0,0,,便制造惨案
Dialogue: 0,1:37:44.98,1:37:45.94,Default,,0,0,0,,栽赃陷害
Dialogue: 0,1:37:45.94,1:37:47.40,Default,,0,0,0,,再派兵抓捕
Dialogue: 0,1:37:48.27,1:37:49.73,Default,,0,0,0,,据申公豹所述
Dialogue: 0,1:37:49.73,1:37:52.94,Default,,0,0,0,,他曾替无量仙翁干过不少这等勾当
Dialogue: 0,1:37:52.94,1:37:55.48,Default,,0,0,0,,才换得加入阐教的机会
Dialogue: 0,1:37:56.35,1:37:59.27,Default,,0,0,0,,此次无量仙翁本是为屠灭陈塘关
Dialogue: 0,1:37:59.27,1:38:01.69,Default,,0,0,0,,栽赃东海龙族而来
Dialogue: 0,1:38:01.69,1:38:03.32,Default,,0,0,0,,哪知却阴差阳错
Dialogue: 0,1:38:03.31,1:38:05.19,Default,,0,0,0,,收编了三大龙王
Dialogue: 0,1:38:05.19,1:38:06.48,Default,,0,0,0,,并从他们口中
Dialogue: 0,1:38:06.48,1:38:09.06,Default,,0,0,0,,获悉了魔丸和灵珠的秘密
Dialogue: 0,1:38:10.69,1:38:11.69,Default,,0,0,0,,事后
Dialogue: 0,1:38:11.69,1:38:15.32,Default,,0,0,0,,他们故意留下两个不明真相的活口
Dialogue: 0,1:38:15.31,1:38:18.31,Default,,0,0,0,,放回玉虚宫通风报信
Dialogue: 0,1:38:40.15,1:38:42.11,Default,,0,0,0,,眼看突围无望
Dialogue: 0,1:38:42.10,1:38:43.89,Default,,0,0,0,,申公豹想出一计
Dialogue: 0,1:38:43.90,1:38:46.40,Default,,0,0,0,,让夜叉先将我俩石化
Dialogue: 0,1:38:46.40,1:38:48.90,Default,,0,0,0,,再潜入下水道躲藏起来
Dialogue: 0,1:38:48.90,1:38:52.36,Default,,0,0,0,,之后静待时机将我二人救活
Dialogue: 0,1:38:52.35,1:38:53.81,Default,,0,0,0,,那你呢
Dialogue: 0,1:38:53.81,1:38:55.64,Default,,0,0,0,,家人已逝
Dialogue: 0,1:38:56.15,1:38:57.78,Default,,0,0,0,,我没什么好留恋的了
Dialogue: 0,1:39:01.60,1:39:02.93,Default,,0,0,0,,在那里
Dialogue: 0,1:39:18.90,1:39:20.78,Default,,0,0,0,,捕妖队捉去的妖
Dialogue: 0,1:39:20.77,1:39:22.77,Default,,0,0,0,,并非如外界传言
Dialogue: 0,1:39:22.77,1:39:26.35,Default,,0,0,0,,在玉虚宫接受正道感化
Dialogue: 0,1:39:26.35,1:39:29.85,Default,,0,0,0,,而是都被无量仙翁投入这天元鼎
Dialogue: 0,1:39:29.85,1:39:31.39,Default,,0,0,0,,炼成了仙丹
Dialogue: 0,1:39:31.40,1:39:33.61,Default,,0,0,0,,提升阐教实力
Dialogue: 0,1:39:33.98,1:39:34.98,Default,,0,0,0,,师兄啊
Dialogue: 0,1:39:34.98,1:39:37.69,Default,,0,0,0,,你怎么能犯下这等罪行
Dialogue: 0,1:39:37.69,1:39:38.40,Default,,0,0,0,,你
Dialogue: 0,1:39:38.40,1:39:39.73,Default,,0,0,0,,你怎么对得起师尊
Dialogue: 0,1:39:39.73,1:39:41.86,Default,,0,0,0,,对我们的教诲嘛
Dialogue: 0,1:39:41.85,1:39:45.02,Default,,0,0,0,,现在你们既已知晓无量仙翁的罪行
Dialogue: 0,1:39:45.02,1:39:46.94,Default,,0,0,0,,就应悬崖勒马
Dialogue: 0,1:39:46.94,1:39:48.48,Default,,0,0,0,,将他押解回宫
Dialogue: 0,1:39:48.48,1:39:50.61,Default,,0,0,0,,等待天尊降罪
Dialogue: 0,1:39:57.40,1:40:00.65,Default,,0,0,0,,捕妖队由无量仙翁亲手栽培
Dialogue: 0,1:40:00.65,1:40:03.57,Default,,0,0,0,,岂能三言两语就被你们策反
Dialogue: 0,1:40:04.73,1:40:05.98,Default,,0,0,0,,那
Dialogue: 0,1:40:05.98,1:40:08.23,Default,,0,0,0,,是我错怪了龙族
Dialogue: 0,1:40:12.15,1:40:13.65,Default,,0,0,0,,放了龙族
Dialogue: 0,1:40:31.52,1:40:32.31,Default,,0,0,0,,我来帮你
Dialogue: 0,1:40:57.40,1:40:58.86,Default,,0,0,0,,你们叛变
Dialogue: 0,1:40:58.85,1:41:00.56,Default,,0,0,0,,跟大哥您学的
Dialogue: 0,1:41:00.56,1:41:03.02,Default,,0,0,0,,当初为了保全整个龙族
Dialogue: 0,1:41:03.02,1:41:04.60,Default,,0,0,0,,我没得选
Dialogue: 0,1:41:04.60,1:41:07.52,Default,,0,0,0,,那现在为了保全自己
Dialogue: 0,1:41:08.06,1:41:09.89,Default,,0,0,0,,我也没得选
Dialogue: 0,1:41:10.73,1:41:12.02,Default,,0,0,0,,大王 等等我们
Dialogue: 0,1:41:12.02,1:41:13.19,Default,,0,0,0,,不要丢下我们啊
Dialogue: 0,1:41:13.19,1:41:14.61,Default,,0,0,0,,大王 带上我们
Dialogue: 0,1:41:14.60,1:41:16.31,Default,,0,0,0,,大王 大王
Dialogue: 0,1:41:21.40,1:41:23.11,Default,,0,0,0,,你们都被卖啦
Dialogue: 0,1:41:32.40,1:41:33.98,Default,,0,0,0,,南海龙王
Dialogue: 0,1:41:37.98,1:41:39.40,Default,,0,0,0,,北海龙王
Dialogue: 0,1:41:43.73,1:41:45.15,Default,,0,0,0,,西海龙王
Dialogue: 0,1:41:56.15,1:41:57.73,Default,,0,0,0,,侄儿
Dialogue: 0,1:41:57.73,1:41:59.44,Default,,0,0,0,,二叔陪你玩儿玩儿
Dialogue: 0,1:42:10.40,1:42:10.86,Default,,0,0,0,,看枪
Dialogue: 0,1:42:18.15,1:42:19.98,Default,,0,0,0,,吃本王一斧
Dialogue: 0,1:42:22.15,1:42:23.23,Default,,0,0,0,,吃小爷一轮儿
Dialogue: 0,1:42:56.52,1:42:57.77,Default,,0,0,0,,吃小爷一百轮儿
Dialogue: 0,1:42:57.77,1:42:58.56,Default,,0,0,0,,两百轮儿
Dialogue: 0,1:42:58.56,1:42:59.48,Default,,0,0,0,,三百轮儿
Dialogue: 0,1:43:06.02,1:43:07.35,Default,,0,0,0,,饱了没
Dialogue: 0,1:43:07.35,1:43:08.52,Default,,0,0,0,,你乱数
Dialogue: 0,1:43:08.52,1:43:09.44,Default,,0,0,0,,哪有那么多
Dialogue: 0,1:43:10.23,1:43:11.11,Default,,0,0,0,,你肉身不稳
Dialogue: 0,1:43:11.10,1:43:11.93,Default,,0,0,0,,别用力过度
Dialogue: 0,1:43:11.94,1:43:13.40,Default,,0,0,0,,我犯的错
Dialogue: 0,1:43:13.40,1:43:16.57,Default,,0,0,0,,哪怕死我也要帮你把龙族救出来
Dialogue: 0,1:43:17.69,1:43:19.86,Default,,0,0,0,,后生可畏啊
Dialogue: 0,1:43:21.15,1:43:23.36,Default,,0,0,0,,姑姑也来凑凑热闹
Dialogue: 0,1:43:54.77,1:43:55.60,Default,,0,0,0,,大欺小
Dialogue: 0,1:43:55.60,1:43:56.89,Default,,0,0,0,,癞蛤蟆
Dialogue: 0,1:44:06.65,1:44:07.82,Default,,0,0,0,,嗨呀
Dialogue: 0,1:44:07.81,1:44:08.98,Default,,0,0,0,,师叔都敢打
Dialogue: 0,1:44:08.98,1:44:10.06,Default,,0,0,0,,小欺大
Dialogue: 0,1:44:10.06,1:44:10.98,Default,,0,0,0,,没文化
Dialogue: 0,1:44:49.98,1:44:50.81,Default,,0,0,0,,不行啊
Dialogue: 0,1:44:50.81,1:44:51.31,Default,,0,0,0,,太乱了
Dialogue: 0,1:44:52.10,1:44:53.18,Default,,0,0,0,,那就再乱些
Dialogue: 0,1:44:53.19,1:44:54.44,Default,,0,0,0,,来些水汽咋样
Dialogue: 0,1:44:55.35,1:44:55.98,Default,,0,0,0,,好
Dialogue: 0,1:44:59.48,1:45:00.36,Default,,0,0,0,,拿下
Dialogue: 0,1:45:07.81,1:45:09.69,Default,,0,0,0,,小心俩小子偷袭
Dialogue: 0,1:45:16.77,1:45:18.60,Default,,0,0,0,,原来在这儿
Dialogue: 0,1:45:20.48,1:45:22.02,Default,,0,0,0,,看着点儿 是我
Dialogue: 0,1:45:22.02,1:45:22.94,Default,,0,0,0,,二哥啊
Dialogue: 0,1:45:22.94,1:45:24.57,Default,,0,0,0,,对不住 对不住
Dialogue: 0,1:45:24.56,1:45:25.48,Default,,0,0,0,,哪吒
Dialogue: 0,1:45:28.10,1:45:29.02,Default,,0,0,0,,啊
Dialogue: 0,1:45:31.44,1:45:32.48,Default,,0,0,0,,惊不惊喜
Dialogue: 0,1:45:32.48,1:45:33.40,Default,,0,0,0,,哈哈哈哈
Dialogue: 0,1:45:33.56,1:45:34.69,Default,,0,0,0,,变身术
Dialogue: 0,1:45:41.40,1:45:42.44,Default,,0,0,0,,你疯了
Dialogue: 0,1:45:42.44,1:45:43.82,Default,,0,0,0,,你骗不了我
Dialogue: 0,1:45:45.90,1:45:46.61,Default,,0,0,0,,嗯
Dialogue: 0,1:45:47.44,1:45:48.15,Default,,0,0,0,,你们到底
Dialogue: 0,1:45:48.52,1:45:48.98,Default,,0,0,0,,暗号
Dialogue: 0,1:45:48.98,1:45:50.31,Default,,0,0,0,,红凤凰黄凤凰
Dialogue: 0,1:45:50.65,1:45:51.61,Default,,0,0,0,,啥 啥
Dialogue: 0,1:45:51.60,1:45:52.73,Default,,0,0,0,,说不出暗号
Dialogue: 0,1:45:52.73,1:45:53.61,Default,,0,0,0,,假的
Dialogue: 0,1:45:55.23,1:45:56.90,Default,,0,0,0,,原来你真是冒牌货
Dialogue: 0,1:46:02.06,1:46:03.56,Default,,0,0,0,,岂有此理
Dialogue: 0,1:46:09.77,1:46:10.94,Default,,0,0,0,,呸 活该
Dialogue: 0,1:46:12.02,1:46:12.94,Default,,0,0,0,,嗯
Dialogue: 0,1:46:12.94,1:46:13.73,Default,,0,0,0,,暗号
Dialogue: 0,1:46:13.73,1:46:19.77,Default,,0,0,0,,啊那个那个 粉凤 房 房 凤 房 行
Dialogue: 0,1:46:19.77,1:46:20.06,Default,,0,0,0,,错
Dialogue: 0,1:46:21.40,1:46:22.98,Default,,0,0,0,,是红凤凰黄凤凰
Dialogue: 0,1:46:22.98,1:46:24.86,Default,,0,0,0,,粉红房上飞凤凰
Dialogue: 0,1:46:24.85,1:46:26.56,Default,,0,0,0,,我是真的呀
Dialogue: 0,1:46:26.56,1:46:28.98,Default,,0,0,0,,为什么这暗号我不会啊
Dialogue: 0,1:46:28.98,1:46:30.48,Default,,0,0,0,,我们刚编的呀
Dialogue: 0,1:46:32.35,1:46:34.02,Default,,0,0,0,,就不能编简单些吗
Dialogue: 0,1:46:34.02,1:46:36.15,Default,,0,0,0,,太难了
Dialogue: 0,1:46:37.94,1:46:39.57,Default,,0,0,0,,你白痴啊
Dialogue: 0,1:46:39.56,1:46:40.23,Default,,0,0,0,,别过来
Dialogue: 0,1:46:40.23,1:46:41.06,Default,,0,0,0,,冒牌货
Dialogue: 0,1:46:41.06,1:46:42.44,Default,,0,0,0,,我是真敖顺
Dialogue: 0,1:46:42.44,1:46:43.94,Default,,0,0,0,,我呸 你不会暗号
Dialogue: 0,1:46:43.94,1:46:45.27,Default,,0,0,0,,你还不会呢
Dialogue: 0,1:46:46.23,1:46:46.61,Default,,0,0,0,,对啊
Dialogue: 0,1:46:47.35,1:46:48.73,Default,,0,0,0,,难道我也是假的
Dialogue: 0,1:46:50.06,1:46:51.73,Default,,0,0,0,,我的天呐
Dialogue: 0,1:46:51.94,1:46:53.07,Default,,0,0,0,,太极天然
Dialogue: 0,1:46:53.06,1:46:54.02,Default,,0,0,0,,五行顺行
Dialogue: 0,1:46:54.02,1:46:55.73,Default,,0,0,0,,三昧真火
Dialogue: 0,1:46:55.73,1:46:57.19,Default,,0,0,0,,炼就金丹
Dialogue: 0,1:46:57.19,1:46:59.82,Default,,0,0,0,,急急如律令
Dialogue: 0,1:47:27.31,1:47:28.77,Default,,0,0,0,,怕个毛啊
Dialogue: 0,1:47:28.77,1:47:32.77,Default,,0,0,0,,岩浆泡澡咱是家常便饭
Dialogue: 0,1:47:32.77,1:47:34.52,Default,,0,0,0,,烫 烫 烫 烫 烫
Dialogue: 0,1:47:37.06,1:47:37.73,Default,,0,0,0,,妈呀
Dialogue: 0,1:47:37.73,1:47:39.86,Default,,0,0,0,,是三昧真火
Dialogue: 0,1:47:41.81,1:47:43.19,Default,,0,0,0,,看什么看
Dialogue: 0,1:47:43.19,1:47:45.94,Default,,0,0,0,,要吃也只有我自己吃
Dialogue: 0,1:47:48.98,1:47:50.65,Default,,0,0,0,,香
Dialogue: 0,1:47:54.94,1:47:56.27,Default,,0,0,0,,放了我父王
Dialogue: 0,1:47:57.10,1:47:57.68,Default,,0,0,0,,呀
Dialogue: 0,1:47:57.69,1:47:58.44,Default,,0,0,0,,定
Dialogue: 0,1:48:09.77,1:48:11.65,Default,,0,0,0,,好个灵珠
Dialogue: 0,1:48:11.65,1:48:14.98,Default,,0,0,0,,也和魔丸般惊才绝艳
Dialogue: 0,1:48:16.19,1:48:17.11,Default,,0,0,0,,敖丙
Dialogue: 0,1:48:19.44,1:48:20.36,Default,,0,0,0,,呀
Dialogue: 0,1:48:20.60,1:48:21.14,Default,,0,0,0,,定
Dialogue: 0,1:48:33.02,1:48:33.48,Default,,0,0,0,,啊
Dialogue: 0,1:48:33.48,1:48:34.94,Default,,0,0,0,,穿心咒
Dialogue: 0,1:48:35.27,1:48:39.10,Default,,0,0,0,,既然早已知晓你们真实身份
Dialogue: 0,1:48:39.10,1:48:42.64,Default,,0,0,0,,老夫岂能不留后手
Dialogue: 0,1:48:44.65,1:48:45.48,Default,,0,0,0,,不可能 不可能
Dialogue: 0,1:48:45.48,1:48:46.77,Default,,0,0,0,,这个咒语很复杂的
Dialogue: 0,1:48:46.77,1:48:48.94,Default,,0,0,0,,你啥时候下的咒呢
Dialogue: 0,1:48:49.73,1:48:50.77,Default,,0,0,0,,哦
Dialogue: 0,1:48:50.77,1:48:53.35,Default,,0,0,0,,我说你念个升仙咒怎么那么长
Dialogue: 0,1:48:53.35,1:48:55.39,Default,,0,0,0,,你夹带私货啊
Dialogue: 0,1:49:26.27,1:49:27.90,Default,,0,0,0,,老匹夫
Dialogue: 0,1:49:32.02,1:49:33.98,Default,,0,0,0,,即便魔丸
Dialogue: 0,1:49:33.98,1:49:38.81,Default,,0,0,0,,三个时辰内也休想冲破这穿心咒
Dialogue: 0,1:49:38.81,1:49:43.52,Default,,0,0,0,,千针万刺已穿透全身经脉
Dialogue: 0,1:49:43.52,1:49:45.19,Default,,0,0,0,,若强行活动
Dialogue: 0,1:49:45.19,1:49:47.07,Default,,0,0,0,,只会千刀万剐
Dialogue: 0,1:49:47.06,1:49:49.14,Default,,0,0,0,,四分五裂
Dialogue: 0,1:49:50.19,1:49:54.32,Default,,0,0,0,,难怪彼时老夫察觉不到活人气息
Dialogue: 0,1:49:54.77,1:49:57.48,Default,,0,0,0,,原来石化了
Dialogue: 0,1:49:57.48,1:49:58.86,Default,,0,0,0,,但你们没死
Dialogue: 0,1:49:58.85,1:50:00.77,Default,,0,0,0,,可就害了哪吒
Dialogue: 0,1:50:02.81,1:50:04.27,Default,,0,0,0,,灵珠
Dialogue: 0,1:50:05.65,1:50:07.36,Default,,0,0,0,,魔丸
Dialogue: 0,1:50:07.94,1:50:10.36,Default,,0,0,0,,都是宝啊
Dialogue: 0,1:50:10.35,1:50:14.27,Default,,0,0,0,,老夫本想好好栽培栽培
Dialogue: 0,1:50:17.19,1:50:19.73,Default,,0,0,0,,现在只能拿来炼丹了
Dialogue: 0,1:50:35.23,1:50:35.90,Default,,0,0,0,,敖丙
Dialogue: 0,1:50:36.60,1:50:37.27,Default,,0,0,0,,父王
Dialogue: 0,1:50:37.27,1:50:38.02,Default,,0,0,0,,你
Dialogue: 0,1:50:38.02,1:50:39.35,Default,,0,0,0,,你还活着
Dialogue: 0,1:50:39.35,1:50:40.35,Default,,0,0,0,,唔
Dialogue: 0,1:50:40.77,1:50:42.52,Default,,0,0,0,,无量仙翁下的穿心咒
Dialogue: 0,1:50:42.52,1:50:44.81,Default,,0,0,0,,屠戮陈塘关栽赃龙族的也是他
Dialogue: 0,1:50:48.35,1:50:49.10,Default,,0,0,0,,父王
Dialogue: 0,1:50:49.10,1:50:50.43,Default,,0,0,0,,哪吒也是受了蒙骗
Dialogue: 0,1:50:50.44,1:50:51.40,Default,,0,0,0,,不怪他
Dialogue: 0,1:50:51.40,1:50:52.78,Default,,0,0,0,,你想怎样都冲我来
Dialogue: 0,1:50:52.77,1:50:54.10,Default,,0,0,0,,和我爹娘无关
Dialogue: 0,1:50:59.90,1:51:02.19,Default,,0,0,0,,杀了你们也于事无补
Dialogue: 0,1:51:16.85,1:51:19.39,Default,,0,0,0,,大家都已难逃一死
Dialogue: 0,1:51:19.40,1:51:22.07,Default,,0,0,0,,若还有放不下的恩怨
Dialogue: 0,1:51:23.19,1:51:24.07,Default,,0,0,0,,自便吧
Dialogue: 0,1:51:33.02,1:51:34.27,Default,,0,0,0,,大师兄啊
Dialogue: 0,1:51:34.27,1:51:36.44,Default,,0,0,0,,阐教乃名门正派
Dialogue: 0,1:51:36.44,1:51:40.48,Default,,0,0,0,,你怎能做出这等伤天害理之事啊
Dialogue: 0,1:51:40.48,1:51:41.69,Default,,0,0,0,,你莫要一错再错啊
Dialogue: 0,1:51:41.69,1:51:43.48,Default,,0,0,0,,回去跟师父认个错不好吗
Dialogue: 0,1:51:43.85,1:51:45.60,Default,,0,0,0,,我替你求情噻
Dialogue: 0,1:51:45.60,1:51:46.85,Default,,0,0,0,,你
Dialogue: 0,1:51:46.85,1:51:49.48,Default,,0,0,0,,敌我不分的蠢货
Dialogue: 0,1:51:49.48,1:51:52.65,Default,,0,0,0,,要是仙家地位稳如磐石
Dialogue: 0,1:51:52.65,1:51:55.40,Default,,0,0,0,,要是你们这帮养尊处优的小辈
Dialogue: 0,1:51:55.40,1:51:57.78,Default,,0,0,0,,有妖族一半努力
Dialogue: 0,1:51:57.77,1:52:00.60,Default,,0,0,0,,还用得着我费这劲
Dialogue: 0,1:52:00.60,1:52:02.77,Default,,0,0,0,,哪怕我粉身碎骨
Dialogue: 0,1:52:02.77,1:52:04.44,Default,,0,0,0,,背负骂名
Dialogue: 0,1:52:04.44,1:52:08.11,Default,,0,0,0,,一切都是为了阐教霸业永恒
Dialogue: 0,1:52:08.10,1:52:09.18,Default,,0,0,0,,我问心
Dialogue: 0,1:52:09.77,1:52:10.52,Default,,0,0,0,,问心
Dialogue: 0,1:52:10.85,1:52:11.81,Default,,0,0,0,,问心
Dialogue: 0,1:52:15.44,1:52:17.77,Default,,0,0,0,,我问心无愧
Dialogue: 0,1:52:20.94,1:52:22.44,Default,,0,0,0,,又烤好了一条
Dialogue: 0,1:52:22.44,1:52:24.07,Default,,0,0,0,,我是吃不下了
Dialogue: 0,1:52:24.06,1:52:25.10,Default,,0,0,0,,你要不来点儿
Dialogue: 0,1:52:25.10,1:52:26.18,Default,,0,0,0,,谢谢啊
Dialogue: 0,1:52:26.19,1:52:28.65,Default,,0,0,0,,等我的鱼翅烤熟了你也尝尝
Dialogue: 0,1:52:28.65,1:52:30.23,Default,,0,0,0,,蟹钳也好了
Dialogue: 0,1:52:30.23,1:52:31.77,Default,,0,0,0,,大家换着吃吧
Dialogue: 0,1:52:32.31,1:52:33.40,Default,,0,0,0,,怎么回事
Dialogue: 0,1:52:34.44,1:52:36.82,Default,,0,0,0,,身体 我的
Dialogue: 0,1:52:38.85,1:52:40.06,Default,,0,0,0,,炼成丹了
Dialogue: 0,1:52:40.06,1:52:41.60,Default,,0,0,0,,我还年轻
Dialogue: 0,1:52:41.60,1:52:43.02,Default,,0,0,0,,不想死啊
Dialogue: 0,1:52:43.02,1:52:44.69,Default,,0,0,0,,妈呀 放我出去
Dialogue: 0,1:52:44.69,1:52:46.40,Default,,0,0,0,,救命啊 救命啊
Dialogue: 0,1:52:46.44,1:52:47.98,Default,,0,0,0,,冷静
Dialogue: 0,1:52:47.98,1:52:49.98,Default,,0,0,0,,调动全部功力护体
Dialogue: 0,1:52:49.98,1:52:52.61,Default,,0,0,0,,能挨一刻是一刻
Dialogue: 0,1:52:59.77,1:53:00.98,Default,,0,0,0,,儿啊
Dialogue: 0,1:53:00.98,1:53:02.44,Default,,0,0,0,,你功力强过我
Dialogue: 0,1:53:02.44,1:53:04.02,Default,,0,0,0,,定能撑得更久
Dialogue: 0,1:53:04.02,1:53:06.31,Default,,0,0,0,,若能撑到穿心咒失效
Dialogue: 0,1:53:06.31,1:53:08.10,Default,,0,0,0,,就有逃生机会
Dialogue: 0,1:53:08.10,1:53:10.52,Default,,0,0,0,,这穿心咒至少三个时辰才冲得破
Dialogue: 0,1:53:11.02,1:53:11.65,Default,,0,0,0,,孩儿怕
Dialogue: 0,1:53:12.31,1:53:13.94,Default,,0,0,0,,撑不了那么久
Dialogue: 0,1:53:19.90,1:53:20.40,Default,,0,0,0,,夫人
Dialogue: 0,1:53:20.40,1:53:20.94,Default,,0,0,0,,娘
Dialogue: 0,1:53:20.94,1:53:22.02,Default,,0,0,0,,醒醒啊 娘
Dialogue: 0,1:53:22.02,1:53:25.02,Default,,0,0,0,,吒儿 吒儿呢
Dialogue: 0,1:53:26.06,1:53:26.89,Default,,0,0,0,,吒儿
Dialogue: 0,1:53:26.90,1:53:28.53,Default,,0,0,0,,娘 我在这儿
Dialogue: 0,1:53:28.52,1:53:30.15,Default,,0,0,0,,你和爹都坚持住啊
Dialogue: 0,1:53:30.15,1:53:31.53,Default,,0,0,0,,不用管我们
Dialogue: 0,1:53:31.52,1:53:32.77,Default,,0,0,0,,你自己
Dialogue: 0,1:53:32.77,1:53:34.40,Default,,0,0,0,,守住心神
Dialogue: 0,1:53:34.40,1:53:35.78,Default,,0,0,0,,我还好 娘
Dialogue: 0,1:53:35.77,1:53:37.44,Default,,0,0,0,,我对这火没感觉
Dialogue: 0,1:53:37.44,1:53:39.52,Default,,0,0,0,,你小子命大呀
Dialogue: 0,1:53:39.52,1:53:42.10,Default,,0,0,0,,若本王没猜错的话
Dialogue: 0,1:53:42.10,1:53:44.68,Default,,0,0,0,,魔丸的魔焰和这三昧真火
Dialogue: 0,1:53:44.69,1:53:46.07,Default,,0,0,0,,同宗同源
Dialogue: 0,1:53:46.56,1:53:49.89,Default,,0,0,0,,那这天元鼎就奈何不了你
Dialogue: 0,1:53:49.90,1:53:50.78,Default,,0,0,0,,不错
Dialogue: 0,1:53:50.77,1:53:52.52,Default,,0,0,0,,是老夫疏忽了
Dialogue: 0,1:53:56.02,1:53:57.35,Default,,0,0,0,,没用
Dialogue: 0,1:53:57.35,1:53:59.77,Default,,0,0,0,,这是我的化身而已
Dialogue: 0,1:54:01.40,1:54:03.19,Default,,0,0,0,,不愧是魔丸
Dialogue: 0,1:54:03.19,1:54:04.77,Default,,0,0,0,,坚不可摧
Dialogue: 0,1:54:04.77,1:54:09.98,Default,,0,0,0,,难怪天尊要大费周章引天劫灭你
Dialogue: 0,1:54:14.10,1:54:16.31,Default,,0,0,0,,哪吒呀
Dialogue: 0,1:54:16.31,1:54:19.56,Default,,0,0,0,,老夫看你是个孝子
Dialogue: 0,1:54:19.56,1:54:22.02,Default,,0,0,0,,不如给你个尽孝的机会
Dialogue: 0,1:54:22.02,1:54:23.65,Default,,0,0,0,,灭魂丹
Dialogue: 0,1:54:24.10,1:54:25.81,Default,,0,0,0,,你若吞了它
Dialogue: 0,1:54:25.81,1:54:28.23,Default,,0,0,0,,老夫便放了你父母
Dialogue: 0,1:54:28.23,1:54:29.40,Default,,0,0,0,,如何
Dialogue: 0,1:54:29.60,1:54:32.10,Default,,0,0,0,,老夫虽行事冷酷
Dialogue: 0,1:54:32.10,1:54:34.81,Default,,0,0,0,,但向来信守承诺
Dialogue: 0,1:54:34.81,1:54:38.56,Default,,0,0,0,,不然也不会有那么多妖族能人异士
Dialogue: 0,1:54:38.56,1:54:40.39,Default,,0,0,0,,效忠老夫
Dialogue: 0,1:54:40.40,1:54:42.78,Default,,0,0,0,,只要你吞了它
Dialogue: 0,1:54:42.77,1:54:45.15,Default,,0,0,0,,老夫对天发誓
Dialogue: 0,1:54:45.15,1:54:47.07,Default,,0,0,0,,绝不为难你父母
Dialogue: 0,1:55:01.98,1:55:03.44,Default,,0,0,0,,你要干什么
Dialogue: 0,1:55:03.44,1:55:06.57,Default,,0,0,0,,用父母性命来要挟孩子自杀
Dialogue: 0,1:55:06.56,1:55:08.44,Default,,0,0,0,,你算神仙吗
Dialogue: 0,1:55:08.44,1:55:10.15,Default,,0,0,0,,你连做人都不配
Dialogue: 0,1:55:12.40,1:55:13.48,Default,,0,0,0,,吒儿
Dialogue: 0,1:55:13.48,1:55:14.61,Default,,0,0,0,,不要管我们
Dialogue: 0,1:55:14.60,1:55:16.85,Default,,0,0,0,,你一定要活下去
Dialogue: 0,1:55:16.85,1:55:18.77,Default,,0,0,0,,撑到穿心咒解开
Dialogue: 0,1:55:18.77,1:55:20.98,Default,,0,0,0,,撑到两个哥哥找到你
Dialogue: 0,1:55:20.98,1:55:24.40,Default,,0,0,0,,真以为老夫奈何不了魔丸
Dialogue: 0,1:55:24.40,1:55:26.73,Default,,0,0,0,,只是多费些功夫罢了
Dialogue: 0,1:55:26.73,1:55:28.15,Default,,0,0,0,,等你们死了
Dialogue: 0,1:55:28.15,1:55:31.86,Default,,0,0,0,,我有一百种方法整死他
Dialogue: 0,1:55:36.31,1:55:40.77,Default,,0,0,0,,我只想最后死得有点价值
Dialogue: 0,1:55:40.77,1:55:44.35,Default,,0,0,0,,你们为什么不让我死
Dialogue: 0,1:55:44.35,1:55:47.56,Default,,0,0,0,,为什么不让我死
Dialogue: 0,1:55:47.56,1:55:50.64,Default,,0,0,0,,如果用你的命换爹娘的命
Dialogue: 0,1:55:50.65,1:55:54.73,Default,,0,0,0,,你以为爹娘会心安理得地活下去吗
Dialogue: 0,1:55:56.27,1:55:57.73,Default,,0,0,0,,吒儿
Dialogue: 0,1:55:57.73,1:56:00.61,Default,,0,0,0,,不要啊娘
Dialogue: 0,1:56:00.60,1:56:02.02,Default,,0,0,0,,会扎着你
Dialogue: 0,1:56:02.02,1:56:03.23,Default,,0,0,0,,不要紧
Dialogue: 0,1:56:03.23,1:56:06.15,Default,,0,0,0,,最后了
Dialogue: 0,1:56:06.15,1:56:09.44,Default,,0,0,0,,娘只想再抱抱你
Dialogue: 0,1:56:09.44,1:56:12.07,Default,,0,0,0,,娘
Dialogue: 0,1:56:12.06,1:56:16.23,Default,,0,0,0,,娘不能陪伴你长大了
Dialogue: 0,1:56:16.23,1:56:19.02,Default,,0,0,0,,今后的路
Dialogue: 0,1:56:19.02,1:56:21.73,Default,,0,0,0,,你要自己走
Dialogue: 0,1:57:29.77,1:57:33.02,Default,,0,0,0,,我 我没用
Dialogue: 0,1:57:33.02,1:57:35.69,Default,,0,0,0,,我好没用
Dialogue: 0,1:57:35.69,1:57:38.61,Default,,0,0,0,,我生来就是魔
Dialogue: 0,1:57:38.60,1:57:42.35,Default,,0,0,0,,一直都让你们受苦
Dialogue: 0,1:57:42.35,1:57:43.73,Default,,0,0,0,,我也好想
Dialogue: 0,1:57:43.73,1:57:46.52,Default,,0,0,0,,好想成为你们的骄傲
Dialogue: 0,1:57:52.31,1:57:55.77,Default,,0,0,0,,是我连累了你们
Dialogue: 0,1:57:55.77,1:57:57.27,Default,,0,0,0,,对不起
Dialogue: 0,1:57:57.27,1:57:59.94,Default,,0,0,0,,娘
Dialogue: 0,1:57:59.94,1:58:03.15,Default,,0,0,0,,对不起
Dialogue: 0,1:58:03.15,1:58:06.78,Default,,0,0,0,,和你度过的每一天
Dialogue: 0,1:58:06.77,1:58:10.35,Default,,0,0,0,,娘都很开心
Dialogue: 0,1:58:10.35,1:58:14.06,Default,,0,0,0,,娘从没在乎过
Dialogue: 0,1:58:14.06,1:58:15.77,Default,,0,0,0,,你是仙
Dialogue: 0,1:58:15.77,1:58:18.31,Default,,0,0,0,,是魔
Dialogue: 0,1:58:18.31,1:58:20.81,Default,,0,0,0,,娘只知道
Dialogue: 0,1:58:20.81,1:58:25.64,Default,,0,0,0,,你是娘的儿
Dialogue: 0,1:58:25.65,1:58:27.40,Default,,0,0,0,,娘
Dialogue: 0,1:58:27.40,1:58:29.69,Default,,0,0,0,,永远
Dialogue: 0,1:58:29.69,1:58:31.02,Default,,0,0,0,,爱
Dialogue: 0,1:59:11.15,1:59:12.73,Default,,0,0,0,,吒儿 不要冲动
Dialogue: 0,1:59:12.73,1:59:13.65,Default,,0,0,0,,停下
Dialogue: 0,1:59:13.65,1:59:15.36,Default,,0,0,0,,你骨肉会被撕裂的
Dialogue: 0,1:59:58.27,2:00:01.60,Default,,0,0,0,,三昧真火竟然补全了重塑肉身时
Dialogue: 0,2:00:01.60,2:00:03.81,Default,,0,0,0,,不足的火候
Dialogue: 0,2:00:03.81,2:00:05.89,Default,,0,0,0,,哪吒的肉身
Dialogue: 0,2:00:07.15,2:00:09.78,Default,,0,0,0,,完成了
Dialogue: 0,2:00:24.40,2:00:25.69,Default,,0,0,0,,爹
Dialogue: 0,2:00:26.44,2:00:27.57,Default,,0,0,0,,照顾好娘
Dialogue: 0,2:00:40.31,2:00:42.73,Default,,0,0,0,,助我破鼎
Dialogue: 0,2:01:15.23,2:01:15.94,Default,,0,0,0,,不好
Dialogue: 0,2:01:15.94,2:01:18.23,Default,,0,0,0,,他们在吸收天元鼎的能量
Dialogue: 0,2:01:19.44,2:01:22.07,Default,,0,0,0,,根深蒂固
Dialogue: 0,2:01:46.85,2:01:48.81,Default,,0,0,0,,全体捕妖队听令
Dialogue: 0,2:01:48.81,2:01:50.10,Default,,0,0,0,,上
Dialogue: 0,2:02:45.15,2:02:46.11,Default,,0,0,0,,父王
Dialogue: 0,2:02:46.10,2:02:47.68,Default,,0,0,0,,你们得留着功力护体啊
Dialogue: 0,2:02:47.69,2:02:49.07,Default,,0,0,0,,我们一直在退
Dialogue: 0,2:02:49.06,2:02:50.73,Default,,0,0,0,,一直在退
Dialogue: 0,2:02:50.73,2:02:52.15,Default,,0,0,0,,原以为什么都给了
Dialogue: 0,2:02:52.15,2:02:54.57,Default,,0,0,0,,仙翁会让我们活下去
Dialogue: 0,2:02:54.56,2:02:57.48,Default,,0,0,0,,结果他们还要我们的命
Dialogue: 0,2:02:57.48,2:03:00.06,Default,,0,0,0,,既然他们要我们的命
Dialogue: 0,2:03:00.06,2:03:03.31,Default,,0,0,0,,那我们就用这条命跟他们拼了
Dialogue: 0,2:03:03.31,2:03:05.60,Default,,0,0,0,,对 跟他们拼了
Dialogue: 0,2:03:05.60,2:03:09.02,Default,,0,0,0,,拼了 拼了 拼了
Dialogue: 0,2:03:19.23,2:03:21.61,Default,,0,0,0,,绝不能放他们出来
Dialogue: 0,2:04:08.23,2:04:09.69,Default,,0,0,0,,不要放弃
Dialogue: 0,2:04:09.69,2:04:11.73,Default,,0,0,0,,坚持住
Dialogue: 0,2:04:35.77,2:04:38.15,Default,,0,0,0,,给我
Dialogue: 0,2:04:38.15,2:04:41.48,Default,,0,0,0,,破
Dialogue: 0,2:05:31.44,2:05:32.52,Default,,0,0,0,,鼎
Dialogue: 0,2:05:32.52,2:05:33.94,Default,,0,0,0,,我的鼎
Dialogue: 0,2:05:33.94,2:05:37.27,Default,,0,0,0,,阐教的根基啊
Dialogue: 0,2:06:32.10,2:06:35.64,Default,,0,0,0,,给我杀光这帮畜生
Dialogue: 0,2:06:40.60,2:06:42.56,Default,,0,0,0,,杀
Dialogue: 0,2:07:16.90,2:07:20.32,Default,,0,0,0,,你们这帮为虎作伥的小辈
Dialogue: 0,2:07:20.31,2:07:21.73,Default,,0,0,0,,黑白不分
Dialogue: 0,2:07:34.48,2:07:36.86,Default,,0,0,0,,海啸龙吟
Dialogue: 0,2:07:46.77,2:07:49.77,Default,,0,0,0,,原来仙翁手下竟也是俩禽兽
Dialogue: 0,2:07:49.77,2:07:51.56,Default,,0,0,0,,什么妖什么仙
Dialogue: 0,2:07:51.56,2:07:54.06,Default,,0,0,0,,都是你们糊弄人的把戏
Dialogue: 0,2:07:54.90,2:07:56.73,Default,,0,0,0,,下贱的妖孽
Dialogue: 0,2:07:56.73,2:07:59.31,Default,,0,0,0,,也敢和本仙作对
Dialogue: 0,2:08:22.44,2:08:26.02,Default,,0,0,0,,见识下老夫的手段
Dialogue: 0,2:10:20.15,2:10:21.94,Default,,0,0,0,,老夫惜才
Dialogue: 0,2:10:21.94,2:10:23.90,Default,,0,0,0,,再给你二人一次机会
Dialogue: 0,2:10:23.90,2:10:25.48,Default,,0,0,0,,若肯归降
Dialogue: 0,2:10:25.48,2:10:27.40,Default,,0,0,0,,保你们得道成仙
Dialogue: 0,2:10:27.40,2:10:29.82,Default,,0,0,0,,去你个鸟仙
Dialogue: 0,2:10:29.81,2:10:32.02,Default,,0,0,0,,小爷是魔
Dialogue: 0,2:10:32.02,2:10:33.27,Default,,0,0,0,,那又如何
Dialogue: 0,2:10:36.60,2:10:38.68,Default,,0,0,0,,自诩照世明灯
Dialogue: 0,2:10:38.69,2:10:40.27,Default,,0,0,0,,干的却是恃强凌弱
Dialogue: 0,2:10:40.27,2:10:42.52,Default,,0,0,0,,祸乱人间的勾当
Dialogue: 0,2:10:42.52,2:10:45.23,Default,,0,0,0,,你们才是邪魔外道
Dialogue: 0,2:10:53.31,2:10:54.81,Default,,0,0,0,,无知小儿
Dialogue: 0,2:10:54.81,2:10:56.73,Default,,0,0,0,,仙家雄霸天下
Dialogue: 0,2:10:56.73,2:10:59.77,Default,,0,0,0,,依附强者才是唯一出路
Dialogue: 0,2:10:59.77,2:11:01.90,Default,,0,0,0,,否则天地虽大
Dialogue: 0,2:11:01.90,2:11:04.36,Default,,0,0,0,,也让你们无路可走
Dialogue: 0,2:11:04.35,2:11:06.14,Default,,0,0,0,,若前方无路
Dialogue: 0,2:11:06.15,2:11:08.32,Default,,0,0,0,,我就踏出一条路
Dialogue: 0,2:11:11.56,2:11:14.23,Default,,0,0,0,,若天地不容
Dialogue: 0,2:11:14.23,2:11:18.02,Default,,0,0,0,,我就扭转这乾坤
Dialogue: 0,2:11:28.06,2:11:28.64,Default,,0,0,0,,师父
Dialogue: 0,2:11:30.52,2:11:32.77,Default,,0,0,0,,我的脸 我的脸
Dialogue: 0,2:11:32.77,2:11:33.65,Default,,0,0,0,,你们
Dialogue: 0,2:11:33.65,2:11:37.28,Default,,0,0,0,,你们胆敢破我不老神功
Dialogue: 0,2:11:37.56,2:11:39.69,Default,,0,0,0,,老匹夫
Dialogue: 0,2:11:51.56,2:11:54.60,Default,,0,0,0,,回 回宫
Dialogue: 0,2:12:06.44,2:12:08.19,Default,,0,0,0,,等等我
Dialogue: 0,2:12:50.81,2:12:52.52,Default,,0,0,0,,父王打算带领龙族
Dialogue: 0,2:12:52.52,2:12:54.27,Default,,0,0,0,,前往大海深处隐匿起来
Dialogue: 0,2:12:54.27,2:12:55.81,Default,,0,0,0,,你身份也已暴露
Dialogue: 0,2:12:55.81,2:12:57.35,Default,,0,0,0,,不如随我们一同去吧
Dialogue: 0,2:12:57.90,2:12:58.73,Default,,0,0,0,,不了
Dialogue: 0,2:12:59.65,2:13:01.11,Default,,0,0,0,,以前我一直在躲
Dialogue: 0,2:13:01.73,2:13:02.44,Default,,0,0,0,,在藏
Dialogue: 0,2:13:03.15,2:13:05.44,Default,,0,0,0,,直到无路可走
Dialogue: 0,2:13:05.44,2:13:08.23,Default,,0,0,0,,我才明白该如何面对这个世界
Dialogue: 0,2:13:08.23,2:13:10.23,Default,,0,0,0,,无量仙翁位高权重
Dialogue: 0,2:13:10.23,2:13:12.56,Default,,0,0,0,,又深得天尊信任
Dialogue: 0,2:13:12.56,2:13:14.31,Default,,0,0,0,,未必就会倒台
Dialogue: 0,2:13:14.31,2:13:16.52,Default,,0,0,0,,而且仙魔殊途
Dialogue: 0,2:13:16.52,2:13:18.60,Default,,0,0,0,,水火不容
Dialogue: 0,2:13:18.60,2:13:20.35,Default,,0,0,0,,什么神仙妖魔
Dialogue: 0,2:13:20.35,2:13:23.98,Default,,0,0,0,,不过是他们禁锢异族命运的枷锁
Dialogue: 0,2:13:24.94,2:13:26.48,Default,,0,0,0,,那又怎样
Dialogue: 0,2:13:26.48,2:13:29.61,Default,,0,0,0,,难道你还想改变这世界
Dialogue: 0,2:13:33.44,2:13:35.02,Default,,0,0,0,,我想试试
Dialogue: 0,2:13:37.40,2:13:39.57,Default,,0,0,0,,可能是我老了
Dialogue: 0,2:13:39.56,2:13:43.02,Default,,0,0,0,,没力气再去和这个世界碰撞
Dialogue: 0,2:13:43.02,2:13:43.94,Default,,0,0,0,,敖丙
Dialogue: 0,2:14:19.60,2:14:21.02,Default,,0,0,0,,父王知道
Dialogue: 0,2:14:21.02,2:14:22.85,Default,,0,0,0,,一旦决定的事
Dialogue: 0,2:14:22.85,2:14:24.93,Default,,0,0,0,,你始终会去做
Dialogue: 0,2:14:25.81,2:14:27.06,Default,,0,0,0,,儿啊
Dialogue: 0,2:14:27.06,2:14:28.64,Default,,0,0,0,,以前父王
Dialogue: 0,2:14:28.65,2:14:30.73,Default,,0,0,0,,让你肩负了太多的期望
Dialogue: 0,2:14:30.73,2:14:31.81,Default,,0,0,0,,却不曾
Dialogue: 0,2:14:31.81,2:14:33.98,Default,,0,0,0,,倾听你的想法
Dialogue: 0,2:14:33.98,2:14:35.69,Default,,0,0,0,,父王对不起你
Dialogue: 0,2:14:36.31,2:14:41.02,Default,,0,0,0,,父王只是想用自己的经验为你谋个幸福
Dialogue: 0,2:14:41.02,2:14:42.65,Default,,0,0,0,,但现在看来
Dialogue: 0,2:14:42.65,2:14:43.94,Default,,0,0,0,,父辈的经验
Dialogue: 0,2:14:43.94,2:14:45.48,Default,,0,0,0,,毕竟是过往
Dialogue: 0,2:14:45.48,2:14:47.69,Default,,0,0,0,,未必全对
Dialogue: 0,2:14:49.06,2:14:52.19,Default,,0,0,0,,你的路还需你去闯
Dialogue: 0,2:14:52.73,2:14:54.69,Default,,0,0,0,,今后
Dialogue: 0,2:14:54.69,2:14:57.44,Default,,0,0,0,,忠于自己内心的选择吧
Dialogue: 0,2:15:28.35,2:15:30.18,Default,,0,0,0,,我知道你会回来的
Dialogue: 0,2:15:30.19,2:15:31.52,Default,,0,0,0,,为什么
Dialogue: 0,2:15:32.35,2:15:34.10,Default,,0,0,0,,因为我们都太年轻
Dialogue: 0,2:15:37.56,2:15:40.39,Default,,0,0,0,,不知天高地厚
Dialogue: 0,2:17:32.85,2:17:33.89,Default,,0,0,0,,师父
Dialogue: 0,2:17:33.90,2:17:35.19,Default,,0,0,0,,您的脸
Dialogue: 0,2:17:35.19,2:17:36.82,Default,,0,0,0,,不要紧
Dialogue: 0,2:17:36.81,2:17:39.02,Default,,0,0,0,,鹤童给老夫敷过药了
Dialogue: 0,2:17:39.31,2:17:40.44,Default,,0,0,0,,鼎被毁
Dialogue: 0,2:17:40.44,2:17:42.44,Default,,0,0,0,,阐教已无必胜把握
Dialogue: 0,2:17:42.44,2:17:45.19,Default,,0,0,0,,我们可是犯了弥天大罪啊
Dialogue: 0,2:17:45.19,2:17:49.40,Default,,0,0,0,,务必赶在师尊出关前马上行动
Dialogue: 0,2:17:49.40,2:17:50.03,Default,,0,0,0,,走
Dialogue: 0,2:17:50.02,2:17:51.81,Default,,0,0,0,,去见见他
Dialogue: 0,2:17:52.06,2:17:54.81,Default,,0,0,0,,关押的地方够隐秘吗
Dialogue: 0,2:17:54.81,2:17:56.44,Default,,0,0,0,,不会有其他人到这里来
Dialogue: 0,2:17:56.44,2:17:58.32,Default,,0,0,0,,牢房内还屏蔽了仙术
Dialogue: 0,2:17:58.31,2:17:59.27,Default,,0,0,0,,大门也只有您
Dialogue: 0,2:17:59.27,2:18:01.52,Default,,0,0,0,,和唯一一个守卫才开得了
Dialogue: 0,2:18:01.52,2:18:02.73,Default,,0,0,0,,嗯
Dialogue: 0,2:18:09.48,2:18:10.86,Default,,0,0,0,,开小差
Dialogue: 0,2:18:10.85,2:18:12.31,Default,,0,0,0,,打瞌睡
Dialogue: 0,2:18:17.23,2:18:18.44,Default,,0,0,0,,怎么回事
Dialogue: 0,2:18:18.44,2:18:19.53,Default,,0,0,0,,这门
Dialogue: 0,2:18:19.52,2:18:20.56,Default,,0,0,0,,认容貌
Dialogue: 0,2:18:20.56,2:18:22.56,Default,,0,0,0,,您 容貌有变
Dialogue: 0,2:18:22.56,2:18:24.85,Default,,0,0,0,,需重新录入
Dialogue: 0,2:18:24.85,2:18:26.02,Default,,0,0,0,,录吧
Dialogue: 0,2:18:53.35,2:18:55.60,Default,,0,0,0,,敢嘲笑老夫
Dialogue: 0,2:18:55.60,2:18:57.43,Default,,0,0,0,,咒你睡十年
Dialogue: 0,2:19:04.73,2:19:05.98,Default,,0,0,0,,受罪啦
Dialogue: 0,2:19:05.98,2:19:07.86,Default,,0,0,0,,师弟
Dialogue: 0,2:19:09.40,2:19:11.65,Default,,0,0,0,,师兄才是受罪
Dialogue: 0,2:19:11.65,2:19:14.86,Default,,0,0,0,,谁把...把您打成这样
Dialogue: 0,2:19:14.85,2:19:15.93,Default,,0,0,0,,哼
Dialogue: 0,2:19:15.94,2:19:20.69,Default,,0,0,0,,你可知老夫当年为何要引荐你入教
Dialogue: 0,2:19:20.69,2:19:24.19,Default,,0,0,0,,要的就是你这妖族身份
Dialogue: 0,2:19:24.19,2:19:26.48,Default,,0,0,0,,封神大战时
Dialogue: 0,2:19:26.48,2:19:30.36,Default,,0,0,0,,老夫可会对你委以重任哦
Dialogue: 0,2:19:30.35,2:19:31.27,Default,,0,0,0,,妄想
Dialogue: 0,2:19:33.98,2:19:36.44,Default,,0,0,0,,爹 爹
Dialogue: 0,2:19:36.44,2:19:37.78,Default,,0,0,0,,放心
Dialogue: 0,2:19:37.77,2:19:39.90,Default,,0,0,0,,还有气儿
Dialogue: 0,2:19:39.90,2:19:43.19,Default,,0,0,0,,若你让老夫在你身上下个咒
Dialogue: 0,2:19:43.19,2:19:45.98,Default,,0,0,0,,你爹便可在玉虚宫
Dialogue: 0,2:19:45.98,2:19:48.90,Default,,0,0,0,,尽享清福
Dialogue: 0,2:19:51.35,2:19:53.31,Default,,0,0,0,,您要的那两人到了
Dialogue: 0,2:19:53.31,2:19:55.27,Default,,0,0,0,,好好考虑考虑吧
Dialogue: 0,2:20:02.90,2:20:04.15,Default,,0,0,0,,嗯
Dialogue: 0,2:20:05.02,2:20:07.69,Default,,0,0,0,,先前敷的药起效了
Dialogue: 0,2:20:07.69,2:20:08.73,Default,,0,0,0,,那怎么办
Dialogue: 0,2:20:08.73,2:20:10.69,Default,,0,0,0,,还有谁能开门
Dialogue: 0,2:20:16.69,2:20:18.02,Default,,0,0,0,,十年
Dialogue: 0,2:20:25.48,2:20:27.61,Default,,0,0,0,,五龙山云霄洞金吒
Dialogue: 0,2:20:27.60,2:20:30.02,Default,,0,0,0,,九宫山白鹤洞木吒
Dialogue: 0,2:20:30.02,2:20:31.48,Default,,0,0,0,,应召回宫
Dialogue: 0,2:20:37.19,2:20:38.19,Default,,0,0,0,,师父
Dialogue: 0,2:20:38.19,2:20:39.32,Default,,0,0,0,,忍着点啊
Dialogue: 0,2:20:44.19,2:20:46.40,Default,,0,0,0,,差不多了吧
Dialogue: 0,2:20:52.27,2:20:53.52,Default,,0,0,0,,好像
Dialogue: 0,2:20:53.52,2:20:54.98,Default,,0,0,0,,左眼还不够肿
Dialogue: 0,2:20:55.31,2:20:56.60,Default,,0,0,0,,右腮也补点儿
Dialogue: 0,2:20:59.27,2:21:00.23,Default,,0,0,0,,等等
Dialogue: 0,2:21:00.73,2:21:02.44,Default,,0,0,0,,你们刚才是不是在笑
Dialogue: 0,2:21:02.44,2:21:03.44,Default,,0,0,0,,徒儿岂敢
Dialogue: 0,2:21:03.44,2:21:04.32,Default,,0,0,0,,师父受苦
Dialogue: 0,2:21:04.31,2:21:06.39,Default,,0,0,0,,徒儿心中只会难受百倍
Dialogue: 0,2:21:06.40,2:21:06.86,Default,,0,0,0,,真的
Dialogue: 0,2:21:06.85,2:21:08.02,Default,,0,0,0,,绝无虚言
Dialogue: 0,2:21:08.02,2:21:09.19,Default,,0,0,0,,天地可鉴
Dialogue: 0,2:21:14.06,2:21:16.06,Default,,0,0,0,,行了 行了 行了
Dialogue: 0,2:21:26.98,2:21:28.23,Default,,0,0,0,,好像
Dialogue: 0,2:21:28.23,2:21:29.31,Default,,0,0,0,,打多了
Dialogue: 0,2:21:29.31,2:21:30.19,Default,,0,0,0,,什么
Dialogue: 0,2:21:30.19,2:21:31.02,Default,,0,0,0,,没事儿 没事儿
Dialogue: 0,2:21:31.02,2:21:32.52,Default,,0,0,0,,敷上药一会儿好了再来
Dialogue: 0,2:21:33.56,2:21:35.60,Default,,0,0,0,,师父 您是干大事儿的人
Dialogue: 0,2:21:35.60,2:21:37.39,Default,,0,0,0,,这都是为了阐教兴亡啊
Dialogue: 0,2:21:37.40,2:21:38.11,Default,,0,0,0,,我们多试几次
Dialogue: 0,2:21:38.10,2:21:39.39,Default,,0,0,0,,总会碰对一次的
Dialogue: 0,2:21:39.40,2:21:39.94,Default,,0,0,0,,抓住他
Dialogue: 0,2:21:39.94,2:21:40.65,Default,,0,0,0,,别让他跑了
Dialogue: 0,2:21:40.65,2:21:41.11,Default,,0,0,0,,快
Dialogue: 0,2:21:41.10,2:21:42.06,Default,,0,0,0,,快上药
Dialogue: 0,2:21:42.06,2:21:43.31,Default,,0,0,0,,上药
Dialogue: 0,2:21:43.31,2:21:45.35,Default,,0,0,0,,放开我
